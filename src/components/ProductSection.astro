---
import { products } from "../data/products";

// Top 4 itens mais vendidos emblemáticos para vitrine da home
const bestSellerIds = ["637", "360", "291", "3139"];
const bestSellers = bestSellerIds
  .map((id) => products.find((p) => p.id === id))
  .filter(Boolean);

// Fallback caso algum id não seja encontrado
const displayProducts = bestSellers.length === 4 ? bestSellers : products.slice(0, 4);
---

<section id="produtos" class="editorial" data-product-section>
  <div class="catalog-head section-head" data-mos="fade-up">
    <div>
      <span class="catalog-eyebrow">Destaques Coloniais</span>
      <h2>Mais Vendidos da Nossa Terra</h2>
      <p>Uma seleção das delícias gaúchas mais pedidas pelos nossos clientes. Feitas por famílias e cooperativas da Serra e do Pampa.</p>
    </div>
    <div class="catalog-actions">
      <a href="/catalogo" class="btn-view-all" title="Ver todo o catálogo com mais de 220 produtos">
        Ver Todos os Produtos (228) →
      </a>
    </div>
  </div>

  <!-- Grid de 4 Produtos em Destaque (1 Linha Limpa) -->
  <div class="product-grid" id="main-product-grid">
    {
      displayProducts.map((product, idx) => (
        <article
          class="product"
          data-category-name={product.category}
          data-mos="fade-up"
          data-product={product.id}
          id={`product-${product.id}`}
        >
          {product.badge && <span class="product-badge">{product.badge}</span>}
          <button
            class="wish"
            type="button"
            aria-label={`Salvar ${product.name}`}
            aria-pressed="false"
          >
            <svg
              height="20"
              width="20"
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.7"
            >
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.7-7.5a5.5 5.5 0 0 0 1.1-8.9Z" />
            </svg>
          </button>
          
          <a href={`/produto/${product.id}`} class="product-image-container" title={`Ver detalhes de ${product.name}`}>
            <img
              src={product.image || "/images/shop/cosmic-products.png"}
              alt={product.name}
              class="product-image"
              loading="lazy"
              onerror="this.src='/images/shop/cosmic-products.png'"
            />
          </a>

          <div class="product-info">
            <span class="product-category-tag">{product.category}</span>
            <a href={`/produto/${product.id}`} class="product-title-link">
              <h3>{product.name}</h3>
            </a>
            <b>R$ {product.price.toFixed(2).replace(".", ",")}</b>
            <p>
              <span>★★★★★</span> <small>({product.reviews || 24})</small>
            </p>
            
            <div class="product-card-actions">
              <button
                class="btn-whatsapp"
                type="button"
                data-order-whatsapp
                data-id={product.id}
                data-name={product.name}
                data-price={product.price}
                title="Pedir este produto direto pelo WhatsApp"
              >
                <span>💬 WhatsApp</span>
              </button>
              <button
                class="add-cart"
                type="button"
                data-add-cart
                data-id={product.id}
                data-name={product.name}
                data-price={product.price}
                title="Adicionar à sacola de pedidos"
              >
                + Sacola
              </button>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <!-- Botão Inferior de Acesso ao Catálogo Completo -->
  <div class="catalog-bottom-cta" data-mos="fade-up">
    <a href="/catalogo" class="btn-see-full-catalog">
      <span>Explorar Catálogo Completo com Filtros Laterais</span>
      <span class="arrow">→</span>
    </a>
  </div>

  <!-- Sacola Lateral / Drawer -->
  <aside class="product-cart" aria-hidden="true" data-product-cart>
    <header>
      <h2>Sua sacola <span data-cart-count>0</span></h2>
      <button type="button" aria-label="Fechar sacola" data-close-cart>×</button>
    </header>
    <div data-cart-items></div>
    <footer>
      <p>Subtotal <b data-cart-total>R$ 0,00</b></p>
      <a href="/catalogo" class="view-cart" data-close-cart>Continuar escolhendo no catálogo</a>
      <button type="button" data-checkout class="btn-checkout-wa">
        <span>💬 Finalizar Pedido via WhatsApp</span>
      </button>
    </footer>
  </aside>

  <!-- Gatilho Flutuante da Sacola -->
  <button class="cart-trigger" type="button" aria-label="Abrir sacola" data-open-cart>
    Sacola <span data-floating-count>0</span>
  </button>

  <!-- Toast -->
  <div class="product-toast" aria-live="polite" data-product-toast role="status"></div>

  <!-- Catálogo Original Embutido para Fallback -->
  <script type="application/json" data-product-catalog set:html={JSON.stringify(products)} />
</section>

<style is:global>
  .section-head {
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .section-head > div {
    gap: 7px;
    display: grid;
  }
  .catalog-eyebrow {
    width: max-content;
    color: var(--commerce-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 11px;
    font-weight: 700;
  }
  .catalog-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .btn-view-all {
    font-size: 13px;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 10px;
    background: #8b1b22;
    color: #fff;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    box-shadow: 0 4px 14px rgba(139, 27, 34, 0.35);
  }
  .btn-view-all:hover {
    background: #a52129;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(139, 27, 34, 0.45);
  }

  /* Grid de 4 Produtos em 1 linha */
  .product-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    display: grid;
  }
  .product {
    border: 1px solid var(--commerce-border);
    background: var(--commerce-surface);
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .product:hover {
    border-color: var(--commerce-accent);
    box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.6);
    transform: translateY(-3px);
  }
  .product-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--commerce-accent);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 5px;
    z-index: 2;
    letter-spacing: 0.04em;
  }
  .product-image-container {
    width: 100%;
    height: 220px;
    background: var(--commerce-surface-raised);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    overflow: hidden;
    text-decoration: none;
  }
  .product-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }
  .product:hover .product-image {
    transform: scale(1.06);
  }
  .wish {
    z-index: 2;
    color: var(--commerce-muted);
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(4px);
    border: 0;
    padding: 6px;
    border-radius: 50%;
    position: absolute;
    top: 10px;
    right: 10px;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }
  .wish:hover {
    color: #fff;
    background: rgba(0, 0, 0, 0.6);
  }
  .wish[aria-pressed="true"] {
    color: var(--commerce-accent);
  }
  .wish[aria-pressed="true"] svg {
    fill: currentColor;
  }
  .product-info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }
  .product-category-tag {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--commerce-accent);
    margin-bottom: 4px;
    display: block;
  }
  .product-title-link {
    text-decoration: none;
    color: inherit;
  }
  .product-info h3 {
    font-size: 14px;
    font-weight: 600;
    color: var(--commerce-foreground);
    margin: 0 0 8px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s;
  }
  .product-info h3:hover {
    color: var(--commerce-accent);
  }
  .product-info b {
    font-size: 18px;
    font-weight: 800;
    color: var(--commerce-foreground);
    margin-bottom: 6px;
    display: block;
  }
  .product-info p {
    color: #f59e0b;
    font-size: 12px;
    margin: 0 0 14px;
  }
  .product-info p small {
    color: var(--commerce-muted);
  }
  .product-card-actions {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 8px;
    margin-top: auto;
  }
  .btn-whatsapp {
    background: #166534;
    color: #fff;
    border: 0;
    border-radius: 7px;
    padding: 8px 10px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
    text-align: center;
  }
  .btn-whatsapp:hover {
    background: #15803d;
  }
  .add-cart {
    background: var(--commerce-surface-raised);
    color: var(--commerce-foreground);
    border: 1px solid var(--commerce-border);
    border-radius: 7px;
    padding: 8px 10px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }
  .add-cart:hover {
    border-color: var(--commerce-accent);
    color: var(--commerce-accent);
  }

  /* Bottom CTA */
  .catalog-bottom-cta {
    margin-top: 28px;
    text-align: center;
  }
  .btn-see-full-catalog {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 28px;
    border-radius: 12px;
    background: #141212;
    border: 1px solid #362e2c;
    color: #f2ede6;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-see-full-catalog:hover {
    border-color: #8b1b22;
    background: #1c1817;
    color: #ff9da3;
    transform: translateY(-2px);
  }
  .btn-see-full-catalog .arrow {
    transition: transform 0.2s ease;
  }
  .btn-see-full-catalog:hover .arrow {
    transform: translateX(4px);
  }

  /* Cart Drawer */
  .product-cart {
    position: fixed;
    top: 0;
    right: 0;
    width: min(90vw, 380px);
    height: 100vh;
    background: var(--commerce-surface);
    border-left: 1px solid var(--commerce-border);
    z-index: 40;
    transform: translateX(100%);
    transition: transform 0.3s ease-in-out;
    display: flex;
    flex-direction: column;
    padding: 24px;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.6);
  }
  .product-cart.open {
    transform: translateX(0);
  }
  .product-cart header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--commerce-border);
  }
  .product-cart header h2 {
    font-size: 18px;
    margin: 0;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .product-cart header span {
    background: var(--commerce-accent);
    color: #fff;
    font-size: 11px;
    padding: 2px 7px;
    border-radius: 10px;
  }
  .product-cart header button {
    background: transparent;
    border: 0;
    font-size: 24px;
    color: var(--commerce-muted);
    cursor: pointer;
  }
  [data-cart-items] {
    flex-grow: 1;
    overflow-y: auto;
    padding: 16px 0;
  }
  .cart-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--commerce-surface-raised);
    font-size: 13px;
  }
  .cart-row b {
    display: block;
    color: var(--commerce-foreground);
    margin-bottom: 2px;
  }
  .cart-row small {
    color: var(--commerce-muted);
  }
  .cart-row button {
    background: transparent;
    border: 0;
    color: #ef4444;
    cursor: pointer;
    font-size: 11px;
    font-weight: 600;
  }
  .empty-cart {
    color: var(--commerce-muted);
    text-align: center;
    padding: 40px 0;
    font-size: 13px;
  }
  .product-cart footer {
    padding-top: 16px;
    border-top: 1px solid var(--commerce-border);
  }
  .product-cart footer p {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
    margin: 0 0 12px;
  }
  .product-cart footer b {
    font-size: 18px;
    color: #fff;
  }
  .view-cart {
    display: block;
    text-align: center;
    color: var(--commerce-muted);
    font-size: 12px;
    margin-bottom: 10px;
    text-decoration: underline;
  }
  .btn-checkout-wa {
    width: 100%;
    background: #166534;
    color: #fff;
    border: 0;
    border-radius: 8px;
    padding: 12px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-checkout-wa:hover {
    background: #15803d;
  }

  /* Cart Trigger */
  .cart-trigger {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: var(--commerce-accent);
    color: #fff;
    border: 0;
    border-radius: 30px;
    padding: 12px 22px;
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
    cursor: pointer;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: transform 0.2s, background 0.2s;
  }
  .cart-trigger:hover {
    transform: scale(1.05);
    background: var(--commerce-accent-hover);
  }
  .cart-trigger span {
    background: #fff;
    color: var(--commerce-accent);
    border-radius: 10px;
    padding: 2px 7px;
    font-size: 11px;
  }

  /* Toast */
  .product-toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(30px);
    background: #1c1917;
    color: #fff;
    border: 1px solid var(--commerce-accent);
    padding: 10px 22px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
    z-index: 50;
  }
  .product-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (max-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 640px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .product-image-container {
      height: 160px;
      padding: 10px;
    }
    .product-info {
      padding: 12px 10px;
    }
    .product-info h3 {
      font-size: 12px;
    }
    .product-info b {
      font-size: 15px;
    }
    .product-card-actions {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .section-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  import { loadCart, saveCart, loadWishlist, saveWishlist, loadCatalogFromStorage } from "../lib/storefrontStorage";
  import type { Product } from "../data/products";

  const WHATSAPP_PHONE = "5551993257923";

  function initProductSection() {
    document.querySelectorAll<HTMLElement>("[data-product-section]").forEach((section) => {
      if (section.dataset.productReady === "true") return;
      section.dataset.productReady = "true";

      const defaultCatalogEl = section.querySelector("[data-product-catalog]");
      const defaultCatalog: Product[] = JSON.parse(defaultCatalogEl?.textContent || "[]");
      const catalog: Product[] = loadCatalogFromStorage<Product>() || defaultCatalog;

      const cart = loadCart(catalog.map((p) => p.id));
      let wishlist = loadWishlist();
      const toast = section.querySelector<HTMLElement>("[data-product-toast]");
      let toastTimer = 0;

      const showToast = (msg: string) => {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.classList.remove("show"), 2200);
      };

      const formatBRL = (val: number) => `R$ ${val.toFixed(2).replace(".", ",")}`;

      const sendWhatsAppOrder = (productName: string, price: number) => {
        const text = `Olá Tchê Empório Gaúcho!\n\nTenho interesse no produto *${productName}* (${formatBRL(price)}).\n\nEstá disponível para pronta entrega ou retirada? Poderia me informar o valor do frete?`;
        const url = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(text)}`;
        window.open(url, "_blank");
      };

      const sendCartCheckout = () => {
        const entries = Object.entries(cart)
          .map(([id, qty]) => ({ item: catalog.find((p) => p.id === id), qty }))
          .filter((e): e is { item: Product; qty: number } => Boolean(e.item));

        if (!entries.length) {
          showToast("Sua sacola está vazia.");
          return;
        }

        let msg = `Olá Tchê Empório Gaúcho!\n\nGostaria de fazer o pedido dos seguintes produtos da sacola:\n\n`;
        let total = 0;
        entries.forEach((e) => {
          const sub = e.item.price * e.qty;
          total += sub;
          msg += `• ${e.qty}x ${e.item.name} (${formatBRL(e.item.price)}) = ${formatBRL(sub)}\n`;
        });
        msg += `\n*Total Estimado: ${formatBRL(total)}*\n\nPor favor, confirme a disponibilidade e o valor do frete para o meu CEP.`;

        const url = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(msg)}`;
        window.open(url, "_blank");
      };

      const renderCart = () => {
        const entries = Object.entries(cart)
          .map(([id, qty]) => ({ item: catalog.find((p) => p.id === id), qty }))
          .filter((e): e is { item: Product; qty: number } => Boolean(e.item));

        const totalQty = entries.reduce((acc, e) => acc + e.qty, 0);
        const totalPrice = entries.reduce((acc, e) => acc + e.item.price * e.qty, 0);

        section.querySelectorAll("[data-cart-count], [data-floating-count]").forEach((el) => {
          el.textContent = String(totalQty);
        });

        const totalEl = section.querySelector("[data-cart-total]");
        if (totalEl) totalEl.textContent = formatBRL(totalPrice);

        const itemsEl = section.querySelector("[data-cart-items]");
        if (itemsEl) {
          itemsEl.innerHTML = entries.length
            ? entries
                .map(
                  (e) =>
                    `<div class="cart-row"><span><b>${e.item.name}</b><small>${formatBRL(e.item.price)} × ${e.qty}</small></span><button type="button" data-remove-item="${e.item.id}" aria-label="Remover ${e.item.name}">Remover</button></div>`
                )
                .join("")
            : `<p class="empty-cart">Sua sacola está vazia.</p>`;
        }

        saveCart(cart);
      };

      // Wishlist init
      section.querySelectorAll<HTMLElement>(".wish").forEach((btn) => {
        const prodEl = btn.closest<HTMLElement>("[data-product]");
        const prodId = prodEl?.dataset.product;
        if (prodId) {
          btn.setAttribute("aria-pressed", String(wishlist.includes(prodId)));
        }
      });

      const cartDrawer = section.querySelector<HTMLElement>("[data-product-cart]");

      section.addEventListener(
        "click",
        (ev) => {
          const target = (ev.target as HTMLElement).closest<HTMLElement>(
            ".wish,[data-add-cart],[data-order-whatsapp],[data-open-cart],[data-close-cart],[data-remove-item],[data-checkout]"
          );
          if (!target) return;
          ev.stopImmediatePropagation();

          if (target.matches(".wish")) {
            const prodId = target.closest<HTMLElement>("[data-product]")?.dataset.product;
            if (!prodId) return;
            const exists = wishlist.includes(prodId);
            wishlist = exists ? wishlist.filter((id) => id !== prodId) : [...wishlist, prodId];
            target.setAttribute("aria-pressed", String(!exists));
            saveWishlist(wishlist);
            showToast(exists ? "Removido dos favoritos" : "Salvo nos seus favoritos");
          } else if (target.matches("[data-order-whatsapp]")) {
            const name = target.dataset.name || "Produto";
            const price = parseFloat(target.dataset.price || "0");
            sendWhatsAppOrder(name, price);
          } else if (target.matches("[data-add-cart]")) {
            const id = target.dataset.id;
            if (!id) return;
            cart[id] = (cart[id] || 0) + 1;
            renderCart();
            showToast(`${target.dataset.name} adicionado à sacola`);
          } else if (target.matches("[data-open-cart]")) {
            cartDrawer?.classList.add("open");
            cartDrawer?.setAttribute("aria-hidden", "false");
          } else if (target.matches("[data-close-cart]")) {
            cartDrawer?.classList.remove("open");
            cartDrawer?.setAttribute("aria-hidden", "true");
          } else if (target.matches("[data-remove-item]")) {
            const id = target.dataset.removeItem;
            if (id) {
              delete cart[id];
              renderCart();
            }
          } else if (target.matches("[data-checkout]")) {
            sendCartCheckout();
          }
        },
        true
      );

      renderCart();
    });
  }

  initProductSection();
  document.addEventListener("astro:page-load", initProductSection);
</script>
