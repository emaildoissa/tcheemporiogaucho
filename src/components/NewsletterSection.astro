<section id="newsletter" style="--image:url('/uploads/2025/11/serra-gaucha-600x394.png')">
  <div data-mos="fade-right">
    <h2>Receba Novidades Coloniais</h2>
    <p>Novos lotes de vinhos da serra, queijos premiados e condições especiais direto no seu e-mail.</p>
  </div>

  <form data-demo-form="newsletter" data-mos="fade-left" method="post">
    <label for="landing-page-3-email">Endereço de e-mail</label>
    <input
      autocomplete="email"
      id="landing-page-3-email"
      name="email"
      placeholder="Digite seu melhor e-mail"
      required
      type="email"
    />
    <button type="submit">Cadastrar</button>
  </form>
</section>

<style>
  section {
    background-image: linear-gradient(90deg, rgba(15, 12, 12, 0.95), rgba(80, 15, 20, 0.65)), var(--image);
    color: #fff;
    background-position: center center;
    background-size: cover;
    border: 1px solid var(--commerce-border);
    border-radius: 12px;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 180px;
    margin-bottom: 36px;
    padding: 38px 45px;
    font-family: Inter, Arial, sans-serif;
    display: grid;
  }
  h2 {
    margin: 0 0 10px;
    font-size: 22px;
    font-weight: 700;
  }
  p {
    color: #d1d5db;
    max-width: 460px;
    margin: 0;
    line-height: 1.6;
    font-size: 13px;
  }
  form {
    display: flex;
  }
  label {
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    width: 1px;
    height: 1px;
    position: absolute;
    overflow: hidden;
  }
  input {
    color: #fff;
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid var(--commerce-border);
    border-radius: 8px 0 0 8px;
    flex: 1;
    min-width: 0;
    height: 48px;
    padding: 0 16px;
    font-size: 13px;
  }
  input:focus {
    outline: none;
    border-color: var(--commerce-accent);
  }
  button {
    color: #fff;
    cursor: pointer;
    background: var(--commerce-accent);
    border: 0;
    border-radius: 0 8px 8px 0;
    padding: 0 24px;
    font-size: 12px;
    font-weight: 700;
    transition: background 0.2s;
  }
  button:hover {
    background: var(--commerce-accent-hover);
  }
  @media (width <= 900px) {
    section {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
  @media (width <= 600px) {
    section {
      padding: 24px 18px;
    }
    form {
      display: grid;
    }
    input {
      border-radius: 8px;
      margin-bottom: 8px;
    }
    button {
      border-radius: 8px;
      height: 44px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-demo-form="newsletter"]').forEach((form) => {
    form.addEventListener("submit", (ev) => {
      ev.preventDefault();
      const btn = form.querySelector("button");
      if (btn) {
        btn.textContent = "Cadastrado!";
      }
    });
  });
</script>
