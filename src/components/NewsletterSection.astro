<section id="newsletter" style="--image:url('/images/shop/cosmic-minimal.png')">
  <div data-mos="fade-right">
    <h2>Seja o primeiro a saber</h2>
    <p>Novos lançamentos, ofertas exclusivas e inspiração de estilo direto no seu e-mail.</p>
  </div>

  <form data-demo-form="newsletter" data-mos="fade-left" method="post">
    <label for="landing-page-3-email">Endereço de e-mail</label>
    <input
      autocomplete="email"
      id="landing-page-3-email"
      name="email"
      placeholder="Digite seu e-mail"
      required
      type="email"
    />
    <button type="submit">Inscrever-se</button>
  </form>
</section>

<style>
  section {
    background-image: linear-gradient(90deg, #120708, #52070b80), var(--image);
    color: #fff;
    background-position: 78% 48%;
    background-size: cover;
    border: 1px solid #352023;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 190px;
    margin-bottom: 36px;
    padding: 38px 55px;
    font-family: Inter, Arial, sans-serif;
    display: grid;
  }
  h2 {
    text-transform: uppercase;
    margin: 0 0 12px;
    font-size: 21px;
  }
  p {
    color: #bbb;
    max-width: 460px;
    margin: 0;
    line-height: 1.7;
  }
  form {
    display: flex;
  }
  label {
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    width: 1px;
    height: 1px;
    position: absolute;
    overflow: hidden;
  }
  input {
    color: #fff;
    background: #000000b3;
    border: 1px solid #652127;
    flex: 1;
    min-width: 0;
    height: 49px;
    padding: 0 16px;
  }
  button {
    color: #fff;
    text-transform: uppercase;
    cursor: pointer;
    background: #c51117;
    border: 0;
    padding: 0 28px;
    font-size: 11px;
    font-weight: 700;
  }
  @media (width <= 900px) {
    section {
      grid-template-columns: 1fr;
      gap: 25px;
    }
  }
  @media (width <= 600px) {
    section {
      padding: 25px 18px;
    }
    form {
      display: grid;
    }
    button {
      height: 46px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-demo-form="newsletter"]').forEach((form) => {
    form.addEventListener("submit", (ev) => {
      ev.preventDefault();
      const btn = form.querySelector("button");
      if (btn) {
        btn.textContent = "Inscrito com sucesso!";
      }
    });
  });
</script>
