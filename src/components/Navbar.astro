---
const navLinks = [
  { label: "Início", href: "/" },
  { label: "Catálogo", href: "/catalogo" },
  { label: "Nossa Origem", href: "/#sustentabilidade" },
  { label: "Coleções", href: "/#colecoes" },
  { label: "Depoimentos", href: "/#depoimentos" },
  { label: "Admin ⚙️", href: "/admin" },
];
---

<div
  class="w-full flex duration-300 border-b fixed flex-col left-0 navbar--initial top-0 transition-all z-30"
  data-nav-container
>
  <div class="w-full flex mx-auto">
    <div class="w-full flex items-center h-20 site-container">
      <header class="w-full flex items-center relative gap-4">
        <!-- Logo Principal Grande (Emblema Colonial Oficial) -->
        <div class="flex-auto flex justify-start items-center">
          <a
            href="/"
            class="inline-flex items-center gap-3.5 primary-focus text-foreground group py-1"
            aria-label="Início Tchê Empório Gaúcho"
          >
            <img
              src="/images/logo.png"
              alt="Logo Tchê Empório Gaúcho"
              class="h-14 sm:h-16 w-auto object-contain drop-shadow-md group-hover:scale-105 transition-transform duration-200"
            />
            <div class="flex flex-col">
              <span class="font-extrabold tracking-tight text-xl sm:text-2xl text-[var(--foreground)] leading-none">
                Tchê Empório
              </span>
              <span class="text-xs sm:text-sm font-semibold tracking-wider uppercase text-[var(--commerce-accent)] mt-0.5">
                Gaúcho • Tradição Colonial
              </span>
            </div>
          </a>
        </div>

        <div class="justify-end flex flex-auto items-center">
          <nav class="hidden md:block my-auto">
            <ul class="h-fit flex items-center px-2">
              {
                navLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="w-full flex items-center nav__link--base primary-focus py-2 rounded-md px-3 gap-1.5 h-10 relative font-semibold text-xs tracking-wide"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <a
            href="https://wa.me/5551993257923?text=Ol%C3%A1%20Tch%C3%AA%20Emp%C3%B3rio!%20Gostaria%20de%20tirar%20uma%20d%C3%BAvida%20sobre%20os%20produtos."
            target="_blank"
            class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold rounded-xl bg-[#166534] hover:bg-[#15803d] text-white transition shadow-sm mr-2"
          >
            <span>💬 WhatsApp</span>
          </a>

          <!-- Botão Alternador Claro / Escuro -->
          <button
            class="theme-toggle p-2.5 rounded-full primary-focus border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--muted)] text-[var(--foreground)] transition shadow-sm ml-1"
            aria-label="Alternar entre tema Claro e Escuro"
            title="Alternar entre tema Claro e Escuro"
          >
            <div class="size-5 relative flex items-center justify-center">
              <!-- Ícone Sol (aparece no modo escuro para ir ao claro) -->
              <svg
                class="size-5 absolute inset-0 theme-toggle__light-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="m17.66 17.66 1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="m6.34 17.66-1.41 1.41"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
              </svg>
              <!-- Ícone Lua (aparece no modo claro para ir ao escuro) -->
              <svg
                class="size-5 absolute inset-0 theme-toggle__dark-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
            </div>
          </button>

          <!-- Menu Mobile -->
          <div class="flex items-center md:hidden ml-2">
            <div id="mobile-nav__container">
              <button
                class="flex items-center justify-center p-2 rounded-lg primary-focus text-[var(--foreground)] border border-[var(--border)]"
                aria-label="Abrir menu de navegação"
                id="mobile-nav__burger"
                aria-expanded="false"
              >
                <svg
                  class="size-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.8"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                  ></path>
                </svg>
              </button>
              <div
                class="bg-[var(--card)] border-l border-[var(--border)] fixed h-screen hidden overflow-y-auto right-0 top-0 w-72 z-20 shadow-2xl"
                id="mobile-nav__content"
              >
                <div class="p-6 flex flex-col h-full justify-between">
                  <div>
                    <div class="flex items-center justify-between pb-6 border-b border-[var(--border)]">
                      <div class="flex items-center gap-2.5">
                        <img
                          src="/images/logo.png"
                          alt="Logo Tchê Empório Gaúcho"
                          class="h-10 w-auto object-contain drop-shadow-sm"
                        />
                        <span class="font-bold text-[var(--foreground)] text-base">Tchê Empório</span>
                      </div>
                      <button
                        type="button"
                        id="mobile-nav__close"
                        class="text-[var(--muted-foreground)] hover:text-[var(--foreground)] text-xl"
                      >
                        ✕
                      </button>
                    </div>
                    <ul class="py-6 space-y-3">
                      {
                        navLinks.map((link) => (
                          <li>
                            <a
                              href={link.href}
                              class="block py-2 text-sm font-semibold text-[var(--foreground)] hover:text-[var(--commerce-accent)]"
                            >
                              {link.label}
                            </a>
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                  <div class="pt-6 border-t border-[var(--border)]">
                    <a
                      href="https://wa.me/5551993257923"
                      target="_blank"
                      class="w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-[#166534] text-white font-bold text-sm shadow-md"
                    >
                      💬 Falar no WhatsApp
                    </a>
                  </div>
                </div>
              </div>
              <button
                class="bg-black/60 fixed h-screen left-0 mobile-nav__backdrop--fade-out top-0 z-10 backdrop-blur-xs"
                aria-label="Fechar menu de navegação"
                id="mobile-nav__backdrop"
              ></button>
            </div>
          </div>
        </div>
      </header>
    </div>
  </div>
</div>

<style is:global>
  .theme-toggle__dark-icon {
    display: none;
  }
  .theme-toggle__light-icon {
    display: block;
  }

  /* Quando o documento está em modo claro: mostra a lua para alternar ao escuro */
  html:not(.dark) .theme-toggle__dark-icon {
    display: block;
  }
  html:not(.dark) .theme-toggle__light-icon {
    display: none;
  }

  .mobile-nav__backdrop--fade-in {
    width: 100vw;
    animation: 0.3s ease-in-out forwards MobileNavFadeInAnimation;
    display: block;
  }
  .mobile-nav__backdrop--fade-out {
    opacity: 0;
    width: 0;
    display: none;
  }
  @keyframes MobileNavFadeInAnimation {
    0% {
      opacity: 0;
    }
    to {
      opacity: 0.4;
    }
  }
  .mobile-nav--slide-in {
    animation: 0.3s ease-in-out forwards mobileNavSlideInAnimation;
  }
  .mobile-nav--slide-out {
    animation: 0.3s ease-in-out forwards mobileNavSlideOutAnimation;
  }
  @keyframes mobileNavSlideInAnimation {
    0% {
      right: -18rem;
    }
    to {
      right: 0;
    }
  }
  @keyframes mobileNavSlideOutAnimation {
    0% {
      right: 0;
    }
    to {
      right: -18rem;
    }
  }
  .navbar--scrolled {
    background-color: var(--background);
    border-bottom-color: var(--border);
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.15);
  }
  .navbar--initial {
    background-color: color-mix(in srgb, var(--background) 92%, transparent);
    border-bottom-color: var(--border);
    backdrop-filter: blur(8px);
  }
</style>

<script>
  function applyTheme(isDark: boolean) {
    if (isDark) {
      document.documentElement.classList.add("dark");
      localStorage.setItem("colorTheme", "dark");
    } else {
      document.documentElement.classList.remove("dark");
      localStorage.setItem("colorTheme", "light");
    }
  }

  function initThemeToggle() {
    const toggles = document.querySelectorAll(".theme-toggle");
    toggles.forEach((btn) => {
      btn.addEventListener("click", () => {
        const isCurrentlyDark = document.documentElement.classList.contains("dark");
        applyTheme(!isCurrentlyDark);
      });
    });
  }

  function initNavScroll() {
    const navContainer = document.querySelector("[data-nav-container]");
    const onScroll = () => {
      if (!navContainer) return;
      if (window.scrollY > 30) {
        navContainer.classList.add("navbar--scrolled");
        navContainer.classList.remove("navbar--initial");
      } else {
        navContainer.classList.add("navbar--initial");
        navContainer.classList.remove("navbar--scrolled");
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  function initMobileNav() {
    const container = document.getElementById("mobile-nav__container");
    const burger = document.getElementById("mobile-nav__burger");
    const content = document.getElementById("mobile-nav__content");
    const closeBtn = document.getElementById("mobile-nav__close");
    const backdrop = document.getElementById("mobile-nav__backdrop");

    const toggleMobile = (e: Event) => {
      e.preventDefault();
      if (!container || !burger || !content || !backdrop) return;
      if (container.classList.contains("open")) {
        container.classList.remove("open");
        burger.setAttribute("aria-expanded", "false");
        content.classList.remove("mobile-nav--slide-in");
        content.classList.add("mobile-nav--slide-out");
        setTimeout(() => content.classList.add("hidden"), 300);
        backdrop.classList.remove("mobile-nav__backdrop--fade-in");
        backdrop.classList.add("mobile-nav__backdrop--fade-out");
      } else {
        container.classList.add("open");
        burger.setAttribute("aria-expanded", "true");
        content.classList.remove("hidden", "mobile-nav--slide-out");
        content.classList.add("mobile-nav--slide-in");
        backdrop.classList.remove("hidden", "mobile-nav__backdrop--fade-out");
        backdrop.classList.add("mobile-nav__backdrop--fade-in");
      }
    };

    burger?.addEventListener("click", toggleMobile);
    closeBtn?.addEventListener("click", toggleMobile);
    backdrop?.addEventListener("click", toggleMobile);
  }

  initThemeToggle();
  initNavScroll();
  initMobileNav();
  document.addEventListener("astro:after-swap", () => {
    initThemeToggle();
    initNavScroll();
    initMobileNav();
  });
</script>
