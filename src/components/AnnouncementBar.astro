---
interface Props {
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  text = "Tradição & Sabor Colonial Gaúcho • Peça direto pelo WhatsApp",
  ctaLabel = "Ver Catálogo",
  ctaHref = "#produtos",
} = Astro.props;
---

<aside class="announcement-bar" aria-label="Aviso do Empório">
  <div class="announcement-bar__content">
    <span>{text}</span>
    <a href={ctaHref}>
      {ctaLabel}<span aria-hidden="true"> →</span>
    </a>
  </div>
</aside>

<style>
  .announcement-bar {
    z-index: 2;
    color: #fff;
    background: linear-gradient(90deg, #5b1016, var(--commerce-accent), #5b1016);
    width: 100%;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .announcement-bar__content {
    min-height: 2.5rem;
    padding: 0.55rem var(--page-gutter);
    text-align: center;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    justify-content: center;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.25;
    display: flex;
  }
  .announcement-bar a {
    color: #fde68a;
    text-underline-offset: 0.2rem;
    text-decoration: underline;
  }
  .announcement-bar a:hover {
    text-decoration-thickness: 0.12rem;
  }
  @media (width <= 640px) {
    .announcement-bar__content {
      font-size: 0.65rem;
    }
  }
</style>
