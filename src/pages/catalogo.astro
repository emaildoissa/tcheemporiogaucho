---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import { products as defaultProducts } from "../data/products";

// Server-side category calculation
const categoriesList = Array.from(
  new Set(defaultProducts.map((p) => p.category).filter(Boolean))
).sort((a, b) => {
  const countA = defaultProducts.filter((p) => p.category === a).length;
  const countB = defaultProducts.filter((p) => p.category === b).length;
  return countB - countA;
});

const categoryCounts = defaultProducts.reduce((acc, p) => {
  acc[p.category] = (acc[p.category] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const maxPrice = Math.ceil(
  Math.max(...defaultProducts.map((p) => p.price || 0))
);
---

<BaseLayout
  title="Catálogo Geral — Tchê Empório Gaúcho"
  description="Navegue por mais de 220 produtos coloniais e artesanais gaúchos: vinhos finos, queijos, chimias e embutidos. Filtros laterais em tempo real e pedido via WhatsApp."
>
  <div class="shop-all-page bg-[#070809] text-[#f2ede6] min-h-screen pt-[72px]">
    <AnnouncementBar text="Catálogo Completo • Peça diretamente pelo WhatsApp: (51) 99325-7923 • Entregas para todo o Brasil" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-[#a39a97] mb-6" aria-label="Navegação Estrutural">
        <a href="/" class="hover:text-white transition-colors">Início</a>
        <span class="text-[#453d3b]">/</span>
        <span class="text-white font-semibold">Catálogo Geral</span>
      </nav>

      <!-- Banner de Coleção (Estilo Vortexwear) -->
      <section class="shop-collection-banner relative overflow-hidden rounded-3xl border border-[#2d2220] bg-gradient-to-r from-[#170e0f] via-[#121010] to-[#1a1213] p-6 sm:p-9 mb-8 shadow-xl">
        <div class="relative z-10 max-w-2xl">
          <p class="text-xs font-bold uppercase tracking-[.2em] text-[#e67e84] flex items-center gap-2">
            <span>🍷</span> Tradição & Sabor Colonial Gaúcho
          </p>
          <h1 class="mt-3 text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
            O Autêntico Sabor do Rio Grande
          </h1>
          <p class="mt-3 text-sm text-[#b8adaa] leading-relaxed">
            Vinhos finos da Serra, chimias artesanais, embutidos coloniais, queijos, mel puro e compotas das melhores cooperativas e famílias do Sul.
          </p>
          <div class="mt-6 flex flex-wrap gap-2.5 text-xs font-semibold text-[#ded5d2]">
            <span class="rounded-full bg-[#241a1b] border border-[#3e2c2e] px-3.5 py-1.5 flex items-center gap-1.5">
              📦 228 produtos no catálogo
            </span>
            <span class="rounded-full bg-[#241a1b] border border-[#3e2c2e] px-3.5 py-1.5 flex items-center gap-1.5">
              💬 Atendimento direto no WhatsApp
            </span>
            <span class="rounded-full bg-[#241a1b] border border-[#3e2c2e] px-3.5 py-1.5 flex items-center gap-1.5">
              🧀 100% Colonial & Artesanal
            </span>
          </div>
        </div>
        <div class="shop-banner-orb absolute -right-12 -top-12 h-72 w-72 rounded-full bg-[#8b1b22]/15 blur-3xl pointer-events-none"></div>
      </section>

      <!-- Top Toolbar (Título, Contador, Busca, Ordenação, Botão Mobile) -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-8 pb-4 border-b border-[#221c1b]">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Todos os Produtos</h2>
          <p class="text-xs sm:text-sm text-[#a39a97] mt-1">
            Mostrando <span id="product-count" class="font-bold text-white">{defaultProducts.length}</span> itens
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <!-- Campo de Busca -->
          <div class="relative min-w-[200px] sm:w-64">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-500 text-sm">
              🔍
            </span>
            <input
              id="product-search"
              type="search"
              placeholder="Buscar produtos..."
              class="w-full rounded-lg border border-[#362e2c] bg-[#141212] pl-9 pr-8 py-2 text-xs sm:text-sm text-white placeholder-[#786e6b] focus:outline-none focus:border-[#8b1b22] transition"
              autocomplete="off"
            />
            <button
              type="button"
              id="clear-search-btn"
              class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-xs text-[#786e6b] hover:text-white hidden"
              title="Limpar busca"
            >
              ✕
            </button>
          </div>

          <!-- Select de Ordenação -->
          <div>
            <select
              id="sort-products"
              class="rounded-lg border border-[#362e2c] bg-[#141212] px-3 py-2 text-xs sm:text-sm text-white focus:outline-none focus:border-[#8b1b22] transition cursor-pointer"
            >
              <option value="featured">Destaques</option>
              <option value="price-asc">Menor Preço</option>
              <option value="price-desc">Maior Preço</option>
              <option value="name-asc">Nome (A - Z)</option>
              <option value="rating">Mais Bem Avaliados</option>
            </select>
          </div>

          <!-- Botão Filtros para Mobile -->
          <button
            type="button"
            id="filter-toggle-btn"
            class="lg:hidden inline-flex items-center gap-2 rounded-lg border border-[#362e2c] bg-[#141212] px-3.5 py-2 text-xs font-bold text-white hover:border-[#8b1b22] transition"
          >
            <span>⚡ Filtros</span>
            <span id="mobile-filter-badge" class="hidden px-2 py-0.5 rounded-full text-[10px] bg-[#8b1b22] text-white font-extrabold">0</span>
          </button>
        </div>
      </div>

      <!-- Layout 2 Colunas: Barra Lateral Fixa + Grid Central de Produtos -->
      <div class="flex gap-8 items-start relative">
        <!-- BARRA LATERAL FIXA SEM ITENS (Apenas Controles de Filtros) -->
        <aside
          id="filter-sidebar"
          class="shop-sidebar w-64 shrink-0 hidden lg:block"
          aria-label="Filtros do Catálogo"
        >
          <div class="sticky top-24 space-y-6 bg-[#121010] border border-[#24201f] p-5 rounded-2xl shadow-lg">
            <!-- Cabeçalho do Filtro -->
            <div class="flex items-center justify-between pb-3 border-b border-[#24201f]">
              <div class="flex items-center gap-2">
                <span class="text-sm">⚡</span>
                <h3 class="font-bold text-xs uppercase tracking-wider text-white">Filtros</h3>
              </div>
              <button
                type="button"
                id="clear-all-filters-btn"
                class="text-xs text-[#e67e84] hover:text-[#ff9da3] font-semibold underline underline-offset-2 transition"
              >
                Limpar Todos
              </button>
            </div>

            <!-- Categorias (com Radio Inputs e Contagem de Produtos) -->
            <div>
              <h4 class="font-bold text-xs uppercase tracking-wider text-[#bfb5b2] mb-3">
                Categorias
              </h4>
              <div class="space-y-1.5 max-h-[340px] overflow-y-auto pr-1 custom-scrollbar" id="categories-container">
                <label class="flex items-center justify-between gap-2 cursor-pointer group py-1.5 px-2 rounded-lg hover:bg-[#1a1716] transition">
                  <div class="flex items-center gap-2 min-w-0">
                    <input
                      type="radio"
                      name="filter-category"
                      value="all"
                      class="filter-cat-radio accent-[#8b1b22] cursor-pointer"
                      checked
                    />
                    <span class="text-xs sm:text-sm text-[#bfb5b2] group-hover:text-white transition truncate">
                      Todas as Categorias
                    </span>
                  </div>
                  <span class="text-[11px] text-[#786e6b] group-hover:text-white bg-[#1a1716] px-2 py-0.5 rounded-full font-medium shrink-0">
                    {defaultProducts.length}
                  </span>
                </label>

                {
                  categoriesList.map((cat) => (
                    <label class="flex items-center justify-between gap-2 cursor-pointer group py-1.5 px-2 rounded-lg hover:bg-[#1a1716] transition">
                      <div class="flex items-center gap-2 min-w-0">
                        <input
                          type="radio"
                          name="filter-category"
                          value={cat}
                          class="filter-cat-radio accent-[#8b1b22] cursor-pointer"
                        />
                        <span class="text-xs sm:text-sm text-[#bfb5b2] group-hover:text-white transition truncate" title={cat}>
                          {cat}
                        </span>
                      </div>
                      <span class="text-[11px] text-[#786e6b] group-hover:text-white bg-[#1a1716] px-2 py-0.5 rounded-full font-medium shrink-0">
                        {categoryCounts[cat] || 0}
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>

            <!-- Faixa de Preço (Slider e Display Dinâmico) -->
            <div class="border-t border-[#24201f] pt-4">
              <div class="flex items-center justify-between mb-2">
                <h4 class="font-bold text-xs uppercase tracking-wider text-[#bfb5b2]">
                  Faixa de Preço
                </h4>
                <span id="price-display" class="text-xs font-bold text-[#e67e84]">
                  Até R$ {maxPrice},00
                </span>
              </div>
              <input
                type="range"
                id="price-range"
                min="0"
                max={maxPrice}
                value={maxPrice}
                step="5"
                class="w-full accent-[#8b1b22] cursor-pointer"
              />
              <div class="flex justify-between text-[11px] text-[#786e6b] mt-1">
                <span>R$ 0</span>
                <span>R$ {maxPrice}</span>
              </div>
            </div>

            <!-- Filtro Rápido: Mais Vendidos -->
            <div class="border-t border-[#24201f] pt-4">
              <h4 class="font-bold text-xs uppercase tracking-wider text-[#bfb5b2] mb-2.5">
                Filtros Especiais
              </h4>
              <label class="flex items-center gap-2.5 cursor-pointer group py-1">
                <input
                  type="checkbox"
                  id="filter-featured"
                  class="accent-[#8b1b22] rounded cursor-pointer w-4 h-4"
                />
                <span class="text-xs sm:text-sm text-[#bfb5b2] group-hover:text-white transition">
                  Apenas Mais Vendidos / Selos
                </span>
              </label>
            </div>

            <!-- Botão Limpar Filtros no Rodapé da Barra -->
            <button
              type="button"
              id="clear-filters-btn-secondary"
              class="w-full py-2.5 rounded-lg border border-[#362e2c] bg-[#161413] hover:bg-[#201b1a] text-xs font-bold text-[#bfb5b2] hover:text-white transition"
            >
              Limpar Todos os Filtros
            </button>
          </div>
        </aside>

        <!-- Backdrop Mobile para Sidebar -->
        <div id="mobile-sidebar-backdrop" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-40 hidden lg:hidden"></div>

        <!-- ÁREA CENTRAL COM OS ITENS CONFORME FILTRADOS -->
        <main class="flex-1 min-w-0" id="main-catalog-content">
          <!-- Grid de Produtos -->
          <div
            id="products-grid"
            class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-3 gap-4 sm:gap-6"
          >
            {
              defaultProducts.map((product) => (
                <article
                  class="product-card group relative bg-[#121010] rounded-2xl overflow-hidden border border-[#24201f] hover:border-[#8b1b22] transition-all duration-300 flex flex-col justify-between shadow-md hover:shadow-xl hover:-translate-y-1"
                  data-product-id={product.id}
                  data-product-name={product.name.toLowerCase()}
                  data-product-category={product.category}
                  data-product-price={product.price}
                  data-product-rating={product.rating || 5}
                  data-product-featured={product.featured ? "true" : "false"}
                >
                  <!-- Selo Superior -->
                  {product.badge && (
                    <span class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-md bg-[#8b1b22] text-white text-[10px] font-black uppercase tracking-wider shadow">
                      {product.badge}
                    </span>
                  )}

                  <!-- Botão Favoritos -->
                  <button
                    type="button"
                    class="wish-btn absolute top-3 right-3 z-10 p-2 rounded-full bg-black/40 backdrop-blur text-gray-400 hover:text-white hover:bg-black/70 transition"
                    aria-label={`Salvar ${product.name}`}
                    data-wish-id={product.id}
                  >
                    <svg height="16" width="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.7-7.5a5.5 5.5 0 0 0 1.1-8.9Z" />
                    </svg>
                  </button>

                  <!-- Imagem do Produto -->
                  <div
                    class="relative aspect-[4/3] bg-[#181514] overflow-hidden flex items-center justify-center p-3 cursor-pointer"
                    data-product-link={`/produto/${product.id}`}
                  >
                    <img
                      src={product.image || "/images/shop/cosmic-products.png"}
                      alt={product.name}
                      loading="lazy"
                      class="max-h-full max-w-full object-contain transition-transform duration-500 group-hover:scale-105"
                      onerror="this.src='/images/shop/cosmic-products.png'"
                    />
                  </div>

                  <!-- Detalhes do Produto -->
                  <div class="p-4 flex flex-col flex-grow justify-between">
                    <div>
                      <span class="text-[10px] font-bold uppercase tracking-wider text-[#e67e84] block mb-1">
                        {product.category}
                      </span>
                      <h3
                        class="font-semibold text-xs sm:text-sm text-white line-clamp-2 group-hover:text-[#ff9da3] transition-colors leading-snug cursor-pointer"
                        data-product-link={`/produto/${product.id}`}
                        title={product.name}
                      >
                        {product.name}
                      </h3>
                      <div class="flex items-center gap-1.5 mt-2 text-xs">
                        <span class="text-[#f59e0b] text-[11px]">★★★★★</span>
                        <span class="text-[#786e6b] text-[11px]">({product.reviews || 18})</span>
                      </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-[#1f1b1a]">
                      <div class="mb-3">
                        <span class="text-base sm:text-lg font-black text-white">
                          R$ {product.price.toFixed(2).replace(".", ",")}
                        </span>
                      </div>

                      <div class="grid grid-cols-2 gap-2">
                        <button
                          type="button"
                          class="btn-order-wa flex items-center justify-center gap-1.5 py-2 px-2.5 rounded-lg bg-[#166534] hover:bg-[#15803d] text-white text-[11px] font-bold transition shadow-sm"
                          data-wa-order
                          data-id={product.id}
                          data-name={product.name}
                          data-price={product.price}
                          title="Fazer pedido direto no WhatsApp"
                        >
                          <span>💬 WhatsApp</span>
                        </button>
                        <button
                          type="button"
                          class="btn-add-cart flex items-center justify-center gap-1 py-2 px-2.5 rounded-lg bg-[#1c1817] hover:bg-[#25201f] border border-[#362e2c] hover:border-[#8b1b22] text-[#f2ede6] text-[11px] font-bold transition"
                          data-add-cart
                          data-id={product.id}
                          data-name={product.name}
                          data-price={product.price}
                          title="Adicionar à sacola de compras"
                        >
                          <span>+ Sacola</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <!-- Empty State (Sem Produtos Correspondentes) -->
          <div
            id="empty-state"
            class="hidden text-center py-20 px-4 bg-[#121010] border border-dashed border-[#2d2422] rounded-3xl"
          >
            <div class="text-5xl mb-4">🧺</div>
            <h3 class="text-xl font-bold text-white mb-2">Nenhum produto encontrado</h3>
            <p class="text-sm text-[#a39a97] max-w-md mx-auto mb-6">
              Não encontramos nenhum item correspondente aos filtros selecionados. Tente ajustar os critérios ou limpar os filtros.
            </p>
            <button
              type="button"
              id="empty-reset-btn"
              class="px-5 py-2.5 rounded-xl bg-[#8b1b22] hover:bg-[#a52129] text-white text-xs font-bold transition shadow-lg"
            >
              Ver Todos os Produtos
            </button>
          </div>
        </main>
      </div>
    </div>

    <!-- Modal Detalhes do Produto (QuickView) -->
    <dialog
      id="quickview-modal"
      class="rounded-3xl bg-[#141212] text-[#f2ede6] border border-[#362e2c] p-6 sm:p-8 max-w-xl w-[92vw] shadow-2xl backdrop:bg-black/85 backdrop:backdrop-blur-sm"
    >
      <button
        type="button"
        id="quickview-close-btn"
        class="absolute top-4 right-5 text-gray-400 hover:text-white text-xl"
        aria-label="Fechar"
      >
        ✕
      </button>
      <div id="quickview-content"></div>
    </dialog>

    <!-- Sacola Drawer Lateral -->
    <aside
      id="cart-drawer"
      class="fixed top-0 right-0 w-full sm:w-[380px] h-screen bg-[#141212] border-l border-[#2d2422] z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col p-6 shadow-2xl"
    >
      <header class="flex items-center justify-between pb-4 border-b border-[#2d2422]">
        <div class="flex items-center gap-2">
          <span class="text-xl">🛍️</span>
          <h2 class="text-base font-bold text-white">Sua Sacola</h2>
          <span id="drawer-count-badge" class="px-2 py-0.5 rounded-full text-xs font-extrabold bg-[#8b1b22] text-white">0</span>
        </div>
        <button type="button" id="cart-drawer-close" class="text-gray-400 hover:text-white text-xl">✕</button>
      </header>

      <div class="flex-1 overflow-y-auto py-4 space-y-3 custom-scrollbar" id="cart-drawer-items"></div>

      <footer class="pt-4 border-t border-[#2d2422] space-y-3">
        <div class="flex items-center justify-between text-sm">
          <span class="text-[#a39a97]">Subtotal</span>
          <strong id="cart-drawer-total" class="text-lg font-black text-white">R$ 0,00</strong>
        </div>
        <button
          type="button"
          id="cart-checkout-btn"
          class="w-full py-3 rounded-xl bg-[#166534] hover:bg-[#15803d] text-white text-xs sm:text-sm font-bold transition flex items-center justify-center gap-2 shadow-lg"
        >
          <span>💬 Finalizar Pedido via WhatsApp</span>
        </button>
      </footer>
    </aside>

    <!-- Botão Flutuante de Sacola -->
    <button
      type="button"
      id="floating-cart-btn"
      class="fixed bottom-6 right-6 z-40 flex items-center gap-2.5 px-5 py-3 rounded-full bg-[#8b1b22] hover:bg-[#a52129] text-white font-bold text-xs sm:text-sm shadow-2xl hover:scale-105 transition"
      aria-label="Abrir Sacola"
    >
      <span>🛍️ Sacola</span>
      <span id="floating-cart-badge" class="px-2 py-0.5 rounded-full bg-white text-[#8b1b22] font-black text-xs">0</span>
    </button>

    <!-- Toast de Notificações -->
    <div
      id="shop-toast"
      class="fixed bottom-8 left-1/2 -translate-x-1/2 translate-y-10 opacity-0 pointer-events-none transition-all duration-300 z-50 px-5 py-2.5 rounded-full bg-[#1c1817] text-white border border-[#8b1b22] text-xs font-bold shadow-2xl"
    ></div>

    <!-- Catálogo de fallback embutido -->
    <script type="application/json" id="embedded-catalog" set:html={JSON.stringify(defaultProducts)} />
  </div>
</BaseLayout>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #362e2c;
    border-radius: 9999px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  /* Animações e transições nos cards */
  .product-card {
    will-change: transform, opacity;
  }

  .wish-btn[aria-pressed="true"] svg {
    fill: #e67e84;
    color: #e67e84;
  }

  /* Estado visível do Toast */
  #shop-toast.toast-active {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>

<script>
  import {
    loadCart,
    saveCart,
    loadWishlist,
    saveWishlist,
    loadCatalogFromStorage,
  } from "../lib/storefrontStorage";
  import type { Product } from "../data/products";

  const WHATSAPP_PHONE = "5551993257923";

  function initCatalog() {
    const embeddedCatalogEl = document.getElementById("embedded-catalog");
    const defaultCatalog: Product[] = JSON.parse(embeddedCatalogEl?.textContent || "[]");
    const customCatalog = loadCatalogFromStorage<Product>();
    const catalog: Product[] = customCatalog || defaultCatalog;

    const cart = loadCart(catalog.map((p) => p.id));
    let wishlist = loadWishlist();

    const formatBRL = (val: number) => `R$ ${val.toFixed(2).replace(".", ",")}`;

    const toast = document.getElementById("shop-toast");
    let toastTimeout = 0;
    const showToast = (text: string) => {
      if (!toast) return;
      toast.textContent = text;
      toast.classList.add("toast-active");
      clearTimeout(toastTimeout);
      toastTimeout = window.setTimeout(() => toast.classList.remove("toast-active"), 2200);
    };

    // DOM Elements - Filtering & Sorting
    const grid = document.getElementById("products-grid");
    const emptyState = document.getElementById("empty-state");
    const productCountEl = document.getElementById("product-count");
    const searchInput = document.getElementById("product-search") as HTMLInputElement;
    const clearSearchBtn = document.getElementById("clear-search-btn");
    const sortSelect = document.getElementById("sort-products") as HTMLSelectElement;
    const priceRange = document.getElementById("price-range") as HTMLInputElement;
    const priceDisplay = document.getElementById("price-display");
    const filterFeatured = document.getElementById("filter-featured") as HTMLInputElement;
    const catRadios = document.querySelectorAll<HTMLInputElement>(".filter-cat-radio");
    const clearFiltersBtn = document.getElementById("clear-all-filters-btn");
    const clearFiltersBtn2 = document.getElementById("clear-filters-btn-secondary");
    const emptyResetBtn = document.getElementById("empty-reset-btn");
    const mobileFilterBadge = document.getElementById("mobile-filter-badge");

    // Filter State
    let selectedCategory = "all";
    let searchQuery = "";
    let maxPrice = Number(priceRange?.max || 280);
    let onlyFeatured = false;
    let currentSort = "featured";

    // Read initial URL params (e.g. ?cat=Vinhos+Finos)
    const urlParams = new URLSearchParams(window.location.search);
    const paramCat = urlParams.get("cat") || urlParams.get("categoria");
    if (paramCat) {
      selectedCategory = paramCat;
      const matchingRadio = Array.from(catRadios).find((r) => r.value.toLowerCase() === paramCat.toLowerCase());
      if (matchingRadio) matchingRadio.checked = true;
    }
    const paramQuery = urlParams.get("q") || urlParams.get("busca");
    if (paramQuery && searchInput) {
      searchQuery = paramQuery.toLowerCase().trim();
      searchInput.value = paramQuery;
      if (clearSearchBtn) clearSearchBtn.classList.remove("hidden");
    }

    // Dynamic Filter & Sort Function
    const applyFilters = () => {
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>(".product-card"));

      let visibleCount = 0;
      let activeFiltersCount = 0;

      if (selectedCategory !== "all") activeFiltersCount++;
      if (searchQuery) activeFiltersCount++;
      if (maxPrice < Number(priceRange?.max || 280)) activeFiltersCount++;
      if (onlyFeatured) activeFiltersCount++;

      if (mobileFilterBadge) {
        if (activeFiltersCount > 0) {
          mobileFilterBadge.textContent = String(activeFiltersCount);
          mobileFilterBadge.classList.remove("hidden");
        } else {
          mobileFilterBadge.classList.add("hidden");
        }
      }

      // Filter
      cards.forEach((card) => {
        const cat = card.dataset.productCategory || "";
        const name = card.dataset.productName || "";
        const price = parseFloat(card.dataset.productPrice || "0");
        const isFeatured = card.dataset.productFeatured === "true";

        const matchesCategory =
          selectedCategory === "all" ||
          cat.toLowerCase() === selectedCategory.toLowerCase();

        const matchesSearch =
          !searchQuery ||
          name.includes(searchQuery) ||
          cat.toLowerCase().includes(searchQuery);

        const matchesPrice = price <= maxPrice;
        const matchesFeatured = !onlyFeatured || isFeatured;

        if (matchesCategory && matchesSearch && matchesPrice && matchesFeatured) {
          card.style.display = "flex";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      // Sort
      cards.sort((a, b) => {
        const priceA = parseFloat(a.dataset.productPrice || "0");
        const priceB = parseFloat(b.dataset.productPrice || "0");
        const nameA = a.dataset.productName || "";
        const nameB = b.dataset.productName || "";
        const ratingA = parseFloat(a.dataset.productRating || "5");
        const ratingB = parseFloat(b.dataset.productRating || "5");
        const featA = a.dataset.productFeatured === "true" ? 1 : 0;
        const featB = b.dataset.productFeatured === "true" ? 1 : 0;

        switch (currentSort) {
          case "price-asc":
            return priceA - priceB;
          case "price-desc":
            return priceB - priceA;
          case "name-asc":
            return nameA.localeCompare(nameB);
          case "rating":
            return ratingB - ratingA;
          case "featured":
          default:
            return featB - featA;
        }
      });

      cards.forEach((c) => grid.appendChild(c));

      // Update counters
      if (productCountEl) productCountEl.textContent = String(visibleCount);
      if (emptyState) {
        emptyState.classList.toggle("hidden", visibleCount > 0);
      }
    };

    // Category Change (Instant Filter)
    catRadios.forEach((radio) => {
      radio.addEventListener("change", () => {
        if (radio.checked) {
          selectedCategory = radio.value;
          applyFilters();
        }
      });
    });

    // Search Input (Instant Filter)
    searchInput?.addEventListener("input", () => {
      searchQuery = (searchInput.value || "").toLowerCase().trim();
      if (clearSearchBtn) {
        clearSearchBtn.classList.toggle("hidden", !searchQuery);
      }
      applyFilters();
    });

    clearSearchBtn?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      searchQuery = "";
      clearSearchBtn.classList.add("hidden");
      applyFilters();
    });

    // Price Slider (Instant Filter on Drag & Move)
    priceRange?.addEventListener("input", () => {
      maxPrice = Number(priceRange.value);
      if (priceDisplay) priceDisplay.textContent = `Até R$ ${maxPrice},00`;
      applyFilters();
    });

    // Featured Checkbox (Instant Filter)
    filterFeatured?.addEventListener("change", () => {
      onlyFeatured = filterFeatured.checked;
      applyFilters();
    });

    // Sort Dropdown
    sortSelect?.addEventListener("change", () => {
      currentSort = sortSelect.value;
      applyFilters();
    });

    // Reset Filters
    const resetFilters = () => {
      selectedCategory = "all";
      searchQuery = "";
      maxPrice = Number(priceRange?.max || 280);
      onlyFeatured = false;
      currentSort = "featured";

      const allRadio = Array.from(catRadios).find((r) => r.value === "all");
      if (allRadio) allRadio.checked = true;

      if (searchInput) searchInput.value = "";
      if (clearSearchBtn) clearSearchBtn.classList.add("hidden");
      if (priceRange) priceRange.value = String(maxPrice);
      if (priceDisplay) priceDisplay.textContent = `Até R$ ${maxPrice},00`;
      if (filterFeatured) filterFeatured.checked = false;
      if (sortSelect) sortSelect.value = "featured";

      const url = new URL(window.location.href);
      url.search = "";
      window.history.replaceState({}, "", url.toString());

      applyFilters();
    };

    clearFiltersBtn?.addEventListener("click", resetFilters);
    clearFiltersBtn2?.addEventListener("click", resetFilters);
    emptyResetBtn?.addEventListener("click", resetFilters);

    // Mobile Sidebar Drawer Toggle
    const filterSidebar = document.getElementById("filter-sidebar");
    const mobileBackdrop = document.getElementById("mobile-sidebar-backdrop");
    const filterToggleBtn = document.getElementById("filter-toggle-btn");

    const toggleMobileSidebar = (open: boolean) => {
      if (!filterSidebar || !mobileBackdrop) return;
      if (open) {
        filterSidebar.classList.remove("hidden");
        filterSidebar.classList.add("fixed", "top-0", "left-0", "z-50", "h-full", "max-w-[320px]", "w-[85vw]", "bg-[#121010]", "p-6", "overflow-y-auto");
        mobileBackdrop.classList.remove("hidden");
      } else {
        filterSidebar.classList.add("hidden");
        filterSidebar.classList.remove("fixed", "top-0", "left-0", "z-50", "h-full", "max-w-[320px]", "w-[85vw]", "bg-[#121010]", "p-6", "overflow-y-auto");
        mobileBackdrop.classList.add("hidden");
      }
    };

    filterToggleBtn?.addEventListener("click", () => toggleMobileSidebar(true));
    mobileBackdrop?.addEventListener("click", () => toggleMobileSidebar(false));

    // Cart Management
    const cartDrawer = document.getElementById("cart-drawer");
    const floatingCartBtn = document.getElementById("floating-cart-btn");
    const cartDrawerClose = document.getElementById("cart-drawer-close");
    const drawerCountBadge = document.getElementById("drawer-count-badge");
    const floatingCartBadge = document.getElementById("floating-cart-badge");
    const cartDrawerTotal = document.getElementById("cart-drawer-total");
    const cartDrawerItems = document.getElementById("cart-drawer-items");
    const cartCheckoutBtn = document.getElementById("cart-checkout-btn");

    const toggleCartDrawer = (open: boolean) => {
      if (!cartDrawer) return;
      if (open) {
        cartDrawer.classList.remove("translate-x-full");
      } else {
        cartDrawer.classList.add("translate-x-full");
      }
    };

    floatingCartBtn?.addEventListener("click", () => toggleCartDrawer(true));
    cartDrawerClose?.addEventListener("click", () => toggleCartDrawer(false));

    const renderCart = () => {
      const entries = Object.entries(cart)
        .map(([id, qty]) => ({ item: catalog.find((p) => p.id === id), qty }))
        .filter((e): e is { item: Product; qty: number } => Boolean(e.item));

      const totalQty = entries.reduce((s, e) => s + e.qty, 0);
      const totalPrice = entries.reduce((s, e) => s + e.item.price * e.qty, 0);

      if (drawerCountBadge) drawerCountBadge.textContent = String(totalQty);
      if (floatingCartBadge) floatingCartBadge.textContent = String(totalQty);
      if (cartDrawerTotal) cartDrawerTotal.textContent = formatBRL(totalPrice);

      if (cartDrawerItems) {
        if (!entries.length) {
          cartDrawerItems.innerHTML = `
            <div class="text-center py-12 text-[#786e6b]">
              <p class="text-3xl mb-2">🛍️</p>
              <p class="text-xs">Sua sacola de compras está vazia.</p>
            </div>
          `;
        } else {
          cartDrawerItems.innerHTML = entries
            .map(
              (e) => `
              <div class="flex items-center justify-between p-3 rounded-xl bg-[#1c1817] border border-[#2d2422]">
                <div class="min-w-0 pr-2">
                  <h4 class="text-xs font-bold text-white truncate">${e.item.name}</h4>
                  <p class="text-[11px] text-[#a39a97] mt-0.5">${formatBRL(e.item.price)} × ${e.qty}</p>
                </div>
                <button
                  type="button"
                  class="text-xs text-red-400 hover:text-red-300 font-bold shrink-0 p-1"
                  data-remove-cart="${e.item.id}"
                >
                  Remover
                </button>
              </div>
            `
            )
            .join("");
        }
      }

      saveCart(cart);
    };

    // Checkout via WhatsApp
    cartCheckoutBtn?.addEventListener("click", () => {
      const entries = Object.entries(cart)
        .map(([id, qty]) => ({ item: catalog.find((p) => p.id === id), qty }))
        .filter((e): e is { item: Product; qty: number } => Boolean(e.item));

      if (!entries.length) {
        showToast("Sua sacola está vazia.");
        return;
      }

      let msg = `Olá Tchê Empório Gaúcho!\n\nGostaria de fazer o pedido dos seguintes itens da minha sacola:\n\n`;
      let total = 0;
      entries.forEach((e) => {
        const sub = e.item.price * e.qty;
        total += sub;
        msg += `• ${e.qty}x ${e.item.name} (${formatBRL(e.item.price)}) = ${formatBRL(sub)}\n`;
      });
      msg += `\n*Total Estimado: ${formatBRL(total)}*\n\nPoderia me confirmar a disponibilidade e o frete para o meu CEP?`;

      const url = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(msg)}`;
      window.open(url, "_blank");
    });

    // Single item direct order via WhatsApp
    const orderSingleItemWA = (name: string, price: number) => {
      const text = `Olá Tchê Empório Gaúcho!\n\nTenho interesse no produto *${name}* (${formatBRL(price)}).\n\nEstá disponível para envio ou retirada?`;
      const url = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(text)}`;
      window.open(url, "_blank");
    };

    // Wishlist UI sync
    const syncWishlist = () => {
      document.querySelectorAll<HTMLElement>("[data-wish-id]").forEach((btn) => {
        const id = btn.dataset.wishId;
        if (id) {
          btn.setAttribute("aria-pressed", String(wishlist.includes(id)));
        }
      });
    };

    // QuickView Modal
    const modal = document.getElementById("quickview-modal") as HTMLDialogElement;
    const modalContent = document.getElementById("quickview-content");
    const modalClose = document.getElementById("quickview-close-btn");

    const openQuickView = (id: string) => {
      const prod = catalog.find((p) => p.id === id);
      if (!prod || !modal || !modalContent) return;

      modalContent.innerHTML = `
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-center">
          <div class="aspect-square bg-[#1a1716] rounded-2xl p-4 flex items-center justify-center">
            <img src="${prod.image || '/images/shop/cosmic-products.png'}" alt="${prod.name}" class="max-h-full max-w-full object-contain" onerror="this.src='/images/shop/cosmic-products.png'" />
          </div>
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-[#e67e84] block mb-1">${prod.category}</span>
            <h2 class="text-lg sm:text-xl font-bold text-white mb-2 leading-tight">${prod.name}</h2>
            <div class="text-xl font-black text-white mb-3">${formatBRL(prod.price)}</div>
            <p class="text-xs text-[#a39a97] leading-relaxed mb-6">${prod.description}</p>
            <div class="flex gap-2">
              <button
                type="button"
                class="flex-1 py-2.5 rounded-xl bg-[#166534] hover:bg-[#15803d] text-white text-xs font-bold transition flex items-center justify-center gap-1.5"
                data-modal-wa
                data-name="${prod.name}"
                data-price="${prod.price}"
              >
                💬 WhatsApp
              </button>
              <button
                type="button"
                class="flex-1 py-2.5 rounded-xl bg-[#1c1817] hover:bg-[#25201f] border border-[#362e2c] text-white text-xs font-bold transition"
                data-modal-cart
                data-id="${prod.id}"
                data-name="${prod.name}"
              >
                + Sacola
              </button>
            </div>
          </div>
        </div>
      `;
      modal.showModal();
    };

    modalClose?.addEventListener("click", () => modal?.close());
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });

    // Event Delegation
    document.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>(
        "[data-wa-order], [data-add-cart], [data-wish-id], [data-quickview-id], [data-remove-cart], [data-modal-wa], [data-modal-cart]"
      );
      if (!target) return;

      if (target.matches("[data-wa-order]")) {
        const name = target.dataset.name || "Produto";
        const price = parseFloat(target.dataset.price || "0");
        orderSingleItemWA(name, price);
      } else if (target.matches("[data-add-cart]")) {
        const id = target.dataset.id;
        const name = target.dataset.name || "Produto";
        if (id) {
          cart[id] = (cart[id] || 0) + 1;
          renderCart();
          showToast(`${name} adicionado à sacola!`);
        }
      } else if (target.matches("[data-wish-id]")) {
        const id = target.dataset.wishId;
        if (id) {
          const exists = wishlist.includes(id);
          wishlist = exists ? wishlist.filter((item) => item !== id) : [...wishlist, id];
          saveWishlist(wishlist);
          syncWishlist();
          showToast(exists ? "Removido dos favoritos" : "Salvo nos seus favoritos");
        }
      } else if (target.matches("[data-product-link]")) {
        const link = target.dataset.productLink;
        if (link) window.location.href = link;
      } else if (target.matches("[data-remove-cart]")) {
        const id = target.dataset.removeCart;
        if (id && cart[id]) {
          delete cart[id];
          renderCart();
          showToast("Item removido da sacola.");
        }
      } else if (target.matches("[data-modal-wa]")) {
        const name = target.dataset.name || "Produto";
        const price = parseFloat(target.dataset.price || "0");
        orderSingleItemWA(name, price);
      } else if (target.matches("[data-modal-cart]")) {
        const id = target.dataset.id;
        const name = target.dataset.name || "Produto";
        if (id) {
          cart[id] = (cart[id] || 0) + 1;
          renderCart();
          showToast(`${name} adicionado à sacola!`);
        }
      }
    });

    renderCart();
    syncWishlist();
    applyFilters();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCatalog);
  } else {
    initCatalog();
  }
  document.addEventListener("astro:page-load", initCatalog);
</script>
