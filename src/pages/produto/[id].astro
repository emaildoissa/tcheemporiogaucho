---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnnouncementBar from "../../components/AnnouncementBar.astro";
import { products, type Product } from "../../data/products";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

// Related products in the same category
const relatedProducts = products
  .filter((p) => p.category === product.category && p.id !== product.id)
  .slice(0, 4);

const formatBRL = (val: number) => `R$ ${val.toFixed(2).replace(".", ",")}`;
const currentUrl = `https://tcheemporiogaucho.com.br/produto/${product.id}`;
---

<BaseLayout
  title={`${product.name} — Tchê Empório Gaúcho`}
  description={product.description?.slice(0, 160) || `Peça ${product.name} diretamente pelo WhatsApp.`}
>
  <div class="product-detail-page bg-[var(--background)] text-[var(--foreground)] min-h-screen pt-[96px] transition-colors duration-300">
    <AnnouncementBar text="Atendimento e Pedidos Direto no WhatsApp • Entregas para todo o Brasil" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-[var(--commerce-muted)] mb-8" aria-label="Navegação">
        <a href="/" class="hover:text-[var(--commerce-foreground)] transition">Início</a>
        <span class="text-[var(--commerce-border)]">/</span>
        <a href="/catalogo" class="hover:text-[var(--commerce-foreground)] transition">Catálogo</a>
        <span class="text-[var(--commerce-border)]">/</span>
        <a href={`/catalogo?cat=${encodeURIComponent(product.category)}`} class="hover:text-[var(--commerce-foreground)] transition">
          {product.category}
        </a>
        <span class="text-[var(--commerce-border)]">/</span>
        <span class="text-[var(--commerce-foreground)] font-semibold truncate max-w-[200px] sm:max-w-none">{product.name}</span>
      </nav>

      <!-- Grid Principal do Produto: Imagem + Detalhes Técnicos e Ações -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-16">
        <!-- Coluna da Foto -->
        <div class="lg:col-span-6">
          <div class="relative aspect-square sm:aspect-[4/3] lg:aspect-square bg-[var(--commerce-surface)] border border-[var(--commerce-border)] rounded-3xl overflow-hidden p-6 sm:p-10 flex items-center justify-center shadow-xl transition-all duration-300">
            {product.badge && (
              <span class="absolute top-4 left-4 z-10 px-3 py-1 rounded-md bg-[var(--commerce-accent)] text-white text-xs font-black uppercase tracking-wider shadow">
                {product.badge}
              </span>
            )}
            <img
              src={product.image || "/images/shop/cosmic-products.png"}
              alt={product.name}
              class="max-h-full max-w-full object-contain transition-transform duration-500 hover:scale-105"
              onerror="this.src='/images/shop/cosmic-products.png'"
            />
          </div>

          <!-- Selos de Confiança -->
          <div class="grid grid-cols-3 gap-3 mt-4 text-center">
            <div class="p-3.5 rounded-2xl bg-[var(--commerce-surface)] border border-[var(--commerce-border)] shadow-xs">
              <span class="text-[var(--commerce-accent)] flex justify-center mb-1"><svg class="size-4 stroke-current shrink-0 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.24 12.24a6 6 0 00-8.49-8.49L5 10.5V19h8.5zM16 8L2 22M17.5 15H9"/></svg></span>
              <span class="text-[11px] font-bold text-[var(--commerce-foreground)]">100% Colonial</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-[var(--commerce-surface)] border border-[var(--commerce-border)] shadow-xs">
              <span class="text-[var(--commerce-accent)] flex justify-center mb-1"><svg class="size-3.5 stroke-current shrink-0 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21v-7m0 0a5 5 0 005-5V4H7v5a5 5 0 005 5zm-4 7h8"/></svg></span>
              <span class="text-[11px] font-bold text-[var(--commerce-foreground)]">Serra Gaúcha</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-[var(--commerce-surface)] border border-[var(--commerce-border)] shadow-xs">
              <span class="text-[var(--commerce-accent)] flex justify-center mb-1"><svg class="size-3.5 fill-current shrink-0 inline-block mr-1" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg></span>
              <span class="text-[11px] font-bold text-[var(--commerce-foreground)]">Envio Ágil</span>
            </div>
          </div>
        </div>

        <!-- Coluna de Informações e Compra -->
        <div class="lg:col-span-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-4 mb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--commerce-accent)] bg-[var(--commerce-surface-raised)] px-3.5 py-1.5 rounded-full border border-[var(--commerce-border)]">
                {product.category}
              </span>
              <span class="text-xs text-[var(--commerce-muted)]">Cód: #{product.id}</span>
            </div>

            <h1 class="text-2xl sm:text-4xl font-black text-[var(--commerce-foreground)] tracking-tight leading-tight mb-3">
              {product.name}
            </h1>

            <div class="flex items-center gap-3 mb-6">
              <div class="flex text-[var(--commerce-ouro)] text-sm">★★★★★</div>
              <span class="text-xs text-[var(--commerce-muted)]">({product.reviews || 24} avaliações)</span>
              <span class="text-[var(--commerce-border)]">|</span>
              <span class="text-xs text-[#166534] font-bold">✓ Disponível para Envio</span>
            </div>

            <!-- Bloco de Preço -->
            <div class="p-6 rounded-2xl bg-[var(--commerce-surface)] border border-[var(--commerce-border)] shadow-sm mb-6 transition-colors duration-300">
              <div class="text-xs text-[var(--commerce-muted)] uppercase tracking-wider mb-1 font-semibold">Valor Unitário</div>
              <div class="flex items-baseline gap-3">
                <span class="text-3xl sm:text-4xl font-black text-[var(--commerce-foreground)]">
                  R$ {product.price.toFixed(2).replace(".", ",")}
                </span>
                <span class="text-xs text-[var(--commerce-muted)]">à vista ou via PIX</span>
              </div>
            </div>

            <!-- Descrição Completa -->
            <div class="space-y-3 mb-8">
              <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--commerce-foreground)]">Sobre este Produto</h2>
              <div class="p-5 rounded-2xl bg-[var(--commerce-surface-raised)] border border-[var(--commerce-border)] text-sm sm:text-base text-[var(--commerce-foreground)] leading-relaxed whitespace-pre-line">
                {product.description}
              </div>
            </div>

            <!-- Botões de Ação Híbridos (Pedido Imediato ou Sacola) -->
            <div class="space-y-3 pt-6 border-t border-[var(--commerce-border)]">
              <button
                type="button"
                id="btn-order-single-wa"
                class="w-full py-4 px-6 rounded-2xl bg-[#166534] hover:bg-[#15803d] text-white font-extrabold text-sm sm:text-base transition shadow-xl flex items-center justify-center gap-3 cursor-pointer"
                data-name={product.name}
                data-price={product.price}
                data-id={product.id}
              >
                <svg class="size-3.5 fill-current shrink-0 inline-block mr-1" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                <span>Pedir Agora pelo WhatsApp</span>
              </button>

              <div class="grid grid-cols-2 gap-3">
                <button
                  type="button"
                  id="btn-add-to-cart-page"
                  class="py-3.5 px-4 rounded-xl bg-[var(--commerce-surface-raised)] hover:bg-[var(--commerce-surface)] border border-[var(--commerce-border)] hover:border-[var(--commerce-accent)] text-[var(--commerce-foreground)] font-bold text-xs sm:text-sm transition flex items-center justify-center gap-2 cursor-pointer shadow-xs"
                  data-name={product.name}
                  data-price={product.price}
                  data-id={product.id}
                >
                  <svg class="size-4 stroke-current shrink-0 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                  <span>+ Adicionar à Sacola</span>
                </button>

                <button
                  type="button"
                  id="btn-share-product"
                  class="py-3.5 px-4 rounded-xl bg-[var(--commerce-surface)] hover:bg-[var(--commerce-surface-raised)] border border-[var(--commerce-border)] text-[var(--commerce-muted)] hover:text-[var(--commerce-foreground)] font-semibold text-xs sm:text-sm transition flex items-center justify-center gap-2 cursor-pointer shadow-xs"
                >
                  <svg class="size-4 stroke-current inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
                  <span>Compartilhar</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Produtos Relacionados -->
      {relatedProducts.length > 0 && (
        <section class="border-t border-[var(--commerce-border)] pt-12">
          <div class="flex items-center justify-between mb-8">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--commerce-accent)]">Sugestões Coloniais</span>
              <h2 class="text-xl sm:text-2xl font-black text-[var(--commerce-foreground)] mt-1">Outros produtos em {product.category}</h2>
            </div>
            <a href={`/catalogo?cat=${encodeURIComponent(product.category)}`} class="text-xs text-[var(--commerce-muted)] hover:text-[var(--commerce-accent)] font-semibold transition">
              Ver categoria completa →
            </a>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
            {relatedProducts.map((rel) => (
              <a
                href={`/produto/${rel.id}`}
                class="group bg-[var(--commerce-surface)] border border-[var(--commerce-border)] hover:border-[var(--commerce-accent)] rounded-2xl p-4 transition-all duration-300 hover:-translate-y-1 block shadow-sm hover:shadow-xl"
              >
                <div class="aspect-square bg-[var(--commerce-surface-raised)] rounded-xl p-3 flex items-center justify-center overflow-hidden mb-3">
                  <img
                    src={rel.image || "/images/shop/cosmic-products.png"}
                    alt={rel.name}
                    class="max-h-full max-w-full object-contain group-hover:scale-105 transition duration-300"
                    onerror="this.src='/images/shop/cosmic-products.png'"
                  />
                </div>
                <h3 class="text-xs sm:text-sm font-semibold text-[var(--commerce-foreground)] line-clamp-2 group-hover:text-[var(--commerce-accent)] transition mb-2">
                  {rel.name}
                </h3>
                <div class="text-sm font-bold text-[var(--commerce-foreground)]">
                  R$ {rel.price.toFixed(2).replace(".", ",")}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- Sacola Drawer Lateral -->
    <aside
      id="product-cart-drawer"
      class="fixed top-0 right-0 w-full sm:w-[380px] h-screen bg-[var(--commerce-surface)] text-[var(--commerce-foreground)] border-l border-[var(--commerce-border)] z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col p-6 shadow-2xl"
    >
      <header class="flex items-center justify-between pb-4 border-b border-[var(--commerce-border)]">
        <div class="flex items-center gap-2">
          <svg class="size-4 stroke-current shrink-0 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <h2 class="text-base font-bold text-[var(--commerce-foreground)]">Sua Sacola</h2>
          <span id="page-cart-count-badge" class="px-2 py-0.5 rounded-full text-xs font-extrabold bg-[var(--commerce-accent)] text-white">0</span>
        </div>
        <button type="button" id="page-cart-drawer-close" class="text-[var(--commerce-muted)] hover:text-[var(--commerce-foreground)] text-xl cursor-pointer">✕</button>
      </header>

      <div class="flex-1 overflow-y-auto py-4 space-y-3" id="page-cart-drawer-items"></div>

      <footer class="pt-4 border-t border-[var(--commerce-border)] space-y-3">
        <div class="flex items-center justify-between text-sm">
          <span class="text-[var(--commerce-muted)]">Subtotal</span>
          <strong id="page-cart-drawer-total" class="text-lg font-black text-[var(--commerce-foreground)]">R$ 0,00</strong>
        </div>
        <button
          type="button"
          id="page-cart-checkout-btn"
          class="w-full py-3.5 rounded-xl bg-[#166534] hover:bg-[#15803d] text-white text-xs sm:text-sm font-bold transition flex items-center justify-center gap-2 shadow-lg cursor-pointer"
        >
          <svg class="size-3.5 fill-current shrink-0 inline-block mr-1" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg><span>Finalizar Pedido via WhatsApp</span>
        </button>
      </footer>
    </aside>

    <!-- Botão Flutuante de Sacola -->
    <button
      type="button"
      id="page-floating-cart-btn"
      class="fixed bottom-6 right-6 z-40 flex items-center gap-2.5 px-5 py-3 rounded-full bg-[var(--commerce-accent)] hover:opacity-90 text-white font-bold text-xs sm:text-sm shadow-2xl hover:scale-105 transition cursor-pointer"
      aria-label="Abrir Sacola"
    >
      <svg class="size-4 stroke-current shrink-0 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg><span>Sacola</span>
      <span id="page-floating-cart-badge" class="px-2 py-0.5 rounded-full bg-white text-[var(--commerce-accent)] font-black text-xs">0</span>
    </button>

    <!-- Toast de Notificações -->
    <div
      id="page-toast"
      class="fixed bottom-8 left-1/2 -translate-x-1/2 translate-y-10 opacity-0 pointer-events-none transition-all duration-300 z-50 px-5 py-2.5 rounded-full bg-[var(--commerce-surface)] text-[var(--commerce-foreground)] border border-[var(--commerce-accent)] text-xs font-bold shadow-2xl"
    ></div>

    <!-- Catálogo de fallback embutido -->
    <script type="application/json" id="embedded-product-catalog" set:html={JSON.stringify(products)} />
  </div>
</BaseLayout>

<style>
  #page-toast.toast-active {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>

<script>
  import { loadCart, saveCart, loadCatalogFromStorage } from "../../lib/storefrontStorage";
  import type { Product } from "../../data/products";

  const WHATSAPP_PHONE = "5551993257923";

  function initProductPage() {
    const embeddedCatalogEl = document.getElementById("embedded-product-catalog");
    const defaultCatalog: Product[] = JSON.parse(embeddedCatalogEl?.textContent || "[]");
    const customCatalog = loadCatalogFromStorage<Product>();
    const catalog: Product[] = customCatalog || defaultCatalog;

    const cart = loadCart(catalog.map((p) => p.id));
    const formatBRL = (val: number) => `R$ ${val.toFixed(2).replace(".", ",")}`;

    const toast = document.getElementById("page-toast");
    let toastTimeout = 0;
    const showToast = (text: string) => {
      if (!toast) return;
      toast.textContent = text;
      toast.classList.add("toast-active");
      clearTimeout(toastTimeout);
      toastTimeout = window.setTimeout(() => toast.classList.remove("toast-active"), 2200);
    };

    // Cart Drawer Elements
    const cartDrawer = document.getElementById("product-cart-drawer");
    const floatingCartBtn = document.getElementById("page-floating-cart-btn");
    const cartDrawerClose = document.getElementById("page-cart-drawer-close");
    const countBadge = document.getElementById("page-cart-count-badge");
    const floatingCountBadge = document.getElementById("page-floating-cart-badge");
    const drawerTotal = document.getElementById("page-cart-drawer-total");
    const drawerItems = document.getElementById("page-cart-drawer-items");
    const checkoutBtn = document.getElementById("page-cart-checkout-btn");

    const toggleCart = (open: boolean) => {
      if (!cartDrawer) return;
      if (open) {
        cartDrawer.classList.remove("translate-x-full");
      } else {
        cartDrawer.classList.add("translate-x-full");
      }
    };

    floatingCartBtn?.addEventListener("click", () => toggleCart(true));
    cartDrawerClose?.addEventListener("click", () => toggleCart(false));

    const renderCart = () => {
      const entries = Object.entries(cart)
        .map(([id, qty]) => ({ item: catalog.find((p) => p.id === id), qty }))
        .filter((e): e is { item: Product; qty: number } => Boolean(e.item));

      const totalQty = entries.reduce((s, e) => s + e.qty, 0);
      const totalPrice = entries.reduce((s, e) => s + e.item.price * e.qty, 0);

      if (countBadge) countBadge.textContent = String(totalQty);
      if (floatingCountBadge) floatingCountBadge.textContent = String(totalQty);
      if (drawerTotal) drawerTotal.textContent = formatBRL(totalPrice);

      if (drawerItems) {
        if (!entries.length) {
          drawerItems.innerHTML = `
            <div class="text-center py-12 text-[var(--commerce-muted)]">
              <p class="mb-2 text-[var(--commerce-muted)] flex justify-center"><svg class="size-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg></p>
              <p class="text-xs">Sua sacola de compras está vazia.</p>
            </div>
          `;
        } else {
          drawerItems.innerHTML = entries
            .map(
              (e) => `
              <div class="flex items-center justify-between p-3 rounded-xl bg-[var(--commerce-surface-raised)] border border-[var(--commerce-border)]">
                <div class="min-w-0 pr-2">
                  <h4 class="text-xs font-bold text-[var(--commerce-foreground)] truncate">${e.item.name}</h4>
                  <p class="text-[11px] text-[var(--commerce-muted)] mt-0.5">${formatBRL(e.item.price)} × ${e.qty}</p>
                </div>
                <button
                  type="button"
                  class="text-xs text-red-400 hover:text-red-300 font-bold shrink-0 p-1"
                  data-remove-cart="${e.item.id}"
                >
                  Remover
                </button>
              </div>
            `
            )
            .join("");
        }
      }

      saveCart(cart);
    };

    // Add to Cart Button
    const addBtn = document.getElementById("btn-add-to-cart-page");
    addBtn?.addEventListener("click", () => {
      const id = addBtn.getAttribute("data-id");
      const name = addBtn.getAttribute("data-name") || "Produto";
      if (id) {
        cart[id] = (cart[id] || 0) + 1;
        renderCart();
        showToast(`+1 "${name}" adicionado à sacola!`);
      }
    });

    // Single item direct order via WhatsApp
    const singleWaBtn = document.getElementById("btn-order-single-wa");
    singleWaBtn?.addEventListener("click", () => {
      const name = singleWaBtn.getAttribute("data-name") || "";
      const price = parseFloat(singleWaBtn.getAttribute("data-price") || "0");
      const text = `Olá Tchê Empório Gaúcho!\n\nTenho interesse no produto *${name}* (${formatBRL(price)}).\n\nLink do item: ${window.location.href}\n\nPoderia me confirmar a disponibilidade e o valor do frete?`;
      const url = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(text)}`;
      window.open(url, "_blank");
    });

    // Share Button
    const shareBtn = document.getElementById("btn-share-product");
    shareBtn?.addEventListener("click", async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: document.title,
            text: `Confira este produto colonial no Tchê Empório Gaúcho:`,
            url: window.location.href,
          });
        } catch {
          // cancelled or failed
        }
      } else {
        await navigator.clipboard.writeText(window.location.href);
        showToast("Link copiado para a área de transferência!");
      }
    });

    // Cart remove delegation
    drawerItems?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const removeBtn = target.closest<HTMLButtonElement>("[data-remove-cart]");
      if (removeBtn) {
        const id = removeBtn.dataset.removeCart;
        if (id && cart[id]) {
          delete cart[id];
          renderCart();
          showToast("Item removido da sacola.");
        }
      }
    });

    // Checkout via WhatsApp
    checkoutBtn?.addEventListener("click", () => {
      const entries = Object.entries(cart)
        .map(([id, qty]) => ({ item: catalog.find((p) => p.id === id), qty }))
        .filter((e): e is { item: Product; qty: number } => Boolean(e.item));

      if (!entries.length) {
        showToast("Sua sacola está vazia.");
        return;
      }

      let msg = `Olá Tchê Empório Gaúcho!\n\nGostaria de fechar o pedido dos seguintes itens da minha sacola:\n\n`;
      let total = 0;
      entries.forEach((e) => {
        const sub = e.item.price * e.qty;
        total += sub;
        msg += `• ${e.qty}x ${e.item.name} (${formatBRL(e.item.price)}) = ${formatBRL(sub)}\n`;
      });
      msg += `\n*Total Estimado: ${formatBRL(total)}*\n\nPoderia me informar as opções de pagamento e o frete para o meu CEP?`;

      const url = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(msg)}`;
      window.open(url, "_blank");
    });

    renderCart();
  }

  initProductPage();
  document.addEventListener("astro:page-load", initProductPage);
</script>
