---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import { products as defaultProducts } from "../data/products";

// Server-side category calculation
const categoriesList = Array.from(
  new Set(defaultProducts.map((p) => p.category).filter(Boolean))
).sort((a, b) => {
  const countA = defaultProducts.filter((p) => p.category === a).length;
  const countB = defaultProducts.filter((p) => p.category === b).length;
  return countB - countA;
});

const categoryCounts = defaultProducts.reduce((acc, p) => {
  acc[p.category] = (acc[p.category] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const maxPrice = Math.ceil(
  Math.max(...defaultProducts.map((p) => p.price || 0))
);
---

<BaseLayout
  title="Catálogo Geral — Tchê Empório Gaúcho"
  description="Navegue por mais de 220 produtos coloniais e artesanais gaúchos: vinhos finos, queijos, chimias e embutidos. Filtros laterais em tempo real e pedido via WhatsApp."
>
  <div class="shop-all-page bg-[var(--background)] text-[var(--foreground)] min-h-screen pt-[96px] transition-colors duration-300">
    <AnnouncementBar text="Catálogo Completo • Peça diretamente pelo WhatsApp: (51) 99325-7923 • Entregas para todo o Brasil" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-[var(--commerce-muted)] mb-6" aria-label="Navegação Estrutural">
        <a href="/" class="hover:text-[var(--commerce-foreground)] transition-colors">Início</a>
        <span class="text-[var(--commerce-border)]">/</span>
        <span class="text-[var(--commerce-foreground)] font-semibold">Catálogo Geral</span>
      </nav>

      <!-- Banner de Coleção -->
      <section class="shop-collection-banner relative overflow-hidden rounded-3xl border border-[var(--commerce-border)] bg-[var(--commerce-banner-gradient)] p-6 sm:p-9 mb-8 shadow-xl transition-all duration-300">
        <div class="relative z-10 max-w-2xl">
          <p class="text-xs font-bold uppercase tracking-[.2em] text-[var(--commerce-accent)] flex items-center gap-2">
            Tradição & Sabor Colonial Gaúcho
          </p>
          <h1 class="mt-3 text-3xl sm:text-5xl font-black text-[var(--commerce-foreground)] tracking-tight leading-tight">
            O Autêntico Sabor do Rio Grande
          </h1>
          <p class="mt-3 text-sm text-[var(--commerce-muted)] leading-relaxed">
            Vinhos finos da Serra, chimias artesanais, embutidos coloniais, queijos, mel puro e compotas das melhores cooperativas e famílias do Sul.
          </p>
          <div class="mt-6 flex flex-wrap gap-2.5 text-xs font-semibold text-[var(--commerce-foreground)]">
            <span class="rounded-full bg-[var(--commerce-surface)] border border-[var(--commerce-border)] px-3.5 py-1.5 flex items-center gap-1.5 shadow-xs">
              <svg class="size-3.5 stroke-current shrink-0 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg> 228 produtos no catálogo
            </span>
            <span class="rounded-full bg-[var(--commerce-surface)] border border-[var(--commerce-border)] px-3.5 py-1.5 flex items-center gap-1.5 shadow-xs">
              <svg class="size-3.5 fill-current shrink-0 inline-block mr-1" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg> Atendimento direto no WhatsApp
            </span>
            <span class="rounded-full bg-[var(--commerce-surface)] border border-[var(--commerce-border)] px-3.5 py-1.5 flex items-center gap-1.5 shadow-xs">
              <svg class="size-3.5 stroke-current shrink-0 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg> 100% Colonial & Artesanal
            </span>
          </div>
        </div>
        <div class="shop-banner-orb absolute -right-12 -top-12 h-72 w-72 rounded-full bg-[var(--commerce-accent)]/15 blur-3xl pointer-events-none"></div>
      </section>

      <!-- Top Toolbar (Título, Contador, Busca, Ordenação, Botão Mobile) -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-8 pb-4 border-b border-[var(--commerce-border)]">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--commerce-foreground)] tracking-tight">Todos os Produtos</h2>
          <p class="text-xs sm:text-sm text-[var(--commerce-muted)] mt-1">
            Mostrando <span id="product-count" class="font-bold text-[var(--commerce-foreground)]">{defaultProducts.length}</span> itens
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <!-- Campo de Busca -->
          <div class="relative min-w-[200px] sm:w-64">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[var(--commerce-muted)] text-sm">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </span>
            <input
              id="product-search"
              type="search"
              placeholder="Buscar produtos..."
              class="w-full rounded-xl border border-[var(--commerce-border)] bg-[var(--commerce-surface)] pl-9 pr-8 py-2 text-xs sm:text-sm text-[var(--commerce-foreground)] placeholder-[var(--commerce-muted)] focus:outline-none focus:border-[var(--commerce-accent)] shadow-xs transition"
              autocomplete="off"
            />
            <button
              type="button"
              id="clear-search-btn"
              class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-xs text-[var(--commerce-muted)] hover:text-[var(--commerce-foreground)] hidden"
              title="Limpar busca"
            >
              ✕
            </button>
          </div>

          <!-- Select de Ordenação -->
          <div>
            <select
              id="sort-products"
              class="rounded-xl border border-[var(--commerce-border)] bg-[var(--commerce-surface)] px-3 py-2 text-xs sm:text-sm text-[var(--commerce-foreground)] focus:outline-none focus:border-[var(--commerce-accent)] shadow-xs transition cursor-pointer"
            >
              <option value="featured">Destaques</option>
              <option value="price-asc">Menor Preço</option>
              <option value="price-desc">Maior Preço</option>
              <option value="name-asc">Nome (A - Z)</option>
              <option value="rating">Mais Bem Avaliados</option>
            </select>
          </div>

          <!-- Botão Filtros para Mobile -->
          <button
            type="button"
            id="filter-toggle-btn"
            class="lg:hidden inline-flex items-center gap-2 rounded-xl border border-[var(--commerce-border)] bg-[var(--commerce-surface)] px-3.5 py-2 text-xs font-bold text-[var(--commerce-foreground)] hover:border-[var(--commerce-accent)] shadow-xs transition"
          >
            <svg class="size-3.5 stroke-current shrink-0 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg><span>Filtros</span>
            <span id="mobile-filter-badge" class="hidden px-2 py-0.5 rounded-full text-[10px] bg-[var(--commerce-accent)] text-white font-extrabold">0</span>
          </button>
        </div>
      </div>

      <!-- Layout 2 Colunas: Barra Lateral Fixa + Grid Central de Produtos -->
      <div class="flex gap-8 items-start relative">
        <!-- BARRA LATERAL FIXA SEM ITENS (Apenas Controles de Filtros) -->
        <aside
          id="filter-sidebar"
          class="shop-sidebar w-64 shrink-0 hidden lg:block"
          aria-label="Filtros do Catálogo"
        >
          <div class="sticky top-24 space-y-6 bg-[var(--commerce-surface)] border border-[var(--commerce-border)] p-5 rounded-2xl shadow-lg transition-colors duration-300">
            <!-- Cabeçalho do Filtro -->
            <div class="flex items-center justify-between pb-3 border-b border-[var(--commerce-border)]">
              <div class="flex items-center gap-2">
                <svg class="size-3.5 stroke-current shrink-0 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                <h3 class="font-bold text-xs uppercase tracking-wider text-[var(--commerce-foreground)]">Filtros</h3>
              </div>
              <button
                type="button"
                id="clear-all-filters-btn"
                class="text-xs text-[var(--commerce-accent)] hover:underline font-semibold transition"
              >
                Limpar Todos
              </button>
            </div>

            <!-- Categorias (com Radio Inputs e Contagem de Produtos) -->
            <div>
              <h4 class="font-bold text-xs uppercase tracking-wider text-[var(--commerce-muted)] mb-3">
                Categorias
              </h4>
              <div class="space-y-1.5 max-h-[340px] overflow-y-auto pr-1 custom-scrollbar" id="categories-container">
                <label class="flex items-center justify-between gap-2 cursor-pointer group py-1.5 px-2 rounded-lg hover:bg-[var(--commerce-surface-raised)] transition">
                  <div class="flex items-center gap-2 min-w-0">
                    <input
                      type="radio"
                      name="filter-category"
                      value="all"
                      class="filter-cat-radio accent-[var(--commerce-accent)] cursor-pointer"
                      checked
                    />
                    <span class="text-xs sm:text-sm text-[var(--commerce-foreground)] group-hover:text-[var(--commerce-accent)] transition truncate">
                      Todas as Categorias
                    </span>
                  </div>
                  <span class="text-[11px] text-[var(--commerce-muted)] group-hover:text-[var(--commerce-foreground)] bg-[var(--commerce-surface-raised)] px-2 py-0.5 rounded-full font-medium shrink-0">
                    {defaultProducts.length}
                  </span>
                </label>

                {
                  categoriesList.map((cat) => (
                    <label class="flex items-center justify-between gap-2 cursor-pointer group py-1.5 px-2 rounded-lg hover:bg-[var(--commerce-surface-raised)] transition">
                      <div class="flex items-center gap-2 min-w-0">
                        <input
                          type="radio"
                          name="filter-category"
                          value={cat}
                          class="filter-cat-radio accent-[var(--commerce-accent)] cursor-pointer"
                        />
                        <span class="text-xs sm:text-sm text-[var(--commerce-foreground)] group-hover:text-[var(--commerce-accent)] transition truncate" title={cat}>
                          {cat}
                        </span>
                      </div>
                      <span class="text-[11px] text-[var(--commerce-muted)] group-hover:text-[var(--commerce-foreground)] bg-[var(--commerce-surface-raised)] px-2 py-0.5 rounded-full font-medium shrink-0">
                        {categoryCounts[cat] || 0}
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>

            <!-- Faixa de Preço (Slider e Display Dinâmico) -->
            <div class="border-t border-[var(--commerce-border)] pt-4">
              <div class="flex items-center justify-between mb-2">
                <h4 class="font-bold text-xs uppercase tracking-wider text-[var(--commerce-muted)]">
                  Faixa de Preço
                </h4>
                <span id="price-display" class="text-xs font-bold text-[var(--commerce-ouro)]">
                  Até R$ {maxPrice},00
                </span>
              </div>
              <input
                type="range"
                id="price-range"
                min="0"
                max={maxPrice}
                value={maxPrice}
                step="5"
                class="w-full accent-[var(--commerce-accent)] cursor-pointer"
              />
              <div class="flex justify-between text-[11px] text-[var(--commerce-muted)] mt-1">
                <span>R$ 0</span>
                <span>R$ {maxPrice}</span>
              </div>
            </div>

            <!-- Filtro Rápido: Mais Vendidos -->
            <div class="border-t border-[var(--commerce-border)] pt-4">
              <h4 class="font-bold text-xs uppercase tracking-wider text-[var(--commerce-muted)] mb-2.5">
                Filtros Especiais
              </h4>
              <label class="flex items-center gap-2.5 cursor-pointer group py-1">
                <input
                  type="checkbox"
                  id="filter-featured"
                  class="accent-[var(--commerce-accent)] rounded cursor-pointer w-4 h-4"
                />
                <span class="text-xs sm:text-sm text-[var(--commerce-foreground)] group-hover:text-[var(--commerce-accent)] transition">
                  Apenas Mais Vendidos / Selos
                </span>
              </label>
            </div>

            <!-- Botão Limpar Filtros no Rodapé da Barra -->
            <button
              type="button"
              id="clear-filters-btn-secondary"
              class="w-full py-2.5 rounded-xl border border-[var(--commerce-border)] bg-[var(--commerce-surface-raised)] hover:bg-[var(--commerce-surface)] text-xs font-bold text-[var(--commerce-muted)] hover:text-[var(--commerce-foreground)] transition shadow-xs"
            >
              Limpar Todos os Filtros
            </button>
          </div>
        </aside>

        <!-- Backdrop Mobile para Sidebar -->
        <div id="mobile-sidebar-backdrop" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-40 hidden lg:hidden"></div>

        <!-- ÁREA CENTRAL COM OS ITENS CONFORME FILTRADOS -->
        <main class="flex-1 min-w-0" id="main-catalog-content">
          <!-- Grid de Produtos -->
          <div
            id="products-grid"
            class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-3 gap-4 sm:gap-6"
          >
            {
              defaultProducts.map((product) => (
                <article
                  class="product-card group relative bg-[var(--commerce-surface)] rounded-2xl overflow-hidden border border-[var(--commerce-border)] hover:border-[var(--commerce-accent)] transition-all duration-300 flex flex-col justify-between shadow-sm hover:shadow-xl hover:-translate-y-1"
                  data-product-id={product.id}
                  data-product-name={product.name.toLowerCase()}
                  data-product-category={product.category}
                  data-product-price={product.price}
                  data-product-rating={product.rating || 5}
                  data-product-featured={product.featured ? "true" : "false"}
                >
                  <!-- Selo Superior -->
                  {product.badge && (
                    <span class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-md bg-[var(--commerce-accent)] text-white text-[10px] font-black uppercase tracking-wider shadow">
                      {product.badge}
                    </span>
                  )}

                  <!-- Botão Favoritos -->
                  <button
                    type="button"
                    class="wish-btn absolute top-3 right-3 z-10 p-2 rounded-full bg-black/30 backdrop-blur text-gray-300 hover:text-white hover:bg-black/60 transition"
                    aria-label={`Salvar ${product.name}`}
                    data-wish-id={product.id}
                  >
                    <svg height="16" width="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.7-7.5a5.5 5.5 0 0 0 1.1-8.9Z" />
                    </svg>
                  </button>

                  <!-- Imagem do Produto -->
                  <div
                    class="relative aspect-[4/3] bg-[var(--commerce-surface-raised)] overflow-hidden flex items-center justify-center p-3 cursor-pointer"
                    data-product-link={`/produto/${product.id}`}
                  >
                    <img
                      src={product.image || "/images/shop/cosmic-products.png"}
                      alt={product.name}
                      loading="lazy"
                      class="max-h-full max-w-full object-contain transition-transform duration-500 group-hover:scale-105"
                      onerror="this.src='/images/shop/cosmic-products.png'"
                    />
                  </div>

                  <!-- Detalhes do Produto -->
                  <div class="p-4 flex flex-col flex-grow justify-between">
                    <div>
                      <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--commerce-accent)] block mb-1">
                        {product.category}
                      </span>
                      <h3
                        class="font-semibold text-xs sm:text-sm text-[var(--commerce-foreground)] line-clamp-2 group-hover:text-[var(--commerce-accent)] transition-colors leading-snug cursor-pointer"
                        data-product-link={`/produto/${product.id}`}
                        title={product.name}
                      >
                        {product.name}
                      </h3>
                      <div class="flex items-center gap-1.5 mt-2 text-xs">
                        <span class="text-[var(--commerce-ouro)] text-[11px]">★★★★★</span>
                        <span class="text-[var(--commerce-muted)] text-[11px]">({product.reviews || 18})</span>
                      </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-[var(--commerce-border)]">
                      <div class="mb-3">
                        <span class="text-base sm:text-lg font-black text-[var(--commerce-foreground)]">
                          R$ {product.price.toFixed(2).replace(".", ",")}
                        </span>
                      </div>

                      <div class="grid grid-cols-2 gap-2">
                        <button
                          type="button"
                          class="btn-order-wa flex items-center justify-center gap-1.5 py-2 px-2.5 rounded-xl bg-[#166534] hover:bg-[#15803d] text-white text-[11px] font-bold transition shadow-sm"
                          data-wa-order
                          data-id={product.id}
                          data-name={product.name}
                          data-price={product.price}
                          title="Fazer pedido direto no WhatsApp"
                        >
                          <svg class="size-3.5 fill-current shrink-0 inline-block mr-1" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg><span>WhatsApp</span>
                        </button>
                        <button
                          type="button"
                          class="btn-add-cart flex items-center justify-center gap-1 py-2 px-2.5 rounded-xl bg-[var(--commerce-surface-raised)] hover:bg-[var(--commerce-surface)] border border-[var(--commerce-border)] hover:border-[var(--commerce-accent)] text-[var(--commerce-foreground)] text-[11px] font-bold transition"
                          data-add-cart
                          data-id={product.id}
                          data-name={product.name}
                          data-price={product.price}
                          title="Adicionar à sacola de compras"
                        >
                          <span>+ Sacola</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <!-- Empty State (Sem Produtos Correspondentes) -->
          <div
            id="empty-state"
            class="hidden text-center py-20 px-4 bg-[var(--commerce-surface)] border border-dashed border-[var(--commerce-border)] rounded-3xl"
          >
            <div class="mb-4 text-[var(--commerce-muted)] flex justify-center"><svg class="size-16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg></div>
            <h3 class="text-xl font-bold text-[var(--commerce-foreground)] mb-2">Nenhum produto encontrado</h3>
            <p class="text-sm text-[var(--commerce-muted)] max-w-md mx-auto mb-6">
              Não encontramos nenhum item correspondente aos filtros selecionados. Tente ajustar os critérios ou limpar os filtros.
            </p>
            <button
              type="button"
              id="empty-reset-btn"
              class="px-5 py-2.5 rounded-xl bg-[var(--commerce-accent)] hover:opacity-90 text-white text-xs font-bold transition shadow-lg"
            >
              Ver Todos os Produtos
            </button>
          </div>
        </main>
      </div>
    </div>

    <!-- Modal Detalhes do Produto (QuickView) -->
    <dialog
      id="quickview-modal"
      class="rounded-3xl bg-[var(--commerce-surface)] text-[var(--commerce-foreground)] border border-[var(--commerce-border)] p-6 sm:p-8 max-w-xl w-[92vw] shadow-2xl backdrop:bg-black/80 backdrop:backdrop-blur-sm"
    >
      <button
        type="button"
        id="quickview-close-btn"
        class="absolute top-4 right-5 text-[var(--commerce-muted)] hover:text-[var(--commerce-foreground)] text-xl"
        aria-label="Fechar"
      >
        ✕
      </button>
      <div id="quickview-content"></div>
    </dialog>

    <!-- Sacola Drawer Lateral -->
    <aside
      id="cart-drawer"
      class="fixed top-0 right-0 w-full sm:w-[380px] h-screen bg-[var(--commerce-surface)] text-[var(--commerce-foreground)] border-l border-[var(--commerce-border)] z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col p-6 shadow-2xl"
    >
      <header class="flex items-center justify-between pb-4 border-b border-[var(--commerce-border)]">
        <div class="flex items-center gap-2">
          <svg class="size-4 stroke-current shrink-0 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <h2 class="text-base font-bold text-[var(--commerce-foreground)]">Sua Sacola</h2>
          <span id="drawer-count-badge" class="px-2 py-0.5 rounded-full text-xs font-extrabold bg-[var(--commerce-accent)] text-white">0</span>
        </div>
        <button type="button" id="cart-drawer-close" class="text-[var(--commerce-muted)] hover:text-[var(--commerce-foreground)] text-xl">✕</button>
      </header>

      <div class="flex-1 overflow-y-auto py-4 space-y-3 custom-scrollbar" id="cart-drawer-items"></div>

      <footer class="pt-4 border-t border-[var(--commerce-border)] space-y-3">
        <div class="flex items-center justify-between text-sm">
          <span class="text-[var(--commerce-muted)]">Subtotal</span>
          <strong id="cart-drawer-total" class="text-lg font-black text-[var(--commerce-foreground)]">R$ 0,00</strong>
        </div>
        <button
          type="button"
          id="cart-checkout-btn"
          class="w-full py-3.5 rounded-xl bg-[#166534] hover:bg-[#15803d] text-white text-xs sm:text-sm font-bold transition flex items-center justify-center gap-2 shadow-lg"
        >
          <svg class="size-3.5 fill-current shrink-0 inline-block mr-1" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg><span>Finalizar Pedido via WhatsApp</span>
        </button>
      </footer>
    </aside>

    <!-- Botão Flutuante de Sacola -->
    <button
      type="button"
      id="floating-cart-btn"
      class="fixed bottom-6 right-6 z-40 flex items-center gap-2.5 px-5 py-3 rounded-full bg-[var(--commerce-accent)] hover:opacity-90 text-white font-bold text-xs sm:text-sm shadow-2xl hover:scale-105 transition"
      aria-label="Abrir Sacola"
    >
      <svg class="size-4 stroke-current shrink-0 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg><span>Sacola</span>
      <span id="floating-cart-badge" class="px-2 py-0.5 rounded-full bg-white text-[var(--commerce-accent)] font-black text-xs">0</span>
    </button>

    <!-- Toast de Notificações -->
    <div
      id="shop-toast"
      class="fixed bottom-8 left-1/2 -translate-x-1/2 translate-y-10 opacity-0 pointer-events-none transition-all duration-300 z-50 px-5 py-2.5 rounded-full bg-[var(--commerce-surface)] text-[var(--commerce-foreground)] border border-[var(--commerce-accent)] text-xs font-bold shadow-2xl"
    ></div>

    <!-- Catálogo de fallback embutido -->
    <script type="application/json" id="embedded-catalog" set:html={JSON.stringify(defaultProducts)} />
  </div>
</BaseLayout>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: var(--commerce-border);
    border-radius: 9999px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  /* Animações e transições nos cards */
  .product-card {
    will-change: transform, opacity;
  }

  .wish-btn[aria-pressed="true"] svg {
    fill: var(--commerce-accent);
    color: var(--commerce-accent);
  }

  /* Estado visível do Toast */
  #shop-toast.toast-active {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>

<script>
  import {
    loadCart,
    saveCart,
    loadWishlist,
    saveWishlist,
    loadCatalogFromStorage,
  } from "../lib/storefrontStorage";
  import type { Product } from "../data/products";

  const WHATSAPP_PHONE = "5551993257923";

  function initCatalog() {
    const embeddedCatalogEl = document.getElementById("embedded-catalog");
    const defaultCatalog: Product[] = JSON.parse(embeddedCatalogEl?.textContent || "[]");
    const customCatalog = loadCatalogFromStorage<Product>();
    const catalog: Product[] = customCatalog || defaultCatalog;

    const cart = loadCart(catalog.map((p) => p.id));
    let wishlist = loadWishlist();

    const formatBRL = (val: number) => `R$ ${val.toFixed(2).replace(".", ",")}`;

    const toast = document.getElementById("shop-toast");
    let toastTimeout = 0;
    const showToast = (text: string) => {
      if (!toast) return;
      toast.textContent = text;
      toast.classList.add("toast-active");
      clearTimeout(toastTimeout);
      toastTimeout = window.setTimeout(() => toast.classList.remove("toast-active"), 2200);
    };

    // DOM Elements - Filtering & Sorting
    const grid = document.getElementById("products-grid");
    const emptyState = document.getElementById("empty-state");
    const productCountEl = document.getElementById("product-count");
    const searchInput = document.getElementById("product-search") as HTMLInputElement;
    const clearSearchBtn = document.getElementById("clear-search-btn");
    const sortSelect = document.getElementById("sort-products") as HTMLSelectElement;
    const priceRange = document.getElementById("price-range") as HTMLInputElement;
    const priceDisplay = document.getElementById("price-display");
    const filterFeatured = document.getElementById("filter-featured") as HTMLInputElement;
    const catRadios = document.querySelectorAll<HTMLInputElement>(".filter-cat-radio");
    const clearFiltersBtn = document.getElementById("clear-all-filters-btn");
    const clearFiltersBtn2 = document.getElementById("clear-filters-btn-secondary");
    const emptyResetBtn = document.getElementById("empty-reset-btn");
    const mobileFilterBadge = document.getElementById("mobile-filter-badge");

    // Filter State
    let selectedCategory = "all";
    let searchQuery = "";
    let maxPrice = Number(priceRange?.max || 280);
    let onlyFeatured = false;
    let currentSort = "featured";

    // Read initial URL params (e.g. ?cat=Vinhos+Finos)
    const urlParams = new URLSearchParams(window.location.search);
    const paramCat = urlParams.get("cat") || urlParams.get("categoria");
    if (paramCat) {
      selectedCategory = paramCat;
      const matchingRadio = Array.from(catRadios).find((r) => r.value.toLowerCase() === paramCat.toLowerCase());
      if (matchingRadio) matchingRadio.checked = true;
    }
    const paramQuery = urlParams.get("q") || urlParams.get("busca");
    if (paramQuery && searchInput) {
      searchQuery = paramQuery.toLowerCase().trim();
      searchInput.value = paramQuery;
      if (clearSearchBtn) clearSearchBtn.classList.remove("hidden");
    }

    // Dynamic Filter & Sort Function
    const applyFilters = () => {
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>(".product-card"));

      let visibleCount = 0;
      let activeFiltersCount = 0;

      if (selectedCategory !== "all") activeFiltersCount++;
      if (searchQuery) activeFiltersCount++;
      if (maxPrice < Number(priceRange?.max || 280)) activeFiltersCount++;
      if (onlyFeatured) activeFiltersCount++;

      if (mobileFilterBadge) {
        if (activeFiltersCount > 0) {
          mobileFilterBadge.textContent = String(activeFiltersCount);
          mobileFilterBadge.classList.remove("hidden");
        } else {
          mobileFilterBadge.classList.add("hidden");
        }
      }

      // Filter
      cards.forEach((card) => {
        const cat = card.dataset.productCategory || "";
        const name = card.dataset.productName || "";
        const price = parseFloat(card.dataset.productPrice || "0");
        const isFeatured = card.dataset.productFeatured === "true";

        const matchesCategory =
          selectedCategory === "all" ||
          cat.toLowerCase() === selectedCategory.toLowerCase();

        const matchesSearch =
          !searchQuery ||
          name.includes(searchQuery) ||
          cat.toLowerCase().includes(searchQuery);

        const matchesPrice = price <= maxPrice;
        const matchesFeatured = !onlyFeatured || isFeatured;

        if (matchesCategory && matchesSearch && matchesPrice && matchesFeatured) {
          card.style.display = "flex";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      // Sort
      cards.sort((a, b) => {
        const priceA = parseFloat(a.dataset.productPrice || "0");
        const priceB = parseFloat(b.dataset.productPrice || "0");
        const nameA = a.dataset.productName || "";
        const nameB = b.dataset.productName || "";
        const ratingA = parseFloat(a.dataset.productRating || "5");
        const ratingB = parseFloat(b.dataset.productRating || "5");
        const featA = a.dataset.productFeatured === "true" ? 1 : 0;
        const featB = b.dataset.productFeatured === "true" ? 1 : 0;

        switch (currentSort) {
          case "price-asc":
            return priceA - priceB;
          case "price-desc":
            return priceB - priceA;
          case "name-asc":
            return nameA.localeCompare(nameB);
          case "rating":
            return ratingB - ratingA;
          case "featured":
          default:
            return featB - featA;
        }
      });

      cards.forEach((c) => grid.appendChild(c));

      // Update counters
      if (productCountEl) productCountEl.textContent = String(visibleCount);
      if (emptyState) {
        emptyState.classList.toggle("hidden", visibleCount > 0);
      }
    };

    // Category Change (Instant Filter)
    catRadios.forEach((radio) => {
      radio.addEventListener("change", () => {
        if (radio.checked) {
          selectedCategory = radio.value;
          applyFilters();
        }
      });
    });

    // Search Input (Instant Filter)
    searchInput?.addEventListener("input", () => {
      searchQuery = (searchInput.value || "").toLowerCase().trim();
      if (clearSearchBtn) {
        clearSearchBtn.classList.toggle("hidden", !searchQuery);
      }
      applyFilters();
    });

    clearSearchBtn?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      searchQuery = "";
      clearSearchBtn.classList.add("hidden");
      applyFilters();
    });

    // Price Slider (Instant Filter on Drag & Move)
    priceRange?.addEventListener("input", () => {
      maxPrice = Number(priceRange.value);
      if (priceDisplay) priceDisplay.textContent = `Até R$ ${maxPrice},00`;
      applyFilters();
    });

    // Featured Checkbox (Instant Filter)
    filterFeatured?.addEventListener("change", () => {
      onlyFeatured = filterFeatured.checked;
      applyFilters();
    });

    // Sort Dropdown
    sortSelect?.addEventListener("change", () => {
      currentSort = sortSelect.value;
      applyFilters();
    });

    // Reset Filters
    const resetFilters = () => {
      selectedCategory = "all";
      searchQuery = "";
      maxPrice = Number(priceRange?.max || 280);
      onlyFeatured = false;
      currentSort = "featured";

      const allRadio = Array.from(catRadios).find((r) => r.value === "all");
      if (allRadio) allRadio.checked = true;

      if (searchInput) searchInput.value = "";
      if (clearSearchBtn) clearSearchBtn.classList.add("hidden");
      if (priceRange) priceRange.value = String(maxPrice);
      if (priceDisplay) priceDisplay.textContent = `Até R$ ${maxPrice},00`;
      if (filterFeatured) filterFeatured.checked = false;
      if (sortSelect) sortSelect.value = "featured";

      const url = new URL(window.location.href);
      url.search = "";
      window.history.replaceState({}, "", url.toString());

      applyFilters();
    };

    clearFiltersBtn?.addEventListener("click", resetFilters);
    clearFiltersBtn2?.addEventListener("click", resetFilters);
    emptyResetBtn?.addEventListener("click", resetFilters);

    // Mobile Sidebar Drawer Toggle
    const filterSidebar = document.getElementById("filter-sidebar");
    const mobileBackdrop = document.getElementById("mobile-sidebar-backdrop");
    const filterToggleBtn = document.getElementById("filter-toggle-btn");

    const toggleMobileSidebar = (open: boolean) => {
      if (!filterSidebar || !mobileBackdrop) return;
      if (open) {
        filterSidebar.classList.remove("hidden");
        filterSidebar.classList.add("fixed", "top-0", "left-0", "z-50", "h-full", "max-w-[320px]", "w-[85vw]", "bg-[var(--commerce-surface)]", "p-6", "overflow-y-auto");
        mobileBackdrop.classList.remove("hidden");
      } else {
        filterSidebar.classList.add("hidden");
        filterSidebar.classList.remove("fixed", "top-0", "left-0", "z-50", "h-full", "max-w-[320px]", "w-[85vw]", "bg-[var(--commerce-surface)]", "p-6", "overflow-y-auto");
        mobileBackdrop.classList.add("hidden");
      }
    };

    filterToggleBtn?.addEventListener("click", () => toggleMobileSidebar(true));
    mobileBackdrop?.addEventListener("click", () => toggleMobileSidebar(false));

    // Cart Management
    const cartDrawer = document.getElementById("cart-drawer");
    const floatingCartBtn = document.getElementById("floating-cart-btn");
    const cartDrawerClose = document.getElementById("cart-drawer-close");
    const drawerCountBadge = document.getElementById("drawer-count-badge");
    const floatingCartBadge = document.getElementById("floating-cart-badge");
    const cartDrawerTotal = document.getElementById("cart-drawer-total");
    const cartDrawerItems = document.getElementById("cart-drawer-items");
    const cartCheckoutBtn = document.getElementById("cart-checkout-btn");

    const toggleCartDrawer = (open: boolean) => {
      if (!cartDrawer) return;
      if (open) {
        cartDrawer.classList.remove("translate-x-full");
      } else {
        cartDrawer.classList.add("translate-x-full");
      }
    };

    floatingCartBtn?.addEventListener("click", () => toggleCartDrawer(true));
    cartDrawerClose?.addEventListener("click", () => toggleCartDrawer(false));

    const renderCart = () => {
      const entries = Object.entries(cart)
        .map(([id, qty]) => ({ item: catalog.find((p) => p.id === id), qty }))
        .filter((e): e is { item: Product; qty: number } => Boolean(e.item));

      const totalQty = entries.reduce((s, e) => s + e.qty, 0);
      const totalPrice = entries.reduce((s, e) => s + e.item.price * e.qty, 0);

      if (drawerCountBadge) drawerCountBadge.textContent = String(totalQty);
      if (floatingCartBadge) floatingCartBadge.textContent = String(totalQty);
      if (cartDrawerTotal) cartDrawerTotal.textContent = formatBRL(totalPrice);

      if (cartDrawerItems) {
        if (!entries.length) {
          cartDrawerItems.innerHTML = `
            <div class="text-center py-12 text-[var(--commerce-muted)]">
              <p class="mb-2 text-[var(--commerce-muted)] flex justify-center"><svg class="size-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg></p>
              <p class="text-xs">Sua sacola de compras está vazia.</p>
            </div>
          `;
        } else {
          cartDrawerItems.innerHTML = entries
            .map(
              (e) => `
              <div class="flex items-center justify-between p-3 rounded-xl bg-[var(--commerce-surface-raised)] border border-[var(--commerce-border)]">
                <div class="min-w-0 pr-2">
                  <h4 class="text-xs font-bold text-[var(--commerce-foreground)] truncate">${e.item.name}</h4>
                  <p class="text-[11px] text-[var(--commerce-muted)] mt-0.5">${formatBRL(e.item.price)} × ${e.qty}</p>
                </div>
                <button
                  type="button"
                  class="text-xs text-red-400 hover:text-red-300 font-bold shrink-0 p-1"
                  data-remove-cart="${e.item.id}"
                >
                  Remover
                </button>
              </div>
            `
            )
            .join("");
        }
      }

      saveCart(cart);
    };

    // Checkout via WhatsApp
    cartCheckoutBtn?.addEventListener("click", () => {
      const entries = Object.entries(cart)
        .map(([id, qty]) => ({ item: catalog.find((p) => p.id === id), qty }))
        .filter((e): e is { item: Product; qty: number } => Boolean(e.item));

      if (!entries.length) {
        showToast("Sua sacola está vazia.");
        return;
      }

      let msg = `Olá Tchê Empório Gaúcho!\n\nGostaria de fazer o pedido dos seguintes itens da minha sacola:\n\n`;
      let total = 0;
      entries.forEach((e) => {
        const sub = e.item.price * e.qty;
        total += sub;
        msg += `• ${e.qty}x ${e.item.name} (${formatBRL(e.item.price)}) = ${formatBRL(sub)}\n`;
      });
      msg += `\n*Total Estimado: ${formatBRL(total)}*\n\nPoderia me confirmar a disponibilidade e o frete para o meu CEP?`;

      const url = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(msg)}`;
      window.open(url, "_blank");
    });

    // Single item direct order via WhatsApp
    const orderSingleItemWA = (name: string, price: number) => {
      const text = `Olá Tchê Empório Gaúcho!\n\nTenho interesse no produto *${name}* (${formatBRL(price)}).\n\nEstá disponível para envio ou retirada?`;
      const url = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(text)}`;
      window.open(url, "_blank");
    };

    // Wishlist UI sync
    const syncWishlist = () => {
      document.querySelectorAll<HTMLElement>("[data-wish-id]").forEach((btn) => {
        const id = btn.dataset.wishId;
        if (id) {
          btn.setAttribute("aria-pressed", String(wishlist.includes(id)));
        }
      });
    };

    // QuickView Modal
    const modal = document.getElementById("quickview-modal") as HTMLDialogElement;
    const modalContent = document.getElementById("quickview-content");
    const modalClose = document.getElementById("quickview-close-btn");

    const openQuickView = (id: string) => {
      const prod = catalog.find((p) => p.id === id);
      if (!prod || !modal || !modalContent) return;

      modalContent.innerHTML = `
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-center">
          <div class="aspect-square bg-[var(--commerce-surface-raised)] rounded-2xl p-4 flex items-center justify-center">
            <img src="${prod.image || "/images/shop/cosmic-products.png"}" alt="${prod.name}" class="max-h-full max-w-full object-contain" />
          </div>
          <div>
            <span class="text-xs font-bold uppercase text-[var(--commerce-accent)]">${prod.category}</span>
            <h3 class="text-lg font-bold text-[var(--commerce-foreground)] mt-1 mb-2">${prod.name}</h3>
            <p class="text-xl font-black text-[var(--commerce-foreground)] mb-3">${formatBRL(prod.price)}</p>
            <p class="text-xs text-[var(--commerce-muted)] line-clamp-4 leading-relaxed mb-4">${prod.description}</p>
            <div class="flex gap-2">
              <a href="/produto/${prod.id}" class="py-2.5 px-4 rounded-xl bg-[var(--commerce-accent)] text-white text-xs font-bold hover:opacity-90 transition">
                Ver Página Completa
              </a>
              <button type="button" class="py-2.5 px-4 rounded-xl bg-[#166534] text-white text-xs font-bold hover:bg-[#15803d] transition" id="quickview-wa-btn">
                <svg class="size-3.5 fill-current shrink-0 inline-block mr-1" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg> Pedir no WhatsApp
              </button>
            </div>
          </div>
        </div>
      `;

      document.getElementById("quickview-wa-btn")?.addEventListener("click", () => {
        orderSingleItemWA(prod.name, prod.price);
      });

      modal.showModal();
    };

    modalClose?.addEventListener("click", () => modal.close());
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });

    // Event Delegation for Grid Actions
    grid?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      // Click to view product details page
      const linkContainer = target.closest<HTMLElement>("[data-product-link]");
      if (linkContainer && !target.closest("button")) {
        const href = linkContainer.dataset.productLink;
        if (href) window.location.href = href;
        return;
      }

      // WhatsApp direct order
      const waBtn = target.closest<HTMLButtonElement>("[data-wa-order]");
      if (waBtn) {
        const name = waBtn.dataset.name || "Produto";
        const price = parseFloat(waBtn.dataset.price || "0");
        orderSingleItemWA(name, price);
        return;
      }

      // Add to Cart
      const cartBtn = target.closest<HTMLButtonElement>("[data-add-cart]");
      if (cartBtn) {
        const id = cartBtn.dataset.id;
        const name = cartBtn.dataset.name || "Produto";
        if (id) {
          cart[id] = (cart[id] || 0) + 1;
          renderCart();
          showToast(`+1 "${name}" adicionado à sacola!`);
        }
        return;
      }

      // Wishlist toggle
      const wishBtn = target.closest<HTMLButtonElement>("[data-wish-id]");
      if (wishBtn) {
        const id = wishBtn.dataset.wishId;
        if (id) {
          if (wishlist.includes(id)) {
            wishlist = wishlist.filter((item) => item !== id);
            showToast("Item removido dos favoritos.");
          } else {
            wishlist.push(id);
            showToast("Item salvo nos favoritos!");
          }
          saveWishlist(wishlist);
          syncWishlist();
        }
        return;
      }
    });

    // Cart remove delegation
    cartDrawerItems?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const removeBtn = target.closest<HTMLButtonElement>("[data-remove-cart]");
      if (removeBtn) {
        const id = removeBtn.dataset.removeCart;
        if (id && cart[id]) {
          delete cart[id];
          renderCart();
          showToast("Item removido da sacola.");
        }
      }
    });

    // Initial setup
    applyFilters();
    renderCart();
    syncWishlist();
  }

  initCatalog();
  document.addEventListener("astro:page-load", initCatalog);
</script>
