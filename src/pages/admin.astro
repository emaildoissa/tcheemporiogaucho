---
import "../styles/global.css";
import { products as defaultProducts } from "../data/products";
import availableUploads from "../data/availableUploads.json";
---

<!doctype html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width,initial-scale=1" name="viewport" />
    <title>Painel Administrativo — Tchê Empório Gaúcho</title>
    <link rel="icon" type="image/png" href="/favicons/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
  </head>
  <body class="bg-[#0b0c0e] text-[#f2ede6] font-sans min-h-screen">
    <!-- Header Admin -->
    <header class="border-b border-[#2d2422] bg-[#141212] sticky top-0 z-30 px-6 py-4">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <img
            src="/images/logo.png"
            alt="Logo Tchê Empório Gaúcho"
            class="w-10 h-10 object-contain rounded-full shadow-md"
          />
          <div>
            <h1 class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
              Tchê Empório Gaúcho
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-[#8b1b22]/30 text-[#e67e84] border border-[#8b1b22]/50">
                Admin
              </span>
            </h1>
            <p class="text-xs text-[#a39a97]">Gerenciador de Catálogo de Produtos Coloniais</p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <a
            href="/"
            class="px-4 py-2 text-xs font-semibold rounded-lg border border-[#3e3432] bg-[#1a1717] hover:bg-[#25201f] text-[#f2ede6] transition flex items-center gap-2"
          >
            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Ver Loja Pública
          </a>
          <button
            type="button"
            id="btn-export-json"
            class="px-3.5 py-2 text-xs font-semibold rounded-lg border border-[#3e3432] bg-[#1a1717] hover:bg-[#25201f] text-[#d5cbca] transition flex items-center gap-1.5"
            title="Baixar cópia do JSON atualizado"
          >
            <svg class="size-3.5 text-[#d4af37]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Exportar JSON
          </button>
          <button
            type="button"
            id="btn-refresh-catalog"
            class="px-3.5 py-2 text-xs font-semibold rounded-lg border border-[#3e3432] bg-[#1a1717] hover:bg-[#25201f] text-[#d5cbca] transition flex items-center gap-1.5 disabled:opacity-50 disabled:cursor-wait"
            title="Recarrega o catálogo direto do banco Supabase"
          >
            <svg class="size-3.5 text-[#d4af37]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m15.356 2H20v5m-.582-2A8.001 8.001 0 014.582 15" />
            </svg>
            Atualizar do Banco
          </button>
          <button
            type="button"
            id="btn-open-add-modal"
            class="px-4 py-2 text-xs font-bold rounded-lg bg-[#8b1b22] hover:bg-[#a52129] text-white shadow-lg transition flex items-center gap-1.5"
          >
            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
            Novo Produto
          </button>

          <!-- Sessão do administrador -->
          <div
            id="session-chip"
            class="hidden items-center gap-2.5 pl-3 pr-1 py-1 rounded-lg border border-[#2d2422] bg-[#1a1717]"
          >
            <span class="size-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.7)]" aria-hidden="true"></span>
            <div class="leading-tight text-left">
              <span class="block text-[9px] font-semibold uppercase tracking-[0.14em] text-[#7d7270]">Administrador</span>
              <span id="session-email" class="block text-xs font-semibold text-[#f2ede6] max-w-[170px] truncate">—</span>
            </div>
            <button
              type="button"
              id="btn-logout"
              class="ml-1 px-2.5 py-1.5 text-[11px] font-semibold rounded-md border border-[#3e3432] text-[#d5cbca] hover:border-[#8b1b22] hover:text-white hover:bg-[#8b1b22]/20 transition flex items-center gap-1.5"
              title="Encerrar a sessão de administrador"
            >
              <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              Sair
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-6 py-8">
      <!-- KPI Stats -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-[#161313] border border-[#2d2422] rounded-xl p-5 shadow-sm">
          <span class="text-xs font-semibold uppercase tracking-wider text-[#9f918e]">Total de Produtos</span>
          <div class="text-3xl font-extrabold text-white mt-2" id="stat-total-products">0</div>
          <span class="text-xs text-[#7d7270] mt-1 block">Itens cadastrados no catálogo</span>
        </div>
        <div class="bg-[#161313] border border-[#2d2422] rounded-xl p-5 shadow-sm">
          <span class="text-xs font-semibold uppercase tracking-wider text-[#9f918e]">Categorias Ativas</span>
          <div class="text-3xl font-extrabold text-[#e67e84] mt-2" id="stat-total-categories">0</div>
          <span class="text-xs text-[#7d7270] mt-1 block">Vinhos, embutidos, doces e mais</span>
        </div>
        <div class="bg-[#161313] border border-[#2d2422] rounded-xl p-5 shadow-sm">
          <span class="text-xs font-semibold uppercase tracking-wider text-[#9f918e]">Produtos em Destaque</span>
          <div class="text-3xl font-extrabold text-amber-400 mt-2" id="stat-featured-products">0</div>
          <span class="text-xs text-[#7d7270] mt-1 block">Exibidos na vitrine principal</span>
        </div>
        <div class="bg-[#161313] border border-[#2d2422] rounded-xl p-5 shadow-sm">
          <span class="text-xs font-semibold uppercase tracking-wider text-[#9f918e]">Preço Médio</span>
          <div class="text-3xl font-extrabold text-emerald-400 mt-2" id="stat-avg-price">R$ 0,00</div>
          <span class="text-xs text-[#7d7270] mt-1 block">Média de valor do catálogo</span>
        </div>
      </div>

      <!-- Filter and Search Bar -->
      <div class="bg-[#161313] border border-[#2d2422] rounded-xl p-4 mb-6 flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3 flex-1 min-w-[280px]">
          <div class="relative flex-1 min-w-[220px]">
            <input
              type="text"
              id="search-input" aria-label="Buscar produto por nome, ID ou descrição"
              placeholder="Buscar produto por nome, ID ou descrição..."
              class="w-full bg-[#0d0c0c] border border-[#3e3432] rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-[#7d7270] focus:outline-none focus:border-[#8b1b22]"
            />
          </div>
          <select
            id="category-select" aria-label="Filtrar por categoria"
            class="bg-[#0d0c0c] border border-[#3e3432] rounded-lg px-3 py-2.5 text-sm text-white focus:outline-none focus:border-[#8b1b22]"
          >
            <option value="all">Todas as Categorias</option>
          </select>
        </div>

        <div class="flex items-center gap-3 text-xs text-[#9f918e]">
          <span
            id="sync-status"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-[#3e3432] bg-[#0d0c0c] text-[#a39a97]"
            role="status"
            aria-live="polite"
          >
            <span id="sync-dot" class="size-1.5 rounded-full bg-[#7d7270]" aria-hidden="true"></span>
            <span id="sync-label">Verificando conexão</span>
          </span>
          <span>
            Mostrando <span id="filtered-count" class="font-bold text-white">0</span> produtos
          </span>
        </div>
      </div>

      <!-- Products Table -->
      <div class="bg-[#161313] border border-[#2d2422] rounded-xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-[#2d2422] bg-[#120f0f] text-xs uppercase font-semibold text-[#a39a97]">
                <th class="py-3 px-4">Foto</th>
                <th class="py-3 px-4">Produto</th>
                <th class="py-3 px-4">Categoria</th>
                <th class="py-3 px-4">Preço (R$)</th>
                <th class="py-3 px-4">Destaque</th>
                <th class="py-3 px-4 text-right">Ações</th>
              </tr>
            </thead>
            <tbody id="products-table-body" class="divide-y divide-[#241d1c]">
              <!-- Injected by script -->
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <!-- Modal Adicionar / Editar Produto -->
    <div
      id="product-modal"
      class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4"
    >
      <div class="bg-[#161313] border border-[#3e3432] rounded-2xl w-full max-w-xl max-h-[90vh] overflow-y-auto shadow-2xl p-6">
        <div class="flex items-center justify-between pb-4 border-b border-[#2d2422] mb-5">
          <h2 id="modal-title" class="text-lg font-bold text-white">Adicionar Produto</h2>
          <button type="button" id="btn-close-modal" class="text-[#a39a97] hover:text-white text-xl">✕</button>
        </div>

        <form id="product-form" class="space-y-4">
          <input type="hidden" id="form-product-id" />

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#a39a97] mb-1.5">
              Nome do Produto *
            </label>
            <input
              type="text"
              id="form-product-name" aria-label="Nome do produto"
              required
              placeholder="Ex: Vinho Fino Tinto Cabernet Sauvignon 750ml"
              class="w-full bg-[#0d0c0c] border border-[#3e3432] rounded-lg px-3.5 py-2 text-sm text-white focus:outline-none focus:border-[#8b1b22]"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Categoria com Dropdown Predefinido -->
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#a39a97] mb-1.5">
                Categoria *
              </label>
              <select
                id="form-product-category" aria-label="Categoria do produto"
                required
                class="w-full bg-[#0d0c0c] border border-[#3e3432] rounded-lg px-3.5 py-2 text-sm text-white focus:outline-none focus:border-[#8b1b22]"
              >
                <!-- Preenchido dinamicamente com todas as categorias + opção personalizada -->
              </select>
              <input
                type="text"
                id="form-product-category-custom" aria-label="Nova categoria personalizada"
                placeholder="Digite a nova categoria..."
                class="hidden mt-2 w-full bg-[#0d0c0c] border border-[#3e3432] rounded-lg px-3.5 py-2 text-sm text-white focus:outline-none focus:border-[#8b1b22]"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#a39a97] mb-1.5">
                Preço de Venda (R$) *
              </label>
              <input
                type="number"
                step="0.10"
                min="0"
                id="form-product-price" aria-label="Preço de venda em reais"
                required
                placeholder="0.00"
                class="w-full bg-[#0d0c0c] border border-[#3e3432] rounded-lg px-3.5 py-2 text-sm text-white focus:outline-none focus:border-[#8b1b22]"
              />
            </div>
          </div>

          <!-- Seção de Importação Simplificada de Fotos -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#a39a97]">
                Foto do Produto
              </label>
              <button
                type="button"
                id="btn-toggle-manual-url"
                class="text-xs text-[#a39a97] hover:text-[#d4af37] underline transition"
              >
                Digitar URL manual
              </button>
            </div>

            <!-- Botões Rápidos de Ação: Upload de Arquivo ou Galeria Existente -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <!-- Opção 1: Upload de Arquivo do Dispositivo -->
              <label
                class="flex items-center justify-center gap-2 p-3 rounded-xl border border-dashed border-[#3e3432] hover:border-[#8b1b22] bg-[#0d0c0c] hover:bg-[#191515] text-[#d5cbca] text-xs font-semibold cursor-pointer transition"
                title="Selecione uma imagem do seu computador ou celular"
              >
                <svg class="size-4 text-[#8b1b22]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                <span>Carregar Imagem Local</span>
                <input type="file" id="form-product-file" accept="image/*" class="hidden" />
              </label>

              <!-- Opção 2: Escolher da Galeria Existente -->
              <button
                type="button"
                id="btn-open-gallery"
                class="flex items-center justify-center gap-2 p-3 rounded-xl border border-[#3e3432] hover:border-[#d4af37] bg-[#0d0c0c] hover:bg-[#191515] text-[#d5cbca] text-xs font-semibold transition"
                title="Selecione uma foto colonial já cadastrada no acervo"
              >
                <svg class="size-4 text-[#d4af37]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span>Galeria da Loja (239 fotos)</span>
              </button>
            </div>

            <!-- Prévia e Status da Foto Atual -->
            <div class="flex gap-3 items-center p-2.5 rounded-xl bg-[#0d0c0c] border border-[#2d2422]">
              <div class="w-14 h-14 bg-[#141212] border border-[#3e3432] rounded-lg overflow-hidden flex items-center justify-center shrink-0">
                <img id="form-image-preview" src="" alt="Prévia" class="w-full h-full object-contain hidden" />
                <span id="form-image-placeholder" class="text-[11px] text-[#7d7270] text-center px-1">Sem Foto</span>
              </div>
              <div class="flex-1 min-w-0">
                <div id="image-status-badge" class="text-xs font-semibold text-[#a39a97] truncate">Nenhuma foto selecionada</div>
                <div id="image-path-display" class="text-[11px] text-[#7d7270] font-mono truncate mt-0.5">Clique acima para carregar ou escolher</div>
              </div>
              <button
                type="button"
                id="btn-clear-image"
                class="text-xs text-red-400 hover:text-red-300 px-2 py-1 rounded hover:bg-red-950/30 transition hidden"
              >
                Remover
              </button>
            </div>

            <!-- Campo manual alternativo (oculto por padrão) -->
            <div id="manual-url-container" class="hidden pt-1">
              <input
                type="text"
                id="form-product-image" aria-label="URL da foto do produto"
                placeholder="/uploads/2025/07/amendoim-cru-500g.png"
                class="w-full bg-[#0d0c0c] border border-[#3e3432] rounded-lg px-3.5 py-2 text-xs text-white focus:outline-none focus:border-[#8b1b22]"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#a39a97] mb-1.5">
              Descrição
            </label>
            <textarea
              id="form-product-desc" aria-label="Descrição do produto"
              rows="3"
              placeholder="Descrição com detalhes de sabor, receita colonial e harmonização..."
              class="w-full bg-[#0d0c0c] border border-[#3e3432] rounded-lg px-3.5 py-2 text-sm text-white focus:outline-none focus:border-[#8b1b22]"
            ></textarea>
          </div>

          <!-- Selo / Badge com Dropdown Predefinido -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#a39a97] mb-1.5">
                Selo / Badge
              </label>
              <select
                id="form-product-badge" aria-label="Selo do produto"
                class="w-full bg-[#0d0c0c] border border-[#3e3432] rounded-lg px-3.5 py-2 text-sm text-white focus:outline-none focus:border-[#8b1b22]"
              >
                <option value="">Nenhum (Sem selo)</option>
                <option value="Mais Vendido">Mais Vendido</option>
                <option value="Artesanal">Artesanal</option>
                <option value="Receita Tradicional">Receita Tradicional</option>
                <option value="Reserva Especial">Reserva Especial</option>
                <option value="Colonial Gaúcho">Colonial Gaúcho</option>
                <option value="Edição Limitada">Edição Limitada</option>
                <option value="Premiado">Premiado</option>
                <option value="__custom__">+ Outro selo personalizado...</option>
              </select>
              <input
                type="text"
                id="form-product-badge-custom" aria-label="Selo personalizado"
                placeholder="Digite o selo personalizado..."
                class="hidden mt-2 w-full bg-[#0d0c0c] border border-[#3e3432] rounded-lg px-3.5 py-2 text-sm text-white focus:outline-none focus:border-[#8b1b22]"
              />
            </div>

            <div class="flex items-center gap-3 pt-6">
              <input
                type="checkbox"
                id="form-product-featured"
                class="w-4 h-4 rounded text-[#8b1b22] focus:ring-[#8b1b22] bg-[#0d0c0c] border-[#3e3432]"
              />
              <label for="form-product-featured" class="text-sm font-medium text-white cursor-pointer">
                Exibir em Destaque na Vitrine
              </label>
            </div>
          </div>

          <div class="flex justify-end gap-3 pt-4 border-t border-[#2d2422]">
            <button
              type="button"
              id="btn-cancel-modal"
              class="px-4 py-2 text-sm font-semibold rounded-lg border border-[#3e3432] text-[#d5cbca] hover:bg-[#25201f]"
            >
              Cancelar
            </button>
            <button
              type="submit"
              class="px-5 py-2 text-sm font-bold rounded-lg bg-[#8b1b22] hover:bg-[#a52129] text-white shadow-lg transition"
            >
              Salvar Alterações
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal da Galeria de Fotos Existentes -->
    <div
      id="gallery-picker-modal"
      class="fixed inset-0 z-60 bg-black/85 backdrop-blur-md hidden items-center justify-center p-4"
    >
      <div class="bg-[#161313] border border-[#3e3432] rounded-2xl w-full max-w-4xl h-[85vh] flex flex-col shadow-2xl p-6">
        <div class="flex items-center justify-between pb-4 border-b border-[#2d2422] mb-4">
          <div>
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <svg class="size-5 text-[#d4af37]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Galeria de Fotos Coloniais da Loja
            </h3>
            <p class="text-xs text-[#a39a97]">Clique em qualquer imagem para selecioná-la imediatamente para o produto</p>
          </div>
          <button type="button" id="btn-close-gallery" class="text-[#a39a97] hover:text-white text-xl">✕</button>
        </div>

        <!-- Barra de Busca Rápida na Galeria -->
        <div class="mb-4">
          <input
            type="text"
            id="gallery-search-input" aria-label="Filtrar fotos da galeria"
            placeholder="Filtrar por nome (ex: vinho, amendoim, espumante, geleia, mel, queijo, salame)..."
            class="w-full bg-[#0d0c0c] border border-[#3e3432] rounded-xl px-4 py-2.5 text-sm text-white placeholder-[#7d7270] focus:outline-none focus:border-[#8b1b22]"
          />
        </div>

        <!-- Grade de Miniaturas -->
        <div id="gallery-grid" class="flex-1 overflow-y-auto grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 p-1">
          <!-- Injetado via script -->
        </div>

        <div class="pt-4 border-t border-[#2d2422] flex justify-between items-center text-xs text-[#a39a97]">
          <span id="gallery-status-count">Carregando acervo...</span>
          <button type="button" id="btn-cancel-gallery" class="px-4 py-1.5 rounded-lg border border-[#3e3432] hover:bg-[#25201f] text-white">Fechar</button>
        </div>
      </div>
    </div>

    <!-- Gate de Autenticação (Supabase Auth) -->
    <div
      id="auth-gate"
      class="fixed inset-0 z-[70] flex items-center justify-center p-4 overflow-y-auto"
      style="background:
        radial-gradient(1100px 520px at 50% -12%, rgba(139, 27, 34, 0.32), transparent 62%),
        radial-gradient(760px 420px at 88% 108%, rgba(212, 175, 55, 0.10), transparent 60%),
        #0b0c0e;"
      role="dialog"
      aria-modal="true"
      aria-labelledby="auth-title"
    >
      <div class="w-full max-w-md my-8">
        <div class="relative bg-[#141212] border border-[#3e3432] rounded-2xl shadow-2xl overflow-hidden">
          <!-- Filete dourado superior -->
          <div class="h-1 w-full bg-gradient-to-r from-[#8b1b22] via-[#d4af37] to-[#8b1b22]" aria-hidden="true"></div>

          <div class="p-7 sm:p-8">
            <div class="flex items-center gap-3">
              <img
                src="/images/logo.png"
                alt="Logo Tchê Empório Gaúcho"
                class="w-11 h-11 object-contain rounded-full shadow-md border border-[#3e3432] bg-[#0d0c0c]"
              />
              <div>
                <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#d4af37]">Tchê Empório Gaúcho</p>
                <p class="text-sm font-semibold text-white">Painel Administrativo</p>
              </div>
            </div>

            <!-- 1. Verificando sessão -->
            <div id="auth-checking" class="py-12 text-center">
              <span class="inline-block size-7 rounded-full border-2 border-[#3e3432] border-t-[#d4af37] animate-spin" aria-hidden="true"></span>
              <p class="mt-4 text-sm text-[#a39a97]">Verificando sessão de administrador…</p>
            </div>

            <!-- 2. Formulário de login -->
            <div id="auth-login" class="hidden">
              <h2 id="auth-title" class="mt-6 text-2xl font-bold tracking-tight text-white">Acesso restrito</h2>
              <p class="mt-1.5 text-sm text-[#a39a97] leading-relaxed">
                Entre com a conta de administrador para gerenciar o catálogo da loja.
              </p>

              <form id="login-form" class="mt-6 space-y-4" novalidate>
                <div>
                  <label for="login-email" class="block text-[11px] font-semibold uppercase tracking-wider text-[#a39a97] mb-1.5">
                    E-mail
                  </label>
                  <input
                    type="email"
                    id="login-email"
                    name="email"
                    required
                    autocomplete="username"
                    inputmode="email"
                    placeholder="admin@tcheemporiogaucho.com.br"
                    class="w-full bg-[#0d0c0c] border border-[#3e3432] rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-[#6b6260] focus:outline-none focus:border-[#d4af37] focus:ring-1 focus:ring-[#d4af37]/40 transition"
                  />
                </div>

                <div>
                  <label for="login-password" class="block text-[11px] font-semibold uppercase tracking-wider text-[#a39a97] mb-1.5">
                    Senha
                  </label>
                  <div class="relative">
                    <input
                      type="password"
                      id="login-password"
                      name="password"
                      required
                      autocomplete="current-password"
                      placeholder="••••••••"
                      class="w-full bg-[#0d0c0c] border border-[#3e3432] rounded-lg pl-3.5 pr-11 py-2.5 text-sm text-white placeholder-[#6b6260] focus:outline-none focus:border-[#d4af37] focus:ring-1 focus:ring-[#d4af37]/40 transition"
                    />
                    <button
                      type="button"
                      id="btn-toggle-password"
                      class="absolute inset-y-0 right-0 px-3 text-[#7d7270] hover:text-[#d4af37] transition"
                      aria-label="Mostrar senha"
                      aria-pressed="false"
                    >
                      <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7S3.732 16.057 2.458 12z" />
                      </svg>
                    </button>
                  </div>
                </div>

                <div
                  id="login-error"
                  class="hidden items-start gap-2 rounded-lg border border-red-900/60 bg-red-950/40 px-3 py-2.5 text-xs text-red-200"
                  role="alert"
                  aria-live="assertive"
                >
                  <svg class="size-4 shrink-0 text-red-400 mt-px" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                  </svg>
                  <span id="login-error-text">Credenciais inválidas.</span>
                </div>

                <button
                  type="submit"
                  id="btn-login"
                  class="w-full py-2.5 px-4 text-sm font-bold rounded-lg bg-[#8b1b22] hover:bg-[#a52129] text-white shadow-lg transition disabled:opacity-60 disabled:cursor-wait flex items-center justify-center gap-2"
                >
                  <span id="login-spinner" class="hidden size-4 rounded-full border-2 border-white/30 border-t-white animate-spin" aria-hidden="true"></span>
                  <span id="login-btn-label">Entrar no Painel</span>
                </button>
              </form>
            </div>
          </div>

          <div class="px-7 sm:px-8 py-3.5 border-t border-[#2d2422] bg-[#100e0e] flex items-center gap-2 text-[11px] text-[#7d7270]">
            <svg class="size-3.5 text-[#d4af37]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622C17.176 19.29 21 14.591 21 9c0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Sessão protegida por Supabase Auth
          </div>
        </div>

        <p class="mt-4 text-center text-[11px] text-[#5e5452]">
          Acesso exclusivo da equipe Tchê Empório Gaúcho.
        </p>
      </div>
    </div>

    <!-- Toast Notification -->
    <div
      id="admin-toast"
      class="fixed bottom-6 right-6 z-50 bg-[#1f1b1b] border border-[#8b1b22] text-white px-5 py-3 rounded-xl shadow-2xl text-sm font-medium transition-all duration-300 opacity-0 pointer-events-none translate-y-2"
      role="status"
      aria-live="polite"
    >
      Notificação
    </div>

    <!-- Initial Data Scripts -->
    <script type="application/json" id="initial-products-data" set:html={JSON.stringify(defaultProducts)} />
    <script type="application/json" id="available-uploads-data" set:html={JSON.stringify(availableUploads)} />

    <script>
      import {
        getProducts,
        createProduct,
        updateProduct,
        deleteProduct,
        signIn,
        signOut,
        getCurrentUser,
        isSupabaseConfigured,
        onAuthStateChange,
        supabase,
      } from "../lib/supabase";
      import { loadCatalogFromStorage, saveCatalogToStorage } from "../lib/storefrontStorage";

      interface ProductItem {
        id: string;
        name: string;
        category: string;
        price: number;
        regular_price?: number | null;
        rating: number;
        reviews: number;
        image: string;
        description: string;
        badge?: string;
        featured?: boolean;
      }

      /* ------------------------------------------------------------------ */
      /* Dados iniciais (fallback offline)                                   */
      /* ------------------------------------------------------------------ */
      const initialDataEl = document.getElementById("initial-products-data");
      const initialProducts: ProductItem[] = JSON.parse(initialDataEl?.textContent || "[]");

      const availableUploadsEl = document.getElementById("available-uploads-data");
      const availableUploads: string[] = JSON.parse(availableUploadsEl?.textContent || "[]");

      /* ------------------------------------------------------------------ */
      /* Utilidades                                                          */
      /* ------------------------------------------------------------------ */
      function escapeHtml(value: string): string {
        return String(value ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      /** Aceita tanto `T[]` quanto o retorno { data, error } do supabase-js. */
      function unwrap<T = any>(result: any): T {
        if (result && typeof result === "object" && !Array.isArray(result)) {
          if ("error" in result && result.error) {
            throw new Error(result.error.message || String(result.error));
          }
          if ("data" in result) return result.data as T;
        }
        return result as T;
      }

      /** Normaliza linhas do Supabase (snake_case) e objetos já em camelCase. */
      function normalizeProduct(raw: any): ProductItem {
        const item = raw ?? {};
        return {
          id: String(item.id ?? ""),
          name: String(item.name ?? ""),
          category: String(item.category ?? "Geral"),
          price: Number(item.price ?? 0) || 0,
          regular_price: item.regular_price ?? item.regularPrice ?? null,
          rating: Number(item.rating ?? 5) || 5,
          reviews: Number(item.reviews ?? 0) || 0,
          image: String(item.image ?? ""),
          description: String(item.description ?? ""),
          badge: item.badge ? String(item.badge) : undefined,
          featured: Boolean(item.featured),
        };
      }

      /** Payload aceito por `createProduct` / `updateProduct`. */
      function toDbPayload(item: ProductItem) {
        return {
          id: item.id,
          name: item.name,
          category: item.category,
          price: item.price,
          regular_price: item.regular_price ?? undefined,
          rating: item.rating,
          reviews: item.reviews,
          image: item.image,
          description: item.description,
          // string vazia limpa o selo no banco (o serviço converte para null)
          badge: item.badge ?? "",
          featured: Boolean(item.featured),
        };
      }

      /** Sonda leve: confirma que o PostgREST responde (o serviço cai no local sem avisar). */
      async function isRemoteReachable(): Promise<boolean> {
        if (!isSupabaseConfigured || !supabase) return false;
        try {
          const { error } = await supabase
            .from("products")
            .select("id", { head: true, count: "exact" })
            .limit(1);
          return !error;
        } catch {
          return false;
        }
      }

      const cachedCatalog = loadCatalogFromStorage<ProductItem>();
      let catalog: ProductItem[] = cachedCatalog && cachedCatalog.length ? cachedCatalog : initialProducts;
      let isBusy = false;

      /* ------------------------------------------------------------------ */
      /* Elementos de UI                                                     */
      /* ------------------------------------------------------------------ */
      const tableBody = document.getElementById("products-table-body");
      const searchInput = document.getElementById("search-input") as HTMLInputElement;
      const categorySelect = document.getElementById("category-select") as HTMLSelectElement;
      const filteredCountEl = document.getElementById("filtered-count");
      const syncDot = document.getElementById("sync-dot");
      const syncLabel = document.getElementById("sync-label");
      const syncStatus = document.getElementById("sync-status");

      const statTotalEl = document.getElementById("stat-total-products");
      const statCatEl = document.getElementById("stat-total-categories");
      const statFeaturedEl = document.getElementById("stat-featured-products");
      const statAvgEl = document.getElementById("stat-avg-price");

      const btnRefresh = document.getElementById("btn-refresh-catalog") as HTMLButtonElement | null;

      const modal = document.getElementById("product-modal");
      const modalTitle = document.getElementById("modal-title");
      const productForm = document.getElementById("product-form") as HTMLFormElement;
      const formId = document.getElementById("form-product-id") as HTMLInputElement;
      const formName = document.getElementById("form-product-name") as HTMLInputElement;
      const formCat = document.getElementById("form-product-category") as HTMLSelectElement;
      const formCatCustom = document.getElementById("form-product-category-custom") as HTMLInputElement;
      const formPrice = document.getElementById("form-product-price") as HTMLInputElement;
      const formImg = document.getElementById("form-product-image") as HTMLInputElement;
      const formFileInput = document.getElementById("form-product-file") as HTMLInputElement;
      const formDesc = document.getElementById("form-product-desc") as HTMLTextAreaElement;
      const formBadge = document.getElementById("form-product-badge") as HTMLSelectElement;
      const formBadgeCustom = document.getElementById("form-product-badge-custom") as HTMLInputElement;
      const formFeatured = document.getElementById("form-product-featured") as HTMLInputElement;

      const imgPreview = document.getElementById("form-image-preview") as HTMLImageElement;
      const imgPlaceholder = document.getElementById("form-image-placeholder") as HTMLSpanElement;
      const imgStatusBadge = document.getElementById("image-status-badge") as HTMLDivElement;
      const imgPathDisplay = document.getElementById("image-path-display") as HTMLDivElement;
      const btnClearImg = document.getElementById("btn-clear-image") as HTMLButtonElement;
      const manualUrlContainer = document.getElementById("manual-url-container") as HTMLDivElement;

      const galleryModal = document.getElementById("gallery-picker-modal");
      const galleryGrid = document.getElementById("gallery-grid");
      const gallerySearchInput = document.getElementById("gallery-search-input") as HTMLInputElement;
      const galleryStatusCount = document.getElementById("gallery-status-count");

      // Autenticação
      const authGate = document.getElementById("auth-gate");
      const authChecking = document.getElementById("auth-checking");
      const authLogin = document.getElementById("auth-login");
      const loginForm = document.getElementById("login-form") as HTMLFormElement;
      const loginEmail = document.getElementById("login-email") as HTMLInputElement;
      const loginPassword = document.getElementById("login-password") as HTMLInputElement;
      const loginError = document.getElementById("login-error");
      const loginErrorText = document.getElementById("login-error-text");
      const btnLogin = document.getElementById("btn-login") as HTMLButtonElement;
      const btnLoginLabel = document.getElementById("login-btn-label");
      const loginSpinner = document.getElementById("login-spinner");
      const btnTogglePassword = document.getElementById("btn-toggle-password");
      const sessionChip = document.getElementById("session-chip");
      const sessionEmailEl = document.getElementById("session-email");
      const btnLogout = document.getElementById("btn-logout") as HTMLButtonElement | null;

      // Toast
      const toast = document.getElementById("admin-toast");
      let toastTimer: number;

      type ToastKind = "success" | "error" | "warning" | "info";

      const TOAST_TONE: Record<ToastKind, string> = {
        success: "border-emerald-700/70 bg-[#132019] text-emerald-50",
        error: "border-red-800 bg-[#1f1314] text-red-50",
        warning: "border-amber-700/70 bg-[#1f1a10] text-amber-50",
        info: "border-[#8b1b22] bg-[#1f1b1b] text-white",
      };

      function showToast(msg: string, kind: ToastKind = "info") {
        if (!toast) return;
        toast.className = `fixed bottom-6 right-6 z-50 max-w-sm px-5 py-3 rounded-xl shadow-2xl text-sm font-medium border transition-all duration-300 opacity-100 translate-y-0 ${TOAST_TONE[kind]}`;
        toast.textContent = msg;
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.classList.remove("opacity-100", "translate-y-0");
          toast.classList.add("opacity-0", "pointer-events-none", "translate-y-2");
        }, 3200);
      }

      function setSyncStatus(mode: "loading" | "online" | "offline" | "idle", label: string) {
        if (syncLabel) syncLabel.textContent = label;
        if (!syncDot || !syncStatus) return;
        syncDot.className = "size-1.5 rounded-full";
        if (mode === "online") {
          syncDot.classList.add("bg-emerald-400");
          syncStatus.className = "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-emerald-900/60 bg-emerald-950/30 text-emerald-300";
        } else if (mode === "offline") {
          syncDot.classList.add("bg-amber-400");
          syncStatus.className = "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-amber-900/60 bg-amber-950/20 text-amber-300";
        } else if (mode === "idle") {
          syncDot.classList.add("bg-[#7d7270]");
          syncStatus.className = "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-[#3e3432] bg-[#0d0c0c] text-[#a39a97]";
        } else {
          syncDot.classList.add("bg-[#7d7270]", "animate-pulse");
          syncStatus.className = "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-[#3e3432] bg-[#0d0c0c] text-[#a39a97]";
        }
      }

      /* ------------------------------------------------------------------ */
      /* Sessão                                                              */
      /* ------------------------------------------------------------------ */
      function showAuthGate(mode: "checking" | "login") {
        if (!authGate) return;
        authGate.classList.remove("hidden");
        authGate.removeAttribute("aria-hidden");
        document.body.classList.add("overflow-hidden");
        authChecking?.classList.toggle("hidden", mode !== "checking");
        authLogin?.classList.toggle("hidden", mode !== "login");
        if (mode === "login") {
          setSyncStatus("idle", "Sessão não iniciada");
          window.setTimeout(() => {
            if (!loginEmail.value) loginEmail.focus();
            else loginPassword.focus();
          }, 60);
        }
      }

      function hideAuthGate() {
        if (!authGate) return;
        authGate.classList.add("hidden");
        authGate.setAttribute("aria-hidden", "true");
        document.body.classList.remove("overflow-hidden");
      }

      function showSession(email: string) {
        if (sessionEmailEl) sessionEmailEl.textContent = email;
        if (sessionChip) {
          sessionChip.classList.remove("hidden");
          sessionChip.classList.add("flex");
        }
      }

      function clearSession() {
        if (sessionEmailEl) sessionEmailEl.textContent = "—";
        if (sessionChip) {
          sessionChip.classList.add("hidden");
          sessionChip.classList.remove("flex");
        }
      }

      function showLoginError(message: string) {
        if (!loginError || !loginErrorText) return;
        loginErrorText.textContent = message;
        loginError.classList.remove("hidden");
        loginError.classList.add("flex");
      }

      function hideLoginError() {
        if (!loginError) return;
        loginError.classList.add("hidden");
        loginError.classList.remove("flex");
      }

      function friendlyAuthError(err: unknown): string {
        const raw = err instanceof Error ? err.message : String(err ?? "");
        const msg = raw.toLowerCase();
        if (msg.includes("invalid login credentials") || msg.includes("invalid_grant")) {
          return "E-mail ou senha incorretos. Confira os dados e tente novamente.";
        }
        if (msg.includes("email not confirmed")) {
          return "Este e-mail ainda não foi confirmado. Verifique a caixa de entrada do administrador.";
        }
        if (msg.includes("too many requests") || msg.includes("rate limit")) {
          return "Muitas tentativas seguidas. Aguarde alguns instantes e tente de novo.";
        }
        if (msg.includes("failed to fetch") || msg.includes("networkerror") || msg.includes("load failed")) {
          return "Não foi possível conectar ao servidor de autenticação. Verifique sua conexão.";
        }
        if (msg.includes("invalid email")) {
          return "Informe um e-mail válido.";
        }
        return raw || "Não foi possível entrar. Tente novamente.";
      }

      /** Erros de escrita: RLS, sessão expirada e validação do banco. */
      function friendlyWriteError(err: unknown): string {
        const raw = err instanceof Error ? err.message : String(err ?? "");
        const msg = raw.toLowerCase();
        if (msg.includes("row-level security") || msg.includes("permission denied") || msg.includes("42501")) {
          return "Sua conta não tem permissão para alterar o catálogo (RLS exige administrador). Fale com a administração.";
        }
        if (msg.includes("jwt") || msg.includes("invalid claim") || msg.includes("401")) {
          return "Sessão inválida ou expirada. Saia e entre novamente.";
        }
        if (msg.includes("duplicate key") || msg.includes("23505")) {
          return "Já existe um produto com este identificador. Recarregue a página e tente de novo.";
        }
        if (msg.includes("failed to fetch") || msg.includes("networkerror") || msg.includes("load failed")) {
          return "Sem conexão com o banco de dados. Verifique sua internet e tente novamente.";
        }
        return raw || "Não foi possível gravar no banco.";
      }

      /** Confirma no banco se a conta logada é administradora. `null` = não foi possível checar. */
      async function isAdminUser(): Promise<boolean | null> {
        if (!supabase) return null;
        try {
          const { data, error } = await (supabase as any).rpc("is_admin");
          if (error) return null;
          return data === true;
        } catch {
          return null;
        }
      }

      function setLoginBusy(busy: boolean) {
        if (!btnLogin) return;
        btnLogin.disabled = busy;
        loginSpinner?.classList.toggle("hidden", !busy);
        if (btnLoginLabel) btnLoginLabel.textContent = busy ? "Autenticando…" : "Entrar no Painel";
      }

      async function handleAuthenticated(email: string) {
        const admin = await isAdminUser();

        if (admin === false) {
          try {
            await signOut();
          } catch {
            // segue para o gate mesmo assim
          }
          clearSession();
          showAuthGate("login");
          showLoginError(
            "Esta conta está autenticada, mas não tem permissão de administrador. Use uma conta cadastrada em admin_users."
          );
          return;
        }

        hideAuthGate();
        showSession(email);
        await loadCatalog(false);
      }

      /* ------------------------------------------------------------------ */
      /* Catálogo                                                            */
      /* ------------------------------------------------------------------ */
      function renderTableLoading() {
        if (!tableBody) return;
        tableBody.innerHTML = `
          <tr>
            <td colspan="6" class="py-10 text-center text-[#7d7270] text-sm">
              <span class="inline-block size-4 rounded-full border-2 border-[#3e3432] border-t-[#d4af37] animate-spin align-middle mr-2"></span>
              Sincronizando catálogo com o banco…
            </td>
          </tr>
        `;
      }

      async function loadCatalog(announce: boolean) {
        setSyncStatus("loading", "Sincronizando");
        renderTableLoading();

        const reachable = await isRemoteReachable();

        try {
          const rows = unwrap<any[]>(await getProducts());
          const list = (Array.isArray(rows) ? rows : []).map(normalizeProduct).filter((p) => p.id && p.name);
          catalog = list;
          saveCatalogToStorage(catalog);

          if (reachable) {
            setSyncStatus("online", `Supabase · ${catalog.length} itens`);
            if (announce) {
              showToast(`Catálogo sincronizado com o banco (${catalog.length} produtos).`, "success");
            }
          } else {
            setSyncStatus("offline", "Modo offline · cópia local");
            if (announce) {
              showToast("Banco inacessível no momento. Exibindo a cópia local do catálogo.", "warning");
            }
          }
        } catch (err) {
          const cached = loadCatalogFromStorage<ProductItem>();
          catalog = cached && cached.length ? cached : initialProducts;
          setSyncStatus("offline", "Modo offline · cópia local");
          const detail = err instanceof Error && err.message ? ` (${err.message})` : "";
          showToast(`Sem conexão com o banco${detail}. Exibindo a cópia local do catálogo.`, "warning");
        }

        refreshUI();
      }

      function refreshUI() {
        updateStats();
        populateCategories();
        renderTable();
      }

      function updateStats() {
        if (!statTotalEl || !statCatEl || !statFeaturedEl || !statAvgEl) return;
        const total = catalog.length;
        const uniqueCats = new Set(catalog.map((p) => p.category));
        const featured = catalog.filter((p) => p.featured).length;
        const avg = total > 0 ? catalog.reduce((acc, p) => acc + p.price, 0) / total : 0;

        statTotalEl.textContent = String(total);
        statCatEl.textContent = String(uniqueCats.size);
        statFeaturedEl.textContent = String(featured);
        statAvgEl.textContent = `R$ ${avg.toFixed(2).replace(".", ",")}`;
      }

      function populateCategories() {
        if (!categorySelect || !formCat) return;
        const cats = Array.from(new Set(catalog.map((p) => p.category))).sort();

        const currentFilterSelected = categorySelect.value;
        categorySelect.innerHTML = '<option value="all">Todas as Categorias</option>';
        cats.forEach((cat) => {
          const opt = document.createElement("option");
          opt.value = cat;
          opt.textContent = `${cat} (${catalog.filter((p) => p.category === cat).length})`;
          categorySelect.appendChild(opt);
        });
        if (cats.includes(currentFilterSelected)) {
          categorySelect.value = currentFilterSelected;
        }

        const currentFormVal = formCat.value;
        formCat.innerHTML = "";
        cats.forEach((cat) => {
          const opt = document.createElement("option");
          opt.value = cat;
          opt.textContent = cat;
          formCat.appendChild(opt);
        });
        const customOpt = document.createElement("option");
        customOpt.value = "__custom__";
        customOpt.textContent = "+ Nova Categoria Personalizada...";
        formCat.appendChild(customOpt);

        if (cats.includes(currentFormVal)) {
          formCat.value = currentFormVal;
        }
      }

      function renderTable() {
        if (!tableBody) return;
        const term = (searchInput?.value || "").toLowerCase().trim();
        const selectedCat = categorySelect?.value || "all";

        const filtered = catalog.filter((p) => {
          const matchesTerm =
            !term ||
            p.name.toLowerCase().includes(term) ||
            p.id.toLowerCase().includes(term) ||
            (p.description || "").toLowerCase().includes(term);
          const matchesCat = selectedCat === "all" || p.category === selectedCat;
          return matchesTerm && matchesCat;
        });

        if (filteredCountEl) filteredCountEl.textContent = String(filtered.length);

        if (filtered.length === 0) {
          tableBody.innerHTML = `
            <tr>
              <td colspan="6" class="py-10 text-center text-[#7d7270]">
                ${catalog.length === 0 ? "Nenhum produto cadastrado no banco ainda." : "Nenhum produto colonial encontrado com esses filtros."}
              </td>
            </tr>
          `;
          return;
        }

        tableBody.innerHTML = filtered
          .map((prod) => {
            const imgSrc = escapeHtml(prod.image || "/images/shop/cosmic-products.png");
            return `
              <tr class="hover:bg-[#1a1717] transition-colors" data-id="${escapeHtml(prod.id)}">
                <td class="py-3 px-4">
                  <div class="w-12 h-12 rounded-lg bg-[#0d0c0c] border border-[#2d2422] p-1 flex items-center justify-center overflow-hidden">
                    <img src="${imgSrc}" alt="${escapeHtml(prod.name)}" class="w-full h-full object-contain" loading="lazy" onerror="this.src='/images/shop/cosmic-products.png'" />
                  </div>
                </td>
                <td class="py-3 px-4">
                  <div class="font-semibold text-white">${escapeHtml(prod.name)}</div>
                  <div class="text-xs text-[#7d7270] font-mono">ID: ${escapeHtml(prod.id)}</div>
                </td>
                <td class="py-3 px-4">
                  <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#241d1c] text-[#d5cbca] border border-[#3e3432]">
                    ${escapeHtml(prod.category)}
                  </span>
                </td>
                <td class="py-3 px-4 font-bold text-white">
                  R$ ${prod.price.toFixed(2).replace(".", ",")}
                </td>
                <td class="py-3 px-4">
                  ${
                    prod.featured
                      ? '<span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-400">Sim (Destaque)</span>'
                      : '<span class="text-xs text-[#5e5452]">Não</span>'
                  }
                </td>
                <td class="py-3 px-4 text-right">
                  <div class="inline-flex items-center gap-2">
                    <button
                      type="button"
                      class="btn-edit px-2.5 py-1 text-xs font-medium rounded bg-[#241d1c] hover:bg-[#342a29] text-[#d5cbca] transition"
                      data-id="${escapeHtml(prod.id)}"
                    >
                      Editar
                    </button>
                    <button
                      type="button"
                      class="btn-delete px-2.5 py-1 text-xs font-medium rounded bg-red-950/30 hover:bg-red-900/50 text-red-400 transition"
                      data-id="${escapeHtml(prod.id)}"
                    >
                      Excluir
                    </button>
                  </div>
                </td>
              </tr>
            `;
          })
          .join("");
      }

      /* ------------------------------------------------------------------ */
      /* Modal de produto                                                    */
      /* ------------------------------------------------------------------ */
      function updateImagePreview(label?: string) {
        const url = formImg?.value?.trim();
        if (url && imgPreview && imgPlaceholder) {
          imgPreview.src = url;
          imgPreview.classList.remove("hidden");
          imgPlaceholder.classList.add("hidden");
          if (imgStatusBadge) imgStatusBadge.textContent = label || "Foto selecionada";
          if (imgPathDisplay) imgPathDisplay.textContent = url.startsWith("data:") ? "[Imagem carregada do dispositivo]" : url;
          btnClearImg?.classList.remove("hidden");
        } else if (imgPreview && imgPlaceholder) {
          imgPreview.classList.add("hidden");
          imgPlaceholder.classList.remove("hidden");
          if (imgStatusBadge) imgStatusBadge.textContent = "Nenhuma foto selecionada";
          if (imgPathDisplay) imgPathDisplay.textContent = "Clique acima para carregar ou escolher";
          btnClearImg?.classList.add("hidden");
        }
      }

      function openModal(prod?: ProductItem) {
        if (!modal || !productForm) return;
        populateCategories();

        if (prod) {
          if (modalTitle) modalTitle.textContent = "Editar Produto Colonial";
          formId.value = prod.id;
          formName.value = prod.name;
          formPrice.value = String(prod.price);
          formImg.value = prod.image || "";
          formDesc.value = prod.description || "";
          formFeatured.checked = Boolean(prod.featured);

          const hasCat = Array.from(formCat.options).some((o) => o.value === prod.category);
          if (hasCat) {
            formCat.value = prod.category;
            formCatCustom.classList.add("hidden");
            formCatCustom.value = "";
          } else {
            formCat.value = "__custom__";
            formCatCustom.classList.remove("hidden");
            formCatCustom.value = prod.category;
          }

          const badgeVal = prod.badge || "";
          const hasBadge = Array.from(formBadge.options).some((o) => o.value === badgeVal);
          if (hasBadge) {
            formBadge.value = badgeVal;
            formBadgeCustom.classList.add("hidden");
            formBadgeCustom.value = "";
          } else {
            formBadge.value = "__custom__";
            formBadgeCustom.classList.remove("hidden");
            formBadgeCustom.value = badgeVal;
          }
        } else {
          if (modalTitle) modalTitle.textContent = "Adicionar Novo Produto Colonial";
          productForm.reset();
          formId.value = "tche-" + Date.now();
          formPrice.value = "15.00";
          formImg.value = "";
          if (formCat.options.length > 0) formCat.selectedIndex = 0;
          formCatCustom.classList.add("hidden");
          formCatCustom.value = "";
          formBadge.value = "";
          formBadgeCustom.classList.add("hidden");
          formBadgeCustom.value = "";
        }

        manualUrlContainer.classList.add("hidden");
        updateImagePreview();
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        window.setTimeout(() => formName?.focus(), 60);
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }

      formCat?.addEventListener("change", () => {
        if (formCat.value === "__custom__") {
          formCatCustom.classList.remove("hidden");
          formCatCustom.focus();
        } else {
          formCatCustom.classList.add("hidden");
          formCatCustom.value = "";
        }
      });

      formBadge?.addEventListener("change", () => {
        if (formBadge.value === "__custom__") {
          formBadgeCustom.classList.remove("hidden");
          formBadgeCustom.focus();
        } else {
          formBadgeCustom.classList.add("hidden");
          formBadgeCustom.value = "";
        }
      });

      formFileInput?.addEventListener("change", () => {
        const file = formFileInput.files?.[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (e) => {
            const dataUrl = e.target?.result as string;
            formImg.value = dataUrl;
            updateImagePreview(`Arquivo: ${file.name} (${Math.round(file.size / 1024)} KB)`);
            showToast(`Foto "${file.name}" carregada com sucesso.`, "success");
          };
          reader.readAsDataURL(file);
        }
      });

      btnClearImg?.addEventListener("click", () => {
        formImg.value = "";
        if (formFileInput) formFileInput.value = "";
        updateImagePreview();
      });

      document.getElementById("btn-toggle-manual-url")?.addEventListener("click", () => {
        manualUrlContainer.classList.toggle("hidden");
        if (!manualUrlContainer.classList.contains("hidden")) {
          formImg.focus();
        }
      });
      formImg?.addEventListener("input", () => updateImagePreview("URL digitada manualmente"));

      /* ------------------------------------------------------------------ */
      /* Galeria de fotos                                                    */
      /* ------------------------------------------------------------------ */
      function openGallery() {
        if (!galleryModal) return;
        galleryModal.classList.remove("hidden");
        galleryModal.classList.add("flex");
        renderGalleryItems(availableUploads);
      }

      function closeGallery() {
        if (!galleryModal) return;
        galleryModal.classList.add("hidden");
        galleryModal.classList.remove("flex");
      }

      function renderGalleryItems(list: string[]) {
        if (!galleryGrid || !galleryStatusCount) return;
        galleryStatusCount.textContent = `Mostrando ${list.length} de ${availableUploads.length} fotos disponíveis`;

        if (list.length === 0) {
          galleryGrid.innerHTML = `
            <div class="col-span-full py-12 text-center text-[#7d7270] text-sm">
              Nenhuma imagem encontrada com esse termo de busca.
            </div>
          `;
          return;
        }

        galleryGrid.innerHTML = list
          .map((imgPath) => {
            const fileName = imgPath.split("/").pop() || "";
            return `
              <button
                type="button"
                data-img-src="${escapeHtml(imgPath)}"
                class="gallery-item group relative aspect-square rounded-xl bg-[#0d0c0c] border border-[#2d2422] hover:border-[#8b1b22] p-2 flex flex-col items-center justify-center overflow-hidden transition hover:scale-[1.03] text-left"
              >
                <img
                  src="${escapeHtml(imgPath)}"
                  alt="${escapeHtml(fileName)}"
                  class="w-full h-full object-contain mb-1"
                  loading="lazy"
                />
                <span class="absolute inset-x-0 bottom-0 bg-black/80 text-[10px] text-white px-1.5 py-0.5 truncate opacity-0 group-hover:opacity-100 transition">
                  ${escapeHtml(fileName)}
                </span>
              </button>
            `;
          })
          .join("");
      }

      galleryGrid?.addEventListener("click", (ev) => {
        const itemBtn = (ev.target as HTMLElement).closest<HTMLButtonElement>(".gallery-item");
        if (!itemBtn) return;
        const src = itemBtn.dataset.imgSrc;
        if (src) {
          formImg.value = src;
          const fileName = src.split("/").pop() || "Foto da Galeria";
          updateImagePreview(`Acervo da Loja: ${fileName}`);
          closeGallery();
          showToast(`Foto colonial selecionada: ${fileName}`, "success");
        }
      });

      gallerySearchInput?.addEventListener("input", () => {
        const query = (gallerySearchInput.value || "").toLowerCase().trim();
        const filtered = availableUploads.filter((p) => p.toLowerCase().includes(query));
        renderGalleryItems(filtered);
      });

      document.getElementById("btn-open-gallery")?.addEventListener("click", openGallery);
      document.getElementById("btn-close-gallery")?.addEventListener("click", closeGallery);
      document.getElementById("btn-cancel-gallery")?.addEventListener("click", closeGallery);

      document.getElementById("btn-open-add-modal")?.addEventListener("click", () => openModal());
      document.getElementById("btn-close-modal")?.addEventListener("click", closeModal);
      document.getElementById("btn-cancel-modal")?.addEventListener("click", closeModal);

      document.addEventListener("keydown", (ev) => {
        if (ev.key !== "Escape") return;
        if (galleryModal && !galleryModal.classList.contains("hidden")) closeGallery();
        else if (modal && !modal.classList.contains("hidden")) closeModal();
      });

      searchInput?.addEventListener("input", renderTable);
      categorySelect?.addEventListener("change", renderTable);

      /* ------------------------------------------------------------------ */
      /* Excluir produto                                                     */
      /* ------------------------------------------------------------------ */
      tableBody?.addEventListener("click", async (ev) => {
        const target = (ev.target as HTMLElement).closest<HTMLButtonElement>(".btn-edit, .btn-delete");
        if (!target || isBusy) return;
        const id = target.dataset.id;
        if (!id) return;

        if (target.classList.contains("btn-edit")) {
          const prod = catalog.find((p) => p.id === id);
          if (prod) openModal(prod);
          return;
        }

        const prod = catalog.find((p) => p.id === id);
        if (!prod) return;
        if (!confirm(`Tem certeza que deseja excluir o produto "${prod.name}"?\n\nA exclusão também remove o item do banco de dados.`)) return;

        isBusy = true;
        target.disabled = true;
        const previous = [...catalog];

        try {
          await deleteProduct(id);
          catalog = catalog.filter((p) => p.id !== id);
          saveCatalogToStorage(catalog);
          refreshUI();
          showToast(`Produto "${prod.name}" excluído do catálogo e do banco.`, "success");
        } catch (err) {
          catalog = previous;
          refreshUI();
          showToast(`Não foi possível excluir no banco. ${friendlyWriteError(err)}`, "error");
        } finally {
          isBusy = false;
          target.disabled = false;
        }
      });

      /* ------------------------------------------------------------------ */
      /* Criar / editar produto                                              */
      /* ------------------------------------------------------------------ */
      productForm?.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        if (isBusy) return;

        const id = formId.value.trim() || "tche-" + Date.now();
        const name = formName.value.trim();

        let category = formCat.value.trim();
        if (category === "__custom__") {
          category = formCatCustom.value.trim() || "Geral";
        }

        const price = parseFloat(formPrice.value) || 0;
        const image = formImg.value.trim() || "/images/shop/cosmic-products.png";
        const description = formDesc.value.trim();

        let badge: string | undefined = formBadge.value.trim();
        if (badge === "__custom__") {
          badge = formBadgeCustom.value.trim() || undefined;
        } else if (!badge) {
          badge = undefined;
        }

        const featured = formFeatured.checked;
        const existingIdx = catalog.findIndex((p) => p.id === id);
        const isEdit = existingIdx >= 0;

        const item: ProductItem = isEdit
          ? { ...catalog[existingIdx], name, category, price, image, description, badge, featured }
          : {
              id,
              name,
              category,
              price,
              regular_price: null,
              rating: 5.0,
              reviews: 1,
              image,
              description,
              badge: badge || "Novo",
              featured,
            };

        const submitBtn = productForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        const originalLabel = submitBtn?.textContent ?? "Salvar Alterações";
        isBusy = true;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Sincronizando…";
        }

        // Atualização otimista da UI (revertida se o banco recusar)
        const snapshot = [...catalog];
        if (isEdit) catalog[existingIdx] = item;
        else catalog.unshift(item);
        saveCatalogToStorage(catalog);
        refreshUI();

        try {
          if (isEdit) await updateProduct(id, toDbPayload(item));
          else await createProduct(toDbPayload(item));

          showToast(
            isEdit ? `"${name}" atualizado e sincronizado com o banco.` : `"${name}" adicionado e sincronizado com o banco.`,
            "success"
          );
          closeModal();
        } catch (err) {
          // Mantém o formulário aberto com os dados digitados para nova tentativa,
          // mas não deixa um produto "fantasma" só na tela.
          catalog = snapshot;
          saveCatalogToStorage(catalog);
          refreshUI();
          showToast(`Não foi possível gravar no banco. ${friendlyWriteError(err)}`, "error");
        } finally {
          isBusy = false;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalLabel;
          }
        }
      });

      /* ------------------------------------------------------------------ */
      /* Ações do cabeçalho                                                  */
      /* ------------------------------------------------------------------ */
      btnRefresh?.addEventListener("click", async () => {
        if (isBusy) return;
        isBusy = true;
        btnRefresh.disabled = true;
        await loadCatalog(true);
        btnRefresh.disabled = false;
        isBusy = false;
      });

      document.getElementById("btn-export-json")?.addEventListener("click", () => {
        const blob = new Blob([JSON.stringify(catalog, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `tcheemporiogaucho_catalogo_${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast("Arquivo JSON gerado e baixado.", "success");
      });

      /* ------------------------------------------------------------------ */
      /* Login / logout                                                      */
      /* ------------------------------------------------------------------ */
      loginForm?.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        hideLoginError();

        const email = loginEmail.value.trim();
        const password = loginPassword.value;

        if (!email || !email.includes("@")) {
          showLoginError("Informe um e-mail válido.");
          loginEmail.focus();
          return;
        }
        if (!password) {
          showLoginError("Informe a senha do administrador.");
          loginPassword.focus();
          return;
        }

        setLoginBusy(true);
        try {
          const result: any = unwrap<any>(await signIn(email, password));
          const user = result?.user ?? result;
          const authedEmail = user?.email || email;

          if (result && result.session === null && !user) {
            throw new Error("Sessão não iniciada.");
          }

          await handleAuthenticated(authedEmail);
          loginPassword.value = "";
          showToast(`Bem-vindo, ${authedEmail}.`, "success");
        } catch (err) {
          showLoginError(friendlyAuthError(err));
          loginPassword.select?.();
        } finally {
          setLoginBusy(false);
        }
      });

      btnTogglePassword?.addEventListener("click", () => {
        const showing = loginPassword.type === "text";
        loginPassword.type = showing ? "password" : "text";
        btnTogglePassword.setAttribute("aria-pressed", String(!showing));
        btnTogglePassword.setAttribute("aria-label", showing ? "Mostrar senha" : "Ocultar senha");
      });

      loginEmail?.addEventListener("input", hideLoginError);
      loginPassword?.addEventListener("input", hideLoginError);

      btnLogout?.addEventListener("click", async () => {
        if (isBusy) return;
        isBusy = true;
        btnLogout.disabled = true;
        try {
          await signOut();
        } catch {
          // mesmo se falhar no servidor, a UI volta para o gate
        } finally {
          clearSession();
          showAuthGate("login");
          showToast("Sessão encerrada. Até logo!", "info");
          isBusy = false;
          btnLogout.disabled = false;
        }
      });

      /* ------------------------------------------------------------------ */
      /* Inicialização                                                       */
      /* ------------------------------------------------------------------ */
      // Se o token expirar ou for revogado em outra aba, volta ao gate.
      onAuthStateChange((event) => {
        if (event === "SIGNED_OUT") {
          clearSession();
          setSyncStatus("idle", "Sessão encerrada");
          showAuthGate("login");
        }
      });

      (async function init() {
        document.body.classList.add("overflow-hidden");
        refreshUI();

        try {
          const user: any = unwrap<any>(await getCurrentUser());
          if (user && user.email) {
            await handleAuthenticated(user.email);
          } else {
            showAuthGate("login");
          }
        } catch (err) {
          showAuthGate("login");
          showLoginError("Não foi possível verificar a sessão. Faça login para continuar.");
        }
      })();
    </script>
  </body>
</html>
