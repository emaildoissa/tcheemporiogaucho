</style>

<script>
  import {
    loadCart,
    saveCart,
    loadWishlist,
    saveWishlist,
    loadCatalogFromStorage,
  } from "../lib/storefrontStorage";
  import type { Product } from "../data/products";

  const WHATSAPP_PHONE = "5551993257923";

  function initCatalogPage() {
    const embeddedCatalogEl = document.getElementById("embedded-catalog-json");
    const defaultCatalog: Product[] = JSON.parse(embeddedCatalogEl?.textContent || "[]");
    const customCatalog = loadCatalogFromStorage<Product>();
    const catalog: Product[] = customCatalog || defaultCatalog;

    const cart = loadCart(catalog.map((p) => p.id));
    let wishlist = loadWishlist();

    const toast = document.getElementById("catalog-toast");
    let toastTimer = 0;
    const showToast = (msg: string) => {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove("show"), 2200);
    };

    const formatBRL = (val: number) => `R$ ${val.toFixed(2).replace(".", ",")}`;

    // Filter elements
    const searchInput = document.getElementById("catalog-search-input") as HTMLInputElement;
    const clearSearchBtn = document.getElementById("clear-search-btn");
    const sortSelect = document.getElementById("catalog-sort-select") as HTMLSelectElement;
    const priceSlider = document.getElementById("price-range-slider") as HTMLInputElement;
    const priceDisplay = document.getElementById("price-range-display");
    const priceMinInput = document.getElementById("price-min-input") as HTMLInputElement;
    const priceMaxInput = document.getElementById("price-max-input") as HTMLInputElement;
    const onlyFeaturedCheckbox = document.getElementById("only-featured-checkbox") as HTMLInputElement;
    const categoryButtons = document.querySelectorAll<HTMLButtonElement>("[data-category]");
    const chipsContainer = document.getElementById("active-chips-container");
    const visibleCountEl = document.getElementById("visible-products-count");
    const emptyState = document.getElementById("catalog-empty-state");
    const grid = document.getElementById("catalog-products-grid");
    const resetSidebarBtn = document.getElementById("sidebar-reset-btn");
    const resetEmptyBtn = document.getElementById("empty-state-reset-btn");
    const activeFiltersBadge = document.getElementById("active-filters-badge");

    // State
    let selectedCategory = "all";
    let searchQuery = "";
    let minPrice = 0;
    let maxPrice = Number(priceSlider?.max || 300);
    let onlyFeatured = false;
    let currentSort = "featured";

    // Read URL params
    const urlParams = new URLSearchParams(window.location.search);
    const initialCat = urlParams.get("cat") || urlParams.get("categoria");
    if (initialCat) {
      selectedCategory = initialCat;
    }
    const initialQuery = urlParams.get("q") || urlParams.get("busca");
    if (initialQuery && searchInput) {
      searchQuery = initialQuery;
      searchInput.value = initialQuery;
    }

    // Direct WhatsApp Single Order
    const sendWhatsAppOrder = (productName: string, price: number) => {
      const text = `Olá Tchê Empório Gaúcho!\n\nTenho interesse no produto *${productName}* (${formatBRL(price)}).\n\nEstá disponível para pronta entrega ou retirada? Poderia me informar o valor do frete?`;
      const url = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(text)}`;
      window.open(url, "_blank");
    };

    // Cart Drawer Checkout
    const sendCartCheckout = () => {
      const entries = Object.entries(cart)
        .map(([id, qty]) => ({ item: catalog.find((p) => p.id === id), qty }))
        .filter((e): e is { item: Product; qty: number } => Boolean(e.item));

      if (!entries.length) {
        showToast("Sua sacola está vazia.");
        return;
      }

      let msg = `Olá Tchê Empório Gaúcho!\n\nGostaria de fazer o pedido dos seguintes produtos do catálogo:\n\n`;
      let total = 0;
      entries.forEach((e) => {
        const sub = e.item.price * e.qty;
        total += sub;
        msg += `• ${e.qty}x ${e.item.name} (${formatBRL(e.item.price)}) = ${formatBRL(sub)}\n`;
      });
      msg += `\n*Total Estimado: ${formatBRL(total)}*\n\nPor favor, confirme a disponibilidade e o valor do frete para o meu CEP.`;

      const url = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(msg)}`;
      window.open(url, "_blank");
    };

    const renderCart = () => {
      const entries = Object.entries(cart)
        .map(([id, qty]) => ({ item: catalog.find((p) => p.id === id), qty }))
        .filter((e): e is { item: Product; qty: number } => Boolean(e.item));

      const totalQty = entries.reduce((acc, e) => acc + e.qty, 0);
      const totalPrice = entries.reduce((acc, e) => acc + e.item.price * e.qty, 0);

      const countBadge = document.getElementById("cart-drawer-count-badge");
      const floatingCount = document.getElementById("floating-cart-count");
      const subtotalEl = document.getElementById("cart-drawer-subtotal");
      const itemsList = document.getElementById("cart-drawer-items-list");

      if (countBadge) countBadge.textContent = String(totalQty);
      if (floatingCount) floatingCount.textContent = String(totalQty);
      if (subtotalEl) subtotalEl.textContent = formatBRL(totalPrice);

      if (itemsList) {
        itemsList.innerHTML = entries.length
          ? entries
              .map(
                (e) =>
                  `<div class="cart-item-row">
                    <div>
                      <b>${e.item.name}</b>
                      <small>${formatBRL(e.item.price)} × ${e.qty}</small>
                    </div>
                    <button type="button" data-cart-remove="${e.item.id}" aria-label="Remover item">
                      Remover
                    </button>
                  </div>`
              )
              .join("")
          : `<p class="empty-cart-text">Sua sacola está vazia.</p>`;
      }

      saveCart(cart);
    };

    // Filter and Sort Engine
    const applyFiltersAndSort = () => {
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>(".catalog-product-card"));

      let visibleCount = 0;
      let activeFilterCount = 0;

      if (selectedCategory !== "all") activeFilterCount++;
      if (searchQuery) activeFilterCount++;
      if (maxPrice < Number(priceSlider?.max || 300) || minPrice > 0) activeFilterCount++;
      if (onlyFeatured) activeFilterCount++;

      if (activeFiltersBadge) {
        if (activeFilterCount > 0) {
          activeFiltersBadge.textContent = String(activeFilterCount);
          activeFiltersBadge.style.display = "inline-block";
        } else {
          activeFiltersBadge.style.display = "none";
        }
      }

      // Filter each card
      cards.forEach((card) => {
        const cat = card.dataset.productCategory || "";
        const name = card.dataset.productName || "";
        const price = parseFloat(card.dataset.productPrice || "0");
        const featured = card.dataset.productFeatured === "true";

        const matchesCat = selectedCategory === "all" || cat.toLowerCase() === selectedCategory.toLowerCase();
        const matchesSearch =
          !searchQuery ||
          name.includes(searchQuery) ||
          cat.toLowerCase().includes(searchQuery);
        const matchesPrice = price >= minPrice && price <= maxPrice;
        const matchesFeatured = !onlyFeatured || featured;

        if (matchesCat && matchesSearch && matchesPrice && matchesFeatured) {
          card.style.display = "flex";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      // Sort visible cards
      cards.sort((a, b) => {
        const priceA = parseFloat(a.dataset.productPrice || "0");
        const priceB = parseFloat(b.dataset.productPrice || "0");
        const nameA = a.dataset.productName || "";
        const nameB = b.dataset.productName || "";
        const ratingA = parseFloat(a.dataset.productRating || "5");
        const ratingB = parseFloat(b.dataset.productRating || "5");
        const featA = a.dataset.productFeatured === "true" ? 1 : 0;
        const featB = b.dataset.productFeatured === "true" ? 1 : 0;

        switch (currentSort) {
          case "price-asc":
            return priceA - priceB;
          case "price-desc":
            return priceB - priceA;
          case "name-asc":
            return nameA.localeCompare(nameB);
          case "name-desc":
            return nameB.localeCompare(nameA);
          case "rating-desc":
            return ratingB - ratingA;
          case "featured":
          default:
            return featB - featA;
        }
      });

      // Re-append sorted cards
      cards.forEach((card) => grid.appendChild(card));

      // Update counters & empty state
      if (visibleCountEl) visibleCountEl.textContent = String(visibleCount);
      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? "block" : "none";
      }

      // Update category active styles
      categoryButtons.forEach((btn) => {
        const cat = btn.dataset.category || "all";
        if (cat.toLowerCase() === selectedCategory.toLowerCase()) {
          btn.classList.add("active");
        } else {
          btn.classList.remove("active");
        }
      });

      // Update Chips
      renderActiveChips();
    };

    const renderActiveChips = () => {
      if (!chipsContainer) return;
      const chips: string[] = [];

      if (selectedCategory !== "all") {
        chips.push(
          `<span class="active-chip">Categoria: ${selectedCategory} <button type="button" class="chip-remove-btn" data-remove-chip="category">✕</button></span>`
        );
      }
      if (searchQuery) {
        chips.push(
          `<span class="active-chip">Busca: "${searchQuery}" <button type="button" class="chip-remove-btn" data-remove-chip="search">✕</button></span>`
        );
      }
      if (maxPrice < Number(priceSlider?.max || 300) || minPrice > 0) {
        chips.push(
          `<span class="active-chip">R$ ${minPrice} a R$ ${maxPrice} <button type="button" class="chip-remove-btn" data-remove-chip="price">✕</button></span>`
        );
      }
      if (onlyFeatured) {
        chips.push(
          `<span class="active-chip">Apenas Destaques <button type="button" class="chip-remove-btn" data-remove-chip="featured">✕</button></span>`
        );
      }

      chipsContainer.innerHTML = chips.join("");
    };

    const resetAllFilters = () => {
      selectedCategory = "all";
      searchQuery = "";
      minPrice = 0;
      maxPrice = Number(priceSlider?.max || 300);
      onlyFeatured = false;
      currentSort = "featured";

      if (searchInput) searchInput.value = "";
      if (clearSearchBtn) clearSearchBtn.style.display = "none";
      if (sortSelect) sortSelect.value = "featured";
      if (priceSlider) priceSlider.value = String(maxPrice);
      if (priceMinInput) priceMinInput.value = "0";
      if (priceMaxInput) priceMaxInput.value = String(maxPrice);
      if (priceDisplay) priceDisplay.textContent = `Até R$ ${maxPrice},00`;
      if (onlyFeaturedCheckbox) onlyFeaturedCheckbox.checked = false;

      // Update URL query string silently
      const url = new URL(window.location.href);
      url.search = "";
      window.history.replaceState({}, "", url.toString());

      applyFiltersAndSort();
    };

    // Category click
    categoryButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        selectedCategory = btn.dataset.category || "all";
        applyFiltersAndSort();
      });
    });

    // Search input
    searchInput?.addEventListener("input", () => {
      searchQuery = searchInput.value.toLowerCase().trim();
      if (clearSearchBtn) {
        clearSearchBtn.style.display = searchQuery ? "block" : "none";
      }
      applyFiltersAndSort();
    });

    clearSearchBtn?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      searchQuery = "";
      clearSearchBtn.style.display = "none";
      applyFiltersAndSort();
    });

    // Sort select
    sortSelect?.addEventListener("change", () => {
      currentSort = sortSelect.value;
      applyFiltersAndSort();
    });

    // Price Slider & Inputs
    priceSlider?.addEventListener("input", () => {
      maxPrice = Number(priceSlider.value);
      if (priceMaxInput) priceMaxInput.value = String(maxPrice);
      if (priceDisplay) priceDisplay.textContent = `Até R$ ${maxPrice},00`;
      applyFiltersAndSort();
    });

    priceMinInput?.addEventListener("change", () => {
      minPrice = Math.max(0, Number(priceMinInput.value) || 0);
      applyFiltersAndSort();
    });

    priceMaxInput?.addEventListener("change", () => {
      maxPrice = Math.min(Number(priceSlider?.max || 300), Number(priceMaxInput.value) || 300);
      if (priceSlider) priceSlider.value = String(maxPrice);
      if (priceDisplay) priceDisplay.textContent = `Até R$ ${maxPrice},00`;
      applyFiltersAndSort();
    });

    // Featured checkbox
    onlyFeaturedCheckbox?.addEventListener("change", () => {
      onlyFeatured = onlyFeaturedCheckbox.checked;
      applyFiltersAndSort();
    });

    // Reset buttons
    resetSidebarBtn?.addEventListener("click", resetAllFilters);
    resetEmptyBtn?.addEventListener("click", resetAllFilters);

    // Chip removals
    chipsContainer?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-remove-chip]");
      if (!btn) return;
      const type = btn.dataset.removeChip;
      if (type === "category") selectedCategory = "all";
      if (type === "search") {
        searchQuery = "";
        if (searchInput) searchInput.value = "";
        if (clearSearchBtn) clearSearchBtn.style.display = "none";
      }
      if (type === "price") {
        minPrice = 0;
        maxPrice = Number(priceSlider?.max || 300);
        if (priceSlider) priceSlider.value = String(maxPrice);
        if (priceMinInput) priceMinInput.value = "0";
        if (priceMaxInput) priceMaxInput.value = String(maxPrice);
        if (priceDisplay) priceDisplay.textContent = `Até R$ ${maxPrice},00`;
      }
      if (type === "featured") {
        onlyFeatured = false;
        if (onlyFeaturedCheckbox) onlyFeaturedCheckbox.checked = false;
      }
      applyFiltersAndSort();
    });

    // Mobile Sidebar Drawer
    const sidebar = document.getElementById("catalog-sidebar");
    const backdrop = document.getElementById("sidebar-backdrop");
    const openSidebarBtn = document.getElementById("mobile-filter-open-btn");
    const closeSidebarBtn = document.getElementById("mobile-filter-close-btn");

    const toggleSidebar = (open: boolean) => {
      if (!sidebar || !backdrop) return;
      if (open) {
        sidebar.classList.add("mobile-open");
        backdrop.classList.add("active");
      } else {
        sidebar.classList.remove("mobile-open");
        backdrop.classList.remove("active");
      }
    };

    openSidebarBtn?.addEventListener("click", () => toggleSidebar(true));
    closeSidebarBtn?.addEventListener("click", () => toggleSidebar(false));
    backdrop?.addEventListener("click", () => toggleSidebar(false));

    // Wishlist sync
    const updateWishlistUI = () => {
      document.querySelectorAll<HTMLElement>("[data-wish-id]").forEach((btn) => {
        const id = btn.dataset.wishId;
        if (id) {
          btn.setAttribute("aria-pressed", String(wishlist.includes(id)));
        }
      });
    };
    updateWishlistUI();

    // QuickView Modal
    const modal = document.getElementById("catalog-quickview-modal") as HTMLDialogElement;
    const modalContent = document.getElementById("modal-content-container");
    const modalCloseBtn = document.getElementById("modal-close-btn");

    const openQuickView = (prodId: string) => {
      const prod = catalog.find((p) => p.id === prodId);
      if (!prod || !modal || !modalContent) return;

      const imgSrc = prod.image || "/images/shop/cosmic-products.png";
      modalContent.innerHTML = `
        <div class="modal-product-layout">
          <div class="modal-img-wrap">
            <img src="${imgSrc}" alt="${prod.name}" onerror="this.src='/images/shop/cosmic-products.png'" />
          </div>
          <div class="modal-details">
            <p class="modal-cat-tag">${prod.category}</p>
            <h2>${prod.name}</h2>
            <span class="modal-price-val">${formatBRL(prod.price)}</span>
            <p class="modal-desc-txt">${prod.description}</p>
            <div class="modal-actions-box">
              <button class="btn-order-wa" type="button" data-modal-wa data-name="${prod.name}" data-price="${prod.price}">
                💬 Pedir no WhatsApp
              </button>
              <button class="btn-add-cart" type="button" data-modal-cart data-id="${prod.id}" data-name="${prod.name}">
                + Sacola
              </button>
            </div>
          </div>
        </div>
      `;
      modal.showModal();
    };

    modalCloseBtn?.addEventListener("click", () => modal?.close());
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });

    // Cart Drawer
    const cartDrawer = document.getElementById("catalog-cart-drawer");
    const floatingCartBtn = document.getElementById("floating-cart-trigger");
    const closeCartBtn = document.getElementById("cart-drawer-close-btn");
    const continueBtn = document.getElementById("cart-continue-btn");
    const checkoutWaBtn = document.getElementById("cart-checkout-wa-btn");

    const toggleCart = (open: boolean) => {
      if (!cartDrawer) return;
      if (open) {
        cartDrawer.classList.add("open");
        cartDrawer.setAttribute("aria-hidden", "false");
      } else {
        cartDrawer.classList.remove("open");
        cartDrawer.setAttribute("aria-hidden", "true");
      }
    };

    floatingCartBtn?.addEventListener("click", () => toggleCart(true));
    closeCartBtn?.addEventListener("click", () => toggleCart(false));
    continueBtn?.addEventListener("click", () => toggleCart(false));
    checkoutWaBtn?.addEventListener("click", sendCartCheckout);

    // Global click listener for cards, cart, and modals
    document.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>(
        "[data-whatsapp-order], [data-cart-add], [data-wish-id], [data-quickview-trigger], [data-cart-remove], [data-modal-wa], [data-modal-cart]"
      );
      if (!target) return;

      if (target.matches("[data-whatsapp-order]")) {
        const name = target.dataset.name || "Produto";
        const price = parseFloat(target.dataset.price || "0");
        sendWhatsAppOrder(name, price);
      } else if (target.matches("[data-cart-add]")) {
        const id = target.dataset.id;
        const name = target.dataset.name || "Produto";
        if (!id) return;
        cart[id] = (cart[id] || 0) + 1;
        renderCart();
        showToast(`${name} adicionado à sacola!`);
      } else if (target.matches("[data-wish-id]")) {
        const id = target.dataset.wishId;
        if (!id) return;
        const exists = wishlist.includes(id);
        wishlist = exists ? wishlist.filter((item) => item !== id) : [...wishlist, id];
        saveWishlist(wishlist);
        updateWishlistUI();
        showToast(exists ? "Removido dos favoritos" : "Salvo nos seus favoritos");
      } else if (target.matches("[data-quickview-trigger]")) {
        const id = target.getAttribute("data-quickview-trigger");
        if (id) openQuickView(id);
      } else if (target.matches("[data-cart-remove]")) {
        const id = target.getAttribute("data-cart-remove");
        if (id && cart[id]) {
          delete cart[id];
          renderCart();
          showToast("Item removido da sacola.");
        }
      } else if (target.matches("[data-modal-wa]")) {
        const name = target.dataset.name || "Produto";
        const price = parseFloat(target.dataset.price || "0");
        sendWhatsAppOrder(name, price);
      } else if (target.matches("[data-modal-cart]")) {
        const id = target.dataset.id;
        const name = target.dataset.name || "Produto";
        if (id) {
          cart[id] = (cart[id] || 0) + 1;
          renderCart();
          showToast(`${name} adicionado à sacola!`);
        }
      }
    });

    renderCart();
    applyFiltersAndSort();
  }

  // Initialize
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCatalogPage);
  } else {
    initCatalogPage();
  }
  document.addEventListener("astro:page-load", initCatalogPage);
</script>
