---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  image?: string;
}

const {
  eyebrow = "Tradição Colonial & Artesanal",
  title = "O Autêntico Sabor do Rio Grande",
  description = "Vinhos finos, espumantes, embutidos coloniais, queijos, doces e chimias produzidos com o carinho e as receitas da Serra Gaúcha.",
  primaryCta = { label: "Ver Produtos", href: "#produtos" },
  secondaryCta = { label: "Falar no WhatsApp", href: "https://wa.me/5551993257923?text=Ol%C3%A1%20Tch%C3%AA%20Emp%C3%B3rio!%20Gostaria%20de%20tirar%20d%C3%BAvidas%20sobre%20o%20cat%C3%A1logo." },
  image = "/uploads/2025/11/mesa-com-comidas-2.png",
} = Astro.props;
---

<section
  class="hero"
  style={`--hero-image:url('${image}');--hero-image-position:center center;--hero-split:1fr 1.35fr;--hero-height:580px;--hero-content-width:520px;--hero-heading-size:clamp(2.6rem, 4.5vw, 3.8rem);--hero-accent:var(--commerce-accent);--hero-align:left`}
>
  <div class="inner">
    <div class="copy" data-mos="fade-right">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="description">{description}</p>
      <div class="actions">
        <a href={primaryCta.href}>{primaryCta.label}</a>
        <a href={secondaryCta.href} target="_blank" class="secondary">{secondaryCta.label}</a>
      </div>
    </div>
    <div
      class="visual"
      aria-label="Mesa farta de produtos coloniais gaúchos"
      data-mos="fade-left"
      role="img"
    >
    </div>
  </div>
</section>

<style>
  .hero {
    height: var(--hero-height);
    background: var(--commerce-background);
    color: var(--commerce-foreground);
    margin-bottom: 36px;
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--commerce-border);
  }
  .inner {
    grid-template-columns: var(--hero-split);
    height: 100%;
    margin: 0 auto;
    display: grid;
  }
  .copy {
    justify-content: center;
    align-items: var(--hero-align);
    padding: clamp(2rem, 5vw, 4rem);
    z-index: 1;
    display: flex;
    flex-direction: column;
    background: linear-gradient(90deg, var(--commerce-surface) 75%, transparent);
  }
  .eyebrow {
    color: var(--commerce-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 11px;
    font-weight: 700;
    margin: 0 0 10px;
  }
  h1 {
    font-size: var(--hero-heading-size);
    line-height: 1.1;
    margin: 0 0 16px;
    letter-spacing: -0.03em;
    font-weight: 800;
    max-width: var(--hero-content-width);
  }
  .description {
    color: var(--commerce-muted);
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 24px;
    max-width: var(--hero-content-width);
  }
  .actions {
    display: flex;
    gap: 12px;
  }
  .actions a {
    background: var(--commerce-accent);
    color: #fff;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .actions a:hover {
    background: var(--commerce-accent-hover);
    transform: translateY(-2px);
  }
  .actions a.secondary {
    background: transparent;
    border: 1px solid var(--commerce-border);
    color: var(--commerce-foreground);
  }
  .actions a.secondary:hover {
    border-color: var(--commerce-accent);
    color: var(--commerce-accent);
  }
  .visual {
    background: var(--hero-image) var(--hero-image-position) / cover no-repeat;
    height: 100%;
  }

  @media (max-width: 860px) {
    .hero {
      height: auto;
    }
    .inner {
      grid-template-columns: 1fr;
    }
    .copy {
      background: var(--commerce-surface);
      padding: 32px 24px;
    }
    .visual {
      height: 280px;
    }
  }
</style>
