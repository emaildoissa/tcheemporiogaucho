---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import { products as defaultProducts } from "../data/products";

// Server-side category calculation
const categoriesList = Array.from(
  new Set(defaultProducts.map((p) => p.category).filter(Boolean))
).sort((a, b) => {
  const countA = defaultProducts.filter((p) => p.category === a).length;
  const countB = defaultProducts.filter((p) => p.category === b).length;
  return countB - countA; // Most populated categories first
});

const categoryCounts = defaultProducts.reduce((acc, p) => {
  acc[p.category] = (acc[p.category] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const maxPrice = Math.ceil(
  Math.max(...defaultProducts.map((p) => p.price || 0))
);
---

<BaseLayout
  title="Catálogo Completo de Produtos Coloniais — Tchê Empório Gaúcho"
  description="Explore mais de 220 produtos coloniais e artesanais do Rio Grande do Sul: vinhos finos, queijos, chimias, amendoins e embutidos. Peça direto no WhatsApp."
>
  <div
    class="catalog-page-container commerce-landing"
    style="--commerce-accent:#8b1b22;--commerce-accent-hover:#a52129;"
  >
    <AnnouncementBar text="Catálogo Completo • Peça diretamente pelo WhatsApp • Entregas para todo o Brasil" />

    <div class="catalog-wrapper">
      <!-- Breadcrumb & Top Bar -->
      <nav class="catalog-breadcrumbs" aria-label="Navegação estrutural">
        <a href="/">Início</a>
        <span class="sep">/</span>
        <span class="current">Catálogo de Produtos</span>
      </nav>

      <header class="catalog-page-header">
        <div class="header-text">
          <span class="catalog-badge-eyebrow">Tradição Gaúcha & Alta Qualidade</span>
          <h1>Catálogo Completo Tchê Empório Gaúcho</h1>
          <p>
            Vinhos finos da Serra, chimias tradicionais, embutidos artesanais, doces coloniais e petiscos selecionados.
          </p>
        </div>
        <div class="header-actions">
          <button
            type="button"
            id="mobile-filter-open-btn"
            class="mobile-filter-btn"
            aria-label="Abrir filtros laterais"
          >
            <span>⚡ Filtrar Catálogo</span>
            <span id="active-filters-badge" class="filters-badge" style="display: none;">0</span>
          </button>
          <a href="/admin" class="admin-btn-pill" title="Gerenciar produtos e preços">
            ⚙️ Painel Admin
          </a>
        </div>
      </header>

      <!-- Layout: Sidebar + Main Grid -->
      <div class="catalog-layout">
        <!-- Sidebar de Filtros -->
        <aside class="catalog-sidebar" id="catalog-sidebar" aria-label="Filtros do Catálogo">
          <div class="sidebar-header">
            <div class="sidebar-title">
              <span class="icon">🍷</span>
              <h3>Filtros</h3>
            </div>
            <button
              type="button"
              id="sidebar-reset-btn"
              class="reset-filters-btn"
              title="Limpar todos os filtros"
            >
              Limpar tudo
            </button>
            <button
              type="button"
              id="mobile-filter-close-btn"
              class="mobile-close-btn"
              aria-label="Fechar painel de filtros"
            >
              ✕
            </button>
          </div>

          <!-- Busca por texto -->
          <div class="filter-group">
            <label for="catalog-search-input" class="filter-label">Buscar Produto</label>
            <div class="search-input-wrap">
              <input
                type="text"
                id="catalog-search-input"
                placeholder="Ex: vinho tinto, chimia, queijo..."
                autocomplete="off"
              />
              <button
                type="button"
                id="clear-search-btn"
                class="clear-search-btn"
                style="display: none;"
                title="Limpar busca"
              >
                ✕
              </button>
            </div>
          </div>

          <!-- Ordenação -->
          <div class="filter-group">
            <label for="catalog-sort-select" class="filter-label">Ordenar Por</label>
            <select id="catalog-sort-select" class="filter-select">
              <option value="featured">Destaques e Mais Vendidos</option>
              <option value="price-asc">Menor Preço (R$ Crescente)</option>
              <option value="price-desc">Maior Preço (R$ Decrescente)</option>
              <option value="name-asc">Nome (A a Z)</option>
              <option value="name-desc">Nome (Z a A)</option>
              <option value="rating-desc">Mais Bem Avaliados (★)</option>
            </select>
          </div>

          <!-- Faixa de Preço -->
          <div class="filter-group">
            <div class="filter-label-row">
              <span class="filter-label">Faixa de Preço</span>
              <span id="price-range-display" class="price-range-val">Até R$ {maxPrice},00</span>
            </div>
            <input
              type="range"
              id="price-range-slider"
              class="price-slider"
              min="0"
              max={maxPrice}
              value={maxPrice}
              step="5"
            />
            <div class="price-inputs-row">
              <div class="price-input-box">
                <small>Mín (R$)</small>
                <input type="number" id="price-min-input" min="0" max={maxPrice} value="0" />
              </div>
              <span class="price-sep">—</span>
              <div class="price-input-box">
                <small>Máx (R$)</small>
                <input type="number" id="price-max-input" min="0" max={maxPrice} value={maxPrice} />
              </div>
            </div>
          </div>

          <!-- Filtro Especial: Apenas Mais Vendidos -->
          <div class="filter-group filter-checkbox-group">
            <label class="custom-checkbox">
              <input type="checkbox" id="only-featured-checkbox" />
              <span class="checkbox-box"></span>
              <span class="checkbox-text">Apenas Mais Vendidos / Selos</span>
            </label>
          </div>

          <!-- Categorias -->
          <div class="filter-group categories-group">
            <div class="filter-label-row">
              <span class="filter-label">Categorias</span>
              <span class="categories-total">{defaultProducts.length} itens</span>
            </div>

            <div class="categories-list" role="radiogroup" aria-label="Categorias">
              <button
                type="button"
                class="category-filter-item active"
                data-category="all"
              >
                <span class="cat-name">Todas as Categorias</span>
                <span class="cat-count">{defaultProducts.length}</span>
              </button>

              {
                categoriesList.map((cat) => (
                  <button
                    type="button"
                    class="category-filter-item"
                    data-category={cat}
                  >
                    <span class="cat-name">{cat}</span>
                    <span class="cat-count">{categoryCounts[cat] || 0}</span>
                  </button>
                ))
              }
            </div>
          </div>
        </aside>

        <!-- Backdrop mobile para a sidebar -->
        <div id="sidebar-backdrop" class="sidebar-backdrop"></div>

        <!-- Coluna Principal do Catálogo -->
        <main class="catalog-main">
          <!-- Barra de Status e Tags Ativas -->
          <div class="catalog-toolbar">
            <div class="results-counter">
              Mostrando <strong id="visible-products-count">{defaultProducts.length}</strong> de {defaultProducts.length} produtos
            </div>

            <div class="active-chips" id="active-chips-container">
              <!-- Chips gerados dinamicamente via JS -->
            </div>
          </div>

          <!-- Grid dos Produtos -->
          <div class="catalog-grid" id="catalog-products-grid">
            {
              defaultProducts.map((product) => (
                <article
                  class="catalog-product-card"
                  data-product-id={product.id}
                  data-product-name={product.name.toLowerCase()}
                  data-product-category={product.category}
                  data-product-price={product.price}
                  data-product-rating={product.rating || 5}
                  data-product-featured={product.featured ? "true" : "false"}
                >
                  {product.badge && <span class="product-badge">{product.badge}</span>}

                  <button
                    class="wish-btn"
                    type="button"
                    aria-label={`Salvar ${product.name}`}
                    aria-pressed="false"
                    data-wish-id={product.id}
                  >
                    <svg
                      height="18"
                      width="18"
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                    >
                      <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.7-7.5a5.5 5.5 0 0 0 1.1-8.9Z" />
                    </svg>
                  </button>

                  <div class="product-img-box" data-quickview-trigger={product.id}>
                    <img
                      src={product.image || "/images/shop/cosmic-products.png"}
                      alt={product.name}
                      loading="lazy"
                      onerror="this.src='/images/shop/cosmic-products.png'"
                    />
                  </div>

                  <div class="product-card-body">
                    <span class="product-cat-label">{product.category}</span>
                    <h3 class="product-title" data-quickview-trigger={product.id} title={product.name}>
                      {product.name}
                    </h3>

                    <div class="product-rating">
                      <span class="stars">★★★★★</span>
                      <small class="reviews-count">({product.reviews || 15})</small>
                    </div>

                    <div class="product-price-box">
                      <span class="product-price">
                        R$ {product.price.toFixed(2).replace(".", ",")}
                      </span>
                    </div>

                    <div class="product-card-buttons">
                      <button
                        type="button"
                        class="btn-order-wa"
                        data-whatsapp-order
                        data-id={product.id}
                        data-name={product.name}
                        data-price={product.price}
                      >
                        💬 WhatsApp
                      </button>
                      <button
                        type="button"
                        class="btn-add-cart"
                        data-cart-add
                        data-id={product.id}
                        data-name={product.name}
                        data-price={product.price}
                      >
                        + Sacola
                      </button>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <!-- Empty State -->
          <div id="catalog-empty-state" class="catalog-empty-state" style="display: none;">
            <div class="empty-icon">🧺</div>
            <h3>Nenhum produto encontrado</h3>
            <p>Não encontramos produtos com os filtros ou termo de busca selecionados.</p>
            <button type="button" id="empty-state-reset-btn" class="empty-reset-btn">
              Limpar Filtros e Ver Todos
            </button>
          </div>
        </main>
      </div>
    </div>

    <!-- Modal Detalhes do Produto -->
    <dialog class="catalog-modal" id="catalog-quickview-modal">
      <button class="modal-close" type="button" id="modal-close-btn" aria-label="Fechar modal">
        ✕
      </button>
      <div id="modal-content-container"></div>
    </dialog>

    <!-- Sacola Drawer Lateral -->
    <aside class="catalog-cart-drawer" id="catalog-cart-drawer" aria-hidden="true">
      <header class="cart-drawer-header">
        <h2>Sua Sacola <span id="cart-drawer-count-badge">0</span></h2>
        <button type="button" id="cart-drawer-close-btn" aria-label="Fechar sacola">✕</button>
      </header>
      <div class="cart-drawer-items" id="cart-drawer-items-list"></div>
      <footer class="cart-drawer-footer">
        <div class="cart-subtotal-row">
          <span>Subtotal</span>
          <strong id="cart-drawer-subtotal">R$ 0,00</strong>
        </div>
        <button type="button" id="cart-checkout-wa-btn" class="cart-checkout-btn">
          💬 Finalizar Pedido via WhatsApp
        </button>
        <button type="button" id="cart-continue-btn" class="cart-continue-btn">
          Continuar Escolhendo
        </button>
      </footer>
    </aside>

    <!-- Gatilho Flutuante da Sacola -->
    <button class="catalog-floating-cart-btn" id="floating-cart-trigger" aria-label="Abrir sacola de pedidos">
      <span>🛍️ Sacola</span>
      <span id="floating-cart-count" class="floating-badge">0</span>
    </button>

    <!-- Toast de Notificação -->
    <div id="catalog-toast" class="catalog-toast" role="status" aria-live="polite"></div>

    <!-- Catálogo embutido para sincronização e fallback -->
    <script type="application/json" id="embedded-catalog-json" set:html={JSON.stringify(defaultProducts)} />
  </div>
</BaseLayout>

<style>
  .catalog-page-container {
    padding-top: 76px;
    background: #08090a;
    color: #f2ede6;
    min-height: 100vh;
    font-family: Inter, system-ui, -apple-system, sans-serif;
  }
  .catalog-wrapper {
    max-width: 1440px;
    margin: 0 auto;
    padding: 24px 20px 80px;
  }

  /* Breadcrumbs */
  .catalog-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #8c827f;
    margin-bottom: 18px;
  }
  .catalog-breadcrumbs a {
    color: #bfb5b2;
    text-decoration: none;
    transition: color 0.2s;
  }
  .catalog-breadcrumbs a:hover {
    color: #e67e84;
  }
  .catalog-breadcrumbs .sep {
    color: #4a403d;
  }
  .catalog-breadcrumbs .current {
    color: #f2ede6;
    font-weight: 600;
  }

  /* Header */
  .catalog-page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px;
    padding-bottom: 24px;
    border-bottom: 1px solid #24201f;
    margin-bottom: 28px;
  }
  .catalog-badge-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #e67e84;
    margin-bottom: 6px;
  }
  .catalog-page-header h1 {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-weight: 800;
    color: #fff;
    margin: 0 0 8px;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .catalog-page-header p {
    font-size: 14px;
    color: #a39a97;
    margin: 0;
    max-width: 680px;
    line-height: 1.5;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .mobile-filter-btn {
    display: none;
    align-items: center;
    gap: 8px;
    background: #1c1817;
    border: 1px solid #3d3432;
    color: #fff;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }
  .mobile-filter-btn:hover {
    border-color: #8b1b22;
    background: #25201f;
  }
  .filters-badge {
    background: #8b1b22;
    color: #fff;
    padding: 2px 7px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 800;
  }
  .admin-btn-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid #362e2c;
    background: #141212;
    color: #d6ccc8;
    text-decoration: none;
    transition: all 0.2s;
  }
  .admin-btn-pill:hover {
    border-color: #8b1b22;
    color: #fff;
    background: #1f1b1a;
  }

  /* Layout */
  .catalog-layout {
    display: grid;
    grid-template-columns: 290px 1fr;
    gap: 32px;
    align-items: start;
  }

  /* Sidebar */
  .catalog-sidebar {
    background: #121010;
    border: 1px solid #262120;
    border-radius: 16px;
    padding: 22px;
    position: sticky;
    top: 92px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .catalog-sidebar::-webkit-scrollbar {
    width: 5px;
  }
  .catalog-sidebar::-webkit-scrollbar-thumb {
    background: #362e2c;
    border-radius: 10px;
  }
  .sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 14px;
    border-bottom: 1px solid #262120;
  }
  .sidebar-title {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sidebar-title .icon {
    font-size: 18px;
  }
  .sidebar-title h3 {
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }
  .reset-filters-btn {
    background: transparent;
    border: 0;
    color: #e67e84;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 0;
  }
  .reset-filters-btn:hover {
    color: #ff9da3;
  }
  .mobile-close-btn {
    display: none;
    background: transparent;
    border: 0;
    color: #a39a97;
    font-size: 20px;
    cursor: pointer;
  }

  /* Filter Groups */
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .filter-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .filter-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #bfb5b2;
  }
  .search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-input-wrap input {
    width: 100%;
    background: #1a1716;
    border: 1px solid #332b29;
    border-radius: 8px;
    color: #fff;
    padding: 9px 34px 9px 12px;
    font-size: 13px;
    outline: none;
    transition: border-color 0.2s;
  }
  .search-input-wrap input:focus {
    border-color: #8b1b22;
  }
  .clear-search-btn {
    position: absolute;
    right: 10px;
    background: transparent;
    border: 0;
    color: #8c827f;
    font-size: 14px;
    cursor: pointer;
  }
  .filter-select {
    width: 100%;
    background: #1a1716;
    border: 1px solid #332b29;
    border-radius: 8px;
    color: #fff;
    padding: 9px 12px;
    font-size: 13px;
    outline: none;
    cursor: pointer;
  }
  .filter-select:focus {
    border-color: #8b1b22;
  }

  /* Faixa de Preço */
  .price-range-val {
    font-size: 13px;
    font-weight: 700;
    color: #e67e84;
  }
  .price-slider {
    width: 100%;
    accent-color: #8b1b22;
    cursor: pointer;
    margin: 4px 0 8px;
  }
  .price-inputs-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .price-input-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .price-input-box small {
    font-size: 10px;
    color: #8c827f;
    text-transform: uppercase;
  }
  .price-input-box input {
    width: 100%;
    background: #1a1716;
    border: 1px solid #332b29;
    border-radius: 6px;
    color: #fff;
    padding: 6px 8px;
    font-size: 12px;
    outline: none;
  }
  .price-sep {
    color: #594d4a;
    font-size: 14px;
    margin-top: 14px;
  }

  /* Checkbox custom */
  .custom-checkbox {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;
  }
  .custom-checkbox input {
    display: none;
  }
  .checkbox-box {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #4a3e3b;
    background: #1a1716;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .custom-checkbox input:checked + .checkbox-box {
    background: #8b1b22;
    border-color: #8b1b22;
  }
  .custom-checkbox input:checked + .checkbox-box::after {
    content: "✓";
    font-size: 12px;
    color: #fff;
    font-weight: 800;
  }
  .checkbox-text {
    font-size: 13px;
    font-weight: 600;
    color: #d6ccc8;
  }

  /* Categorias */
  .categories-group {
    border-top: 1px solid #262120;
    padding-top: 18px;
  }
  .categories-total {
    font-size: 11px;
    color: #8c827f;
  }
  .categories-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 6px;
    max-height: 380px;
    overflow-y: auto;
    padding-right: 4px;
  }
  .categories-list::-webkit-scrollbar {
    width: 4px;
  }
  .categories-list::-webkit-scrollbar-thumb {
    background: #332b29;
    border-radius: 10px;
  }
  .category-filter-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 13px;
    color: #bfb5b2;
    text-align: left;
    cursor: pointer;
    transition: all 0.18s ease;
  }
  .category-filter-item:hover {
    background: #1c1817;
    color: #fff;
  }
  .category-filter-item.active {
    background: #2b1416;
    border-color: #8b1b22;
    color: #fff;
    font-weight: 700;
  }
  .category-filter-item.active .cat-name {
    color: #ff9da3;
  }
  .cat-count {
    font-size: 11px;
    color: #8c827f;
    background: #181514;
    padding: 2px 7px;
    border-radius: 10px;
    font-weight: 600;
  }
  .category-filter-item.active .cat-count {
    background: #8b1b22;
    color: #fff;
  }

  /* Main Area */
  .catalog-main {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Toolbar */
  .catalog-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    background: #121010;
    border: 1px solid #262120;
    border-radius: 12px;
    padding: 12px 18px;
  }
  .results-counter {
    font-size: 13px;
    color: #a39a97;
  }
  .results-counter strong {
    color: #fff;
  }
  .active-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .active-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #241c1b;
    border: 1px solid #4a3634;
    color: #f2ede6;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
  }
  .chip-remove-btn {
    background: transparent;
    border: 0;
    color: #e67e84;
    font-size: 13px;
