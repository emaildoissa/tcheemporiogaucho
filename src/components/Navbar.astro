---
const navLinks = [
  { label: "Início", href: "/" },
  { label: "Catálogo", href: "/catalogo" },
  { label: "Nossa Origem", href: "/#sustentabilidade" },
  { label: "Coleções", href: "/#colecoes" },
  { label: "Depoimentos", href: "/#depoimentos" },
  { label: "Painel Admin", href: "/admin" },
];
---

<div
  class="w-full flex duration-300 border-b fixed flex-col left-0 navbar--initial top-0 transition-all z-30"
  data-nav-container
>
  <div class="w-full flex mx-auto">
    <div class="w-full flex items-center h-16 sm:h-20 site-container">
      <header class="w-full flex items-center relative gap-4">
        <!-- Logo Principal Grande (Emblema Colonial Oficial) -->
        <div class="flex-auto flex justify-start items-center">
          <a
            href="/"
            class="inline-flex items-center gap-2 sm:gap-3.5 primary-focus text-foreground group py-1"
            aria-label="Início Tchê Empório Gaúcho"
          >
            <img
              src="/images/logo.png"
              alt="Logo Tchê Empório Gaúcho"
              class="h-9 sm:h-16 w-auto object-contain drop-shadow-md group-hover:scale-105 transition-transform duration-200"
            />
            <div class="flex flex-col">
              <span class="font-extrabold tracking-tight text-base sm:text-2xl text-[var(--foreground)] leading-none">
                Tchê Empório
              </span>
              <span class="hidden sm:block text-xs sm:text-sm font-semibold tracking-wider uppercase text-[var(--commerce-accent)] mt-0.5">
                Gaúcho • Tradição Colonial
              </span>
            </div>
          </a>
        </div>

        <div class="justify-end flex flex-auto items-center">
          <nav class="hidden md:block my-auto">
            <ul class="h-fit flex items-center px-2">
              {
                navLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="w-full flex items-center nav__link--base primary-focus py-2 rounded-md px-3 gap-1.5 h-10 relative font-semibold text-xs tracking-wide"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <a
            href="https://wa.me/5551993257923?text=Ol%C3%A1%20Tch%C3%AA%20Emp%C3%B3rio!%20Gostaria%20de%20tirar%20uma%20d%C3%BAvida%20sobre%20os%20produtos."
            target="_blank"
            class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold rounded-xl bg-[#166534] hover:bg-[#15803d] text-white transition shadow-sm mr-2"
          >
            <svg class="size-3.5 fill-current shrink-0 inline-block mr-1" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg><span>WhatsApp</span>
          </a>

          <!-- Seletor dos 2 Temas Finalistas na Navbar -->
          <div
            class="theme-nav-switcher inline-flex items-center rounded-xl p-0.5 bg-[var(--commerce-surface)] border border-[var(--commerce-border)] shadow-xs ml-1"
            role="group"
            aria-label="Alternar entre Adega e Farroupilha"
          >
            <button
              type="button"
              data-theme-pill="adega"
              title="1. Adega & Galpão (Dark Premium & Vinho Tinto)"
              class="px-2.5 py-1 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-[var(--commerce-muted)] hover:text-[var(--commerce-foreground)]"
            >
              <span class="inline-block size-2.5 rounded-full bg-[#8b1b22] border border-[#f59e0b]"></span>
              <span class="hidden sm:inline">Adega</span>
            </button>
            <button
              type="button"
              data-theme-pill="farroupilha"
              title="2. Farroupilha Tricolor (Cores da Bandeira do RS)"
              class="px-2.5 py-1 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-[var(--commerce-muted)] hover:text-[var(--commerce-foreground)]"
            >
              <span class="inline-block size-2.5 rounded-full bg-[#15803d] border border-[#facc15]"></span>
              <span class="hidden sm:inline">Farroupilha</span>
            </button>
          </div>

          <!-- Menu Mobile -->
          <div class="flex items-center md:hidden ml-2">
            <div id="mobile-nav__container">
              <button
                class="flex items-center justify-center p-2 rounded-lg primary-focus text-[var(--foreground)] border border-[var(--border)]"
                aria-label="Abrir menu de navegação"
                id="mobile-nav__burger"
                aria-expanded="false"
              >
                <svg
                  class="size-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.8"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                  ></path>
                </svg>
              </button>
              <div
                class="bg-[var(--commerce-surface)] border-l border-[var(--commerce-border)] fixed h-screen hidden overflow-y-auto right-0 top-0 w-72 z-20 shadow-2xl"
                id="mobile-nav__content"
              >
                <div class="p-6 flex flex-col h-full justify-between">
                  <div>
                    <div class="flex items-center justify-between pb-6 border-b border-[var(--commerce-border)]">
                      <div class="flex items-center gap-2.5">
                        <img
                          src="/images/logo.png"
                          alt="Logo Tchê Empório Gaúcho"
                          class="h-10 w-auto object-contain drop-shadow-sm"
                        />
                        <span class="font-bold text-[var(--foreground)] text-base">Tchê Empório</span>
                      </div>
                      <button
                        type="button"
                        id="mobile-nav__close"
                        class="text-[var(--muted-foreground)] hover:text-[var(--foreground)] text-xl"
                      >
                        ✕
                      </button>
                    </div>
                    <ul class="py-6 space-y-3">
                      {
                        navLinks.map((link) => (
                          <li>
                            <a
                              href={link.href}
                              class="block py-2 text-sm font-semibold text-[var(--foreground)] hover:text-[var(--commerce-accent)]"
                            >
                              {link.label}
                            </a>
                          </li>
                        ))
                      }
                    </ul>

                    <!-- Seletor de Temas no Mobile -->
                    <div class="py-4 border-t border-[var(--commerce-border)]">
                      <span class="text-xs font-bold uppercase tracking-wider text-[var(--commerce-muted)] mb-2 block">
                        Identidade Visual:
                      </span>
                      <div class="grid grid-cols-2 gap-2 text-center">
                        <button
                          type="button"
                          data-theme-pill="adega"
                          class="p-2.5 rounded-xl border border-[var(--commerce-border)] text-xs font-bold bg-[var(--commerce-surface-raised)]"
                        >
                          1. Adega
                        </button>
                        <button
                          type="button"
                          data-theme-pill="farroupilha"
                          class="p-2.5 rounded-xl border border-[var(--commerce-border)] text-xs font-bold bg-[var(--commerce-surface-raised)]"
                        >
                          2. Farroupilha
                        </button>
                      </div>
                    </div>
                  </div>
                  <div class="pt-6 border-t border-[var(--commerce-border)]">
                    <a
                      href="https://wa.me/5551993257923"
                      target="_blank"
                      class="w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-[#166534] text-white font-bold text-sm shadow-md"
                    >
                      <svg class="size-3.5 fill-current shrink-0 inline-block mr-1" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg> Falar no WhatsApp
                    </a>
                  </div>
                </div>
              </div>
              <button
                class="bg-black/60 fixed h-screen left-0 mobile-nav__backdrop--fade-out top-0 z-10 backdrop-blur-xs"
                aria-label="Fechar menu de navegação"
                id="mobile-nav__backdrop"
              ></button>
            </div>
          </div>
        </div>
      </header>
    </div>
  </div>
</div>

<style is:global>
  .mobile-nav__backdrop--fade-in {
    width: 100vw;
    animation: 0.3s ease-in-out forwards MobileNavFadeInAnimation;
    display: block;
  }
  .mobile-nav__backdrop--fade-out {
    opacity: 0;
    width: 0;
    display: none;
  }
  @keyframes MobileNavFadeInAnimation {
    0% {
      opacity: 0;
    }
    to {
      opacity: 0.4;
    }
  }
  .mobile-nav--slide-in {
    animation: 0.3s ease-in-out forwards mobileNavSlideInAnimation;
  }
  .mobile-nav--slide-out {
    animation: 0.3s ease-in-out forwards mobileNavSlideOutAnimation;
  }
  @keyframes mobileNavSlideInAnimation {
    0% {
      right: -18rem;
    }
    to {
      right: 0;
    }
  }
  @keyframes mobileNavSlideOutAnimation {
    0% {
      right: 0;
    }
    to {
      right: -18rem;
    }
  }
  .navbar--scrolled {
    background-color: var(--background);
    border-bottom-color: var(--border);
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.15);
  }
  .navbar--initial {
    background-color: color-mix(in srgb, var(--background) 92%, transparent);
    border-bottom-color: var(--border);
    backdrop-filter: blur(8px);
  }
</style>

<script>
  function initThemeSwitcher() {
    const pills = document.querySelectorAll<HTMLButtonElement>("[data-theme-pill]");

    function updateThemeUI(theme: string) {
      document.documentElement.setAttribute("data-theme", theme);
      localStorage.setItem("tche_theme", theme);
      localStorage.setItem("tche_home_theme", theme);

      if (theme === "adega") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }

      pills.forEach((pill) => {
        const pTheme = pill.getAttribute("data-theme-pill");
        if (pTheme === theme) {
          pill.classList.add("bg-[var(--commerce-accent)]", "text-white");
          pill.classList.remove("text-[var(--commerce-muted)]");
        } else {
          pill.classList.remove("bg-[var(--commerce-accent)]", "text-white");
          pill.classList.add("text-[var(--commerce-muted)]");
        }
      });

      // Se houver botões da barra de decisão na página:
      document.querySelectorAll<HTMLButtonElement>("[data-site-theme-select]").forEach((b) => {
        if (b.getAttribute("data-site-theme-select") === theme) {
          b.classList.add("is-active");
        } else {
          b.classList.remove("is-active");
        }
      });
    }

    const currentTheme = localStorage.getItem("tche_theme") || localStorage.getItem("tche_home_theme") || "adega";
    const normalized = currentTheme === "farroupilha" ? "farroupilha" : "adega";
    updateThemeUI(normalized);

    pills.forEach((pill) => {
      pill.onclick = () => {
        const theme = pill.getAttribute("data-theme-pill");
        if (theme) {
          updateThemeUI(theme);
        }
      };
    });
  }

  function initNavScroll() {
    const navContainer = document.querySelector("[data-nav-container]");
    const onScroll = () => {
      if (!navContainer) return;
      if (window.scrollY > 30) {
        navContainer.classList.add("navbar--scrolled");
        navContainer.classList.remove("navbar--initial");
      } else {
        navContainer.classList.add("navbar--initial");
        navContainer.classList.remove("navbar--scrolled");
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  function initMobileNav() {
    const container = document.getElementById("mobile-nav__container");
    const burger = document.getElementById("mobile-nav__burger");
    const content = document.getElementById("mobile-nav__content");
    const closeBtn = document.getElementById("mobile-nav__close");
    const backdrop = document.getElementById("mobile-nav__backdrop");

    const toggleMobile = (e: Event) => {
      e.preventDefault();
      if (!container || !burger || !content || !backdrop) return;
      if (container.classList.contains("open")) {
        container.classList.remove("open");
        burger.setAttribute("aria-expanded", "false");
        content.classList.remove("mobile-nav--slide-in");
        content.classList.add("mobile-nav--slide-out");
        setTimeout(() => content.classList.add("hidden"), 300);
        backdrop.classList.remove("mobile-nav__backdrop--fade-in");
        backdrop.classList.add("mobile-nav__backdrop--fade-out");
      } else {
        container.classList.add("open");
        burger.setAttribute("aria-expanded", "true");
        content.classList.remove("hidden", "mobile-nav--slide-out");
        content.classList.add("mobile-nav--slide-in");
        backdrop.classList.remove("hidden", "mobile-nav__backdrop--fade-out");
        backdrop.classList.add("mobile-nav__backdrop--fade-in");
      }
    };

    burger?.addEventListener("click", toggleMobile);
    closeBtn?.addEventListener("click", toggleMobile);
    backdrop?.addEventListener("click", toggleMobile);
  }

  initThemeSwitcher();
  initNavScroll();
  initMobileNav();
  document.addEventListener("astro:after-swap", () => {
    initThemeSwitcher();
    initNavScroll();
    initMobileNav();
  });
</script>
