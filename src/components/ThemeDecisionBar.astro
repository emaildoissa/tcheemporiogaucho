---
// Barra de Decisão Visual para Comparação entre Adega & Farroupilha
// Concebida com a consultoria do bot Lens (Design)
---

<div
  class="theme-decision-bar sticky top-[72px] sm:top-[86px] z-30 bg-[var(--commerce-surface)]/95 backdrop-blur-md border-b border-[var(--commerce-border)] shadow-md transition-colors duration-300"
  id="theme-decision-bar"
>
  <div class="site-container py-2.5">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
      <!-- Identificação & Resumo -->
      <div class="flex items-center gap-2.5">
        <div class="flex items-center justify-center size-8 rounded-lg bg-[var(--commerce-accent)] text-white shadow-sm font-bold text-sm shrink-0">
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--commerce-foreground)]">
              Comparação Visual de Identidade
            </span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[var(--commerce-ouro)]/20 text-[var(--commerce-ouro)] border border-[var(--commerce-ouro)]/30">
              Ativo em Todo o Site
            </span>
          </div>
          <p class="text-[11px] text-[var(--commerce-muted)] m-0 leading-tight">
            Alterne entre as 2 identidades finalistas para avaliar na Home, no Catálogo e na página de Produto.
          </p>
        </div>
      </div>

      <!-- 2 Opções Finalistas de Design -->
      <div class="grid grid-cols-2 gap-2 w-full lg:w-auto">
        <!-- Opção 1: Adega & Galpão -->
        <button
          type="button"
          data-site-theme-select="adega"
          class="theme-opt-btn flex items-center justify-between sm:justify-center gap-2.5 px-4 py-2 rounded-xl border text-xs font-bold transition text-left sm:text-center"
          title="Opção 1: Escuro sofisticado (Carvão #18181B, Vinho Tinto #B91C1C e Ouro #F59E0B)"
        >
          <div class="flex items-center gap-2">
            <span class="inline-block size-3.5 rounded-full bg-[#8b1b22] border border-[#f59e0b] shrink-0"></span>
            <div>
              <div class="leading-none text-[var(--commerce-foreground)]">1. Adega & Galpão</div>
              <span class="text-[10px] font-normal text-[var(--commerce-muted)]">Dark Premium • Vinho Tinto</span>
            </div>
          </div>
          <span class="active-badge text-[10px] font-bold text-[var(--commerce-accent)] sm:hidden">✓</span>
        </button>

        <!-- Opção 2: Farroupilha Tricolor -->
        <button
          type="button"
          data-site-theme-select="farroupilha"
          class="theme-opt-btn flex items-center justify-between sm:justify-center gap-2.5 px-4 py-2 rounded-xl border text-xs font-bold transition text-left sm:text-center"
          title="Opção 2: Cores oficiais do RS (Verde Pampa #14532D, Vermelho #DC2626 e Ouro #D97706)"
        >
          <div class="flex items-center gap-2">
            <span class="inline-block size-3.5 rounded-full bg-[#15803d] border border-[#facc15] shrink-0"></span>
            <div>
              <div class="leading-none text-[var(--commerce-foreground)]">2. Farroupilha Tricolor</div>
              <span class="text-[10px] font-normal text-[var(--commerce-muted)]">Cores do Rio Grande do Sul</span>
            </div>
          </div>
          <span class="active-badge text-[10px] font-bold text-[var(--commerce-accent)] sm:hidden">✓</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .theme-opt-btn {
    background: var(--commerce-surface);
    border-color: var(--commerce-border);
    color: var(--commerce-foreground);
    cursor: pointer;
  }
  .theme-opt-btn:hover {
    border-color: var(--commerce-accent);
  }
  .theme-opt-btn.is-active {
    background: color-mix(in srgb, var(--commerce-accent) 14%, var(--commerce-surface));
    border-color: var(--commerce-accent);
    box-shadow: 0 0 0 2px var(--commerce-glow);
  }
</style>

<script>
  function setupThemeBar() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-site-theme-select]");
    const navPills = document.querySelectorAll<HTMLButtonElement>("[data-theme-pill]");

    function updateActiveState(theme: string) {
      document.documentElement.setAttribute("data-theme", theme);
      localStorage.setItem("tche_theme", theme);
      localStorage.setItem("tche_home_theme", theme);

      if (theme === "adega") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }

      buttons.forEach((btn) => {
        const btnTheme = btn.getAttribute("data-site-theme-select");
        if (btnTheme === theme) {
          btn.classList.add("is-active");
        } else {
          btn.classList.remove("is-active");
        }
      });

      navPills.forEach((pill) => {
        const pillTheme = pill.getAttribute("data-theme-pill");
        if (pillTheme === theme) {
          pill.classList.add("bg-[var(--commerce-accent)]", "text-white");
          pill.classList.remove("text-[var(--muted-foreground)]");
        } else {
          pill.classList.remove("bg-[var(--commerce-accent)]", "text-white");
          pill.classList.add("text-[var(--muted-foreground)]");
        }
      });
    }

    const currentTheme = localStorage.getItem("tche_theme") || localStorage.getItem("tche_home_theme") || "adega";
    const normalized = currentTheme === "farroupilha" ? "farroupilha" : "adega";
    updateActiveState(normalized);

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const theme = btn.getAttribute("data-site-theme-select");
        if (theme) updateActiveState(theme);
      });
    });
  }

  setupThemeBar();
  document.addEventListener("astro:page-load", setupThemeBar);
</script>
